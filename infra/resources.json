{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "17989138993515304516"
    }
  },
  "parameters": {
    "webAppLocation": {
      "type": "string",
      "metadata": {
        "description": "Location for the Web App (must match the App Service Plan location)"
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Azure Storage Account for Table Storage"
      }
    },
    "appInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Application Insights instance"
      }
    },
    "logAnalyticsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Log Analytics Workspace"
      }
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the App Service (Web App)"
      }
    },
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the App Service Plan that the web app binds to. Created by this template in this resource group on the F1 (Free) Linux tier."
      }
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Key Vault in the PoShared resource group"
      }
    },
    "sharedResourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Name of the PoShared resource group containing shared services and the App Service Plan"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('webAppLocation')]",
      "sku": {
        "name": "F1",
        "tier": "Free"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('webAppLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "azd-service-name": "api"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10.0",
          "appCommandLine": "/home/site/wwwroot/startup.sh",
          "alwaysOn": false,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "KeyVault__Uri",
              "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
            },
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "AzureTableStorage__ServiceUrl",
              "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-01-01').primaryEndpoints.table]"
            },
            {
              "name": "AzureTableStorage__RepositoryTableName",
              "value": "PoRepoLineTrackerRepositories"
            },
            {
              "name": "AzureTableStorage__CommitLineCountTableName",
              "value": "PoRepoLineTrackerCommitLineCounts"
            },
            {
              "name": "AzureTableStorage__UserTableName",
              "value": "PoRepoLineTrackerUsers"
            },
            {
              "name": "AzureTableStorage__UserPreferencesTableName",
              "value": "PoRepoLineTrackerUserPreferences"
            },
            {
              "name": "GitHub__LocalReposPath",
              "value": "/home/LocalRepos"
            },
            {
              "name": "GitHub__CallbackPath",
              "value": "/signin-github"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "ASPNETCORE_URLS",
              "value": "http://+:8080"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "storage-table-role",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountId": {
            "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01', 'full').identity.principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "8202867412894139486"
            }
          },
          "parameters": {
            "storageAccountId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the storage account to grant table access on"
              }
            },
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Name of the storage account to grant table access on (must be in this resource group)"
              }
            },
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID of the web app managed identity"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "[guid(parameters('storageAccountId'), parameters('principalId'), subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3')]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "keyvault-access",
      "resourceGroup": "[parameters('sharedResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "keyVaultName": {
            "value": "[parameters('keyVaultName')]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01', 'full').identity.principalId]"
          },
          "tenantId": {
            "value": "[subscription().tenantId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "3699018257215497576"
            }
          },
          "parameters": {
            "keyVaultName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Key Vault in this resource group"
              }
            },
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID of the identity to grant secret get/list"
              }
            },
            "tenantId": {
              "type": "string",
              "metadata": {
                "description": "Tenant ID that owns the principal"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults/accessPolicies",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/{1}', parameters('keyVaultName'), 'add')]",
              "properties": {
                "accessPolicies": [
                  {
                    "tenantId": "[parameters('tenantId')]",
                    "objectId": "[parameters('principalId')]",
                    "permissions": {
                      "secrets": [
                        "get",
                        "list"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "availability-test",
      "resourceGroup": "[parameters('sharedResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "appInsightsId": {
            "value": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.Insights/components', parameters('appInsightsName'))]"
          },
          "location": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02', 'full').location]"
          },
          "webAppHostName": {
            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01').defaultHostName]"
          },
          "webAppName": {
            "value": "[parameters('webAppName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "10997934979584291847"
            }
          },
          "parameters": {
            "appInsightsId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the App Insights component to link the test to"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Location — MUST match the linked App Insights component location"
              }
            },
            "webAppHostName": {
              "type": "string",
              "metadata": {
                "description": "Public host name of the web app to ping (no scheme)"
              }
            },
            "webAppName": {
              "type": "string",
              "metadata": {
                "description": "Web app name, used to name the test"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Insights/webtests",
              "apiVersion": "2022-06-15",
              "name": "[format('avail-{0}-health', parameters('webAppName'))]",
              "location": "[parameters('location')]",
              "tags": {
                "[format('hidden-link:{0}', parameters('appInsightsId'))]": "Resource"
              },
              "kind": "ping",
              "properties": {
                "SyntheticMonitorId": "[format('avail-{0}-health', parameters('webAppName'))]",
                "Name": "[format('{0}-health', parameters('webAppName'))]",
                "Enabled": true,
                "Frequency": 300,
                "Timeout": 30,
                "Kind": "ping",
                "RetryEnabled": true,
                "Locations": [
                  {
                    "Id": "us-ca-sjc-azr"
                  },
                  {
                    "Id": "us-tx-sn1-azr"
                  },
                  {
                    "Id": "us-il-ch1-azr"
                  }
                ],
                "Configuration": {
                  "WebTest": "[format('<WebTest Name=\"{0}-health\" Enabled=\"True\" CssProjectStructure=\"\" CssIteration=\"\" Timeout=\"30\" WorkItemIds=\"\" xmlns=\"http://microsoft.com/schemas/VisualStudio/TeamTest/2010\" Description=\"\" CredentialUserName=\"\" CredentialPassword=\"\" PreAuthenticate=\"True\" Proxy=\"default\" StopOnError=\"False\" RecordedResultFile=\"\" ResultsLocale=\"\"><Items><Request Method=\"GET\" Version=\"1.1\" Url=\"https://{1}/health\" ThinkTime=\"0\" Timeout=\"30\" ParseDependentRequests=\"False\" FollowRedirects=\"True\" RecordResult=\"True\" Cache=\"False\" ResponseTimeGoal=\"0\" Encoding=\"utf-8\" ExpectedHttpStatusCode=\"200\" ExpectedResponseUrl=\"\" ReportingName=\"\" IgnoreHttpStatusCode=\"False\" /></Items></WebTest>', parameters('webAppName'), parameters('webAppHostName'))]"
                }
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ]
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the deployed Storage Account"
      },
      "value": "[parameters('storageAccountName')]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "metadata": {
        "description": "Application Insights connection string for telemetry"
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
    },
    "webAppUrl": {
      "type": "string",
      "metadata": {
        "description": "Public URL of the deployed Web App"
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01').defaultHostName)]"
    },
    "logAnalyticsId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics Workspace"
      },
      "value": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('sharedResourceGroupName')), 'Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Web App managed identity principal ID (use to grant Key Vault access)"
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01', 'full').identity.principalId]"
    }
  }
}