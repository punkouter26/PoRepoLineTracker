{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PoRepoLineTracker.API (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "kill-dotnet-and-build",
      "program": "${workspaceFolder}/src/PoRepoLineTracker.API/bin/Debug/net10.0/PoRepoLineTracker.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PoRepoLineTracker.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "killServerOnStop": true
      },
      "launchBrowser": {
        "enabled": true,
        "args": "",
        "windows": {
          "command": "cmd.exe",
          "args": "/c start msedge %s"
        }
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5003;http://localhost:5002"
      },
      "launchSettingsProfile": "https"
    }
  ]
}
