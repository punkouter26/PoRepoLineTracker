<?xml version="1.0" encoding="utf-8"?>
<!--
  coverlet.runsettings
  Coverage configuration for the Unit tier (the only project wired to this file — see
  PoRepoLineTracker.Unit.csproj RunSettingsFilePath). Coverage is COLLECTED whenever the
  collector runs; the threshold below is only evaluated when `dotnet test` is invoked with
  `-collect:"XPlat Code Coverage"`, which CI currently does not do.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output formats: consumed by ReportGenerator or CI dashboards -->
          <Format>cobertura,lcov</Format>
          <OutputPath>./TestResults/coverage</OutputPath>

          <!-- Assemblies to include in coverage measurement -->
          <Include>[PoRepoLineTracker.API]*,[PoRepoLineTracker.Shared]*,[PoRepoLineTracker.Client]*</Include>

          <!-- Exclude generated and test code -->
          <Exclude>[PoRepoLineTracker.Unit]*,[PoRepoLineTracker.Integration]*,[PoRepoLineTracker.E2EAPI]*,[PoRepoLineTracker.E2EUI]*</Exclude>
          <ExcludeByFile>**/*.g.cs,**/*.Designer.cs,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCode,CompilerGenerated,ExcludeFromCodeCoverage</ExcludeByAttribute>

          <!-- Gates: fail if coverage drops below these thresholds -->
          <Threshold>70</Threshold>
          <ThresholdType>line,branch,method</ThresholdType>
          <ThresholdStat>minimum</ThresholdStat>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
