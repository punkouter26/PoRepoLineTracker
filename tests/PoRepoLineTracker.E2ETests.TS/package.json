{
  "name": "porepolinetracker.e2etests.ts",
  "version": "1.0.0",
  "description": "E2E tests for PoRepoLineTracker using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "node_modules\.bin\playwright test",
    "test:headed": "node_modules\.bin\playwright test --headed",
    "test:debug": "node_modules\.bin\playwright test --debug",
    "test:ui": "node_modules\.bin\playwright test --ui",
    "test:report": "node_modules\.bin\playwright show-report",
    "test:e2e": "npm run pretest && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
