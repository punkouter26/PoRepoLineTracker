{
  "name": "porepolinetracker.e2etests.ts",
  "version": "1.0.0",
  "description": "E2E tests for PoRepoLineTracker using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "pretest": "npx playwright install msedge chromium",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:e2e": "npm run pretest && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
