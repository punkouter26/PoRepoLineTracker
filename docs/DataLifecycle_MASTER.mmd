flowchart LR
    subgraph Ingestion["Ingestion"]
        SignIn["User Signs In\nGitHub OAuth challenge"]
        RepoPick["User Picks Repositories\nSingle add or bulk add"]
        Prefs["User Saves Preferences\nExtensions + chart mode"]
    end

    subgraph Processing["Processing"]
        Claims["API Resolves User Claims\nCookie to UserId"]
        Queue["Repository Command Accepted\nAdd, analyze, or re-analyze"]
        ClonePull["Git Worker Clones or Pulls\nUser-scoped local repo cache"]
        Filter["File Filter Applies\nSelected extensions only"]
        Count["Line Counters Aggregate\nAdded, removed, total, by extension"]
        Retry["Failure Handler Records\nRetry metadata + context"]
    end

    subgraph Persistence["Persistence"]
        UserTable["User + Preference Tables\nIdentity and settings"]
        RepoTable["Repository Table\nTracked repositories"]
        CommitTable["Commit Metrics Table\nPer-commit derived totals"]
        TopFileTable["Top File Table\nLargest-file snapshots"]
        FailureTable["Failed Operation Table\nOperational recovery queue"]
    end

    subgraph Egress["Egress and UI Update"]
        Query["Client Queries API\nRepos, charts, percentages, top files, failures"]
        Render["Blazor UI Refreshes\nDashboards, detail views, settings"]
        Observe["Telemetry Captured\nSerilog + App Insights"]
    end

    SignIn --> Claims
    Prefs --> Claims
    RepoPick --> Claims
    Claims --> UserTable
    Claims --> Queue
    Queue --> RepoTable
    Queue --> ClonePull
    ClonePull --> Filter
    Filter --> Count
    Count --> CommitTable
    Count --> TopFileTable
    Count --> RepoTable
    Count --> Observe
    ClonePull --> Observe
    Count --> Query
    RepoTable --> Query
    CommitTable --> Query
    TopFileTable --> Query
    UserTable --> Query
    FailureTable --> Query
    Query --> Render
    ClonePull -. "exception" .-> Retry
    Filter -. "exception" .-> Retry
    Count -. "exception" .-> Retry
    Retry --> FailureTable
    Retry --> Observe

