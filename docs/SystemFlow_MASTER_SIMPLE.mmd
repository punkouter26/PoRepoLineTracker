flowchart LR
    subgraph Access["Access and Session"]
        Login["Login"]
        Session["Authenticated Session"]
    end

    subgraph Workspace["Primary Workspace"]
        Manage["Manage Repositories"]
        Configure["Configure Preferences"]
        Inspect["Inspect Analytics"]
    end

    subgraph Pipeline["Repository Pipeline"]
        Analyze["Background Analysis"]
        Persist["Persist Metrics"]
        Recover["Capture Failures"]
    end

    Login --> Session
    Session --> Manage
    Session --> Configure
    Session --> Inspect
    Manage --> Analyze
    Configure --> Analyze
    Analyze --> Persist
    Analyze -. "error" .-> Recover
    Persist --> Inspect
    Recover --> Inspect

