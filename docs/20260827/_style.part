<style>
  :root{
    --bg:#f7f8fa; --panel:#ffffff; --ink:#12151a; --ink-2:#3d4550; --ink-3:#657084;
    --line:#d9dee6; --line-2:#eaedf2;
    --accent:#1c4fd6; --accent-soft:#eaf0ff;
    --ok:#0f7a4d; --ok-soft:#e5f5ec;
    --warn:#8a5a00; --warn-soft:#fdf1d8;
    --bad:#a8242b; --bad-soft:#fbe9ea;
    --mono:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
       font-size:16px;line-height:1.6;padding:0 0 5rem}
  .wrap{max-width:1180px;margin:0 auto;padding:0 1.25rem}
  header.doc{background:var(--ink);color:#fff;padding:2.5rem 0 2rem;margin-bottom:2rem}
  header.doc .wrap{max-width:1180px}
  header.doc .eyebrow{font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;
       text-transform:uppercase;color:#9aa7bd;margin:0 0 .5rem}
  header.doc h1{margin:0 0 .5rem;font-size:clamp(1.6rem,4vw,2.4rem);line-height:1.2;letter-spacing:-.02em}
  header.doc p.sub{margin:0;color:#c3ccdb;max-width:62ch}
  header.doc .meta{margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.4rem 1.25rem;
       font-family:var(--mono);font-size:.75rem;color:#8e9bb2}
  h2{font-size:1.5rem;letter-spacing:-.01em;margin:2.75rem 0 .5rem;padding-top:1.25rem;
     border-top:2px solid var(--line)}
  h3{font-size:1.12rem;margin:1.9rem 0 .5rem;letter-spacing:-.005em}
  h4{font-size:.95rem;margin:1.4rem 0 .4rem;color:var(--ink-2);text-transform:uppercase;
     letter-spacing:.08em;font-family:var(--mono);font-weight:600}
  p{margin:.65rem 0;max-width:78ch}
  ul,ol{max-width:78ch;padding-left:1.25rem}
  li{margin:.3rem 0}
  a{color:var(--accent)}
  code{font-family:var(--mono);font-size:.86em;background:var(--line-2);
       padding:.1em .35em;border-radius:3px;word-break:break-word}
  pre{background:#12151a;color:#e6ebf2;padding:1rem 1.1rem;border-radius:8px;
      overflow-x:auto;font-family:var(--mono);font-size:.82rem;line-height:1.55;
      border:1px solid #262c35}
  pre code{background:none;padding:0;color:inherit;font-size:inherit}
  .tier{display:inline-flex;align-items:center;gap:.45rem;font-family:var(--mono);
        font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;
        padding:.22rem .55rem;border-radius:99px;vertical-align:middle;margin-right:.6rem}
  .t1{background:var(--accent-soft);color:var(--accent)}
  .t2{background:#efeaff;color:#5b32c4}
  .t3{background:#e6f4ee;color:var(--ok)}
  section.tierblock{background:var(--panel);border:1px solid var(--line);border-radius:12px;
        padding:1.4rem 1.5rem;margin:1rem 0 0}
  .lead{font-size:1.06rem;color:var(--ink-2)}
  .grid{display:grid;gap:1rem;margin:1.1rem 0}
  .g2{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
  .g3{grid-template-columns:repeat(auto-fit,minmax(215px,1fr))}
  .g4{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem}
  .card h5{margin:0 0 .35rem;font-size:.95rem}
  .card p{margin:0;font-size:.9rem;color:var(--ink-2);max-width:none}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:.95rem 1.05rem}
  .stat .n{font-size:1.75rem;font-weight:700;letter-spacing:-.02em;line-height:1.1;
           font-family:var(--mono)}
  .stat .l{font-size:.74rem;text-transform:uppercase;letter-spacing:.09em;color:var(--ink-3);
           margin-top:.3rem;font-family:var(--mono)}
  .stat.zero .n{color:var(--ok)}
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--panel);
             margin:1.1rem 0}
  table{border-collapse:collapse;width:100%;font-size:.86rem;min-width:640px}
  caption{text-align:left;font-size:.8rem;color:var(--ink-3);padding:.7rem 1rem 0;font-family:var(--mono)}
  th,td{text-align:left;padding:.6rem .85rem;border-bottom:1px solid var(--line-2);vertical-align:top}
  thead th{background:#f0f2f6;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;
           color:var(--ink-2);border-bottom:2px solid var(--line);position:sticky;top:0}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:#fafbfd}
  td code,th code{white-space:nowrap}
  .pill{display:inline-block;font-family:var(--mono);font-size:.7rem;font-weight:700;
        padding:.15rem .45rem;border-radius:4px;letter-spacing:.03em;white-space:nowrap}
  .p-ok{background:var(--ok-soft);color:var(--ok)}
  .p-warn{background:var(--warn-soft);color:var(--warn)}
  .p-bad{background:var(--bad-soft);color:var(--bad)}
  .p-neutral{background:var(--line-2);color:var(--ink-2)}
  .p-accent{background:var(--accent-soft);color:var(--accent)}
  .note{border-left:4px solid var(--accent);background:var(--accent-soft);
        padding:.85rem 1.1rem;border-radius:0 8px 8px 0;margin:1.2rem 0}
  .note.warn{border-color:var(--warn);background:var(--warn-soft)}
  .note.ok{border-color:var(--ok);background:var(--ok-soft)}
  .note.bad{border-color:var(--bad);background:var(--bad-soft)}
  .note p{margin:.3rem 0}
  .note strong:first-child{display:block;font-size:.78rem;text-transform:uppercase;
        letter-spacing:.08em;font-family:var(--mono);margin-bottom:.2rem}
  figure{margin:1.4rem 0;background:var(--panel);border:1px solid var(--line);
         border-radius:12px;padding:1.1rem;overflow:hidden}
  figure figcaption{font-size:.8rem;color:var(--ink-3);font-family:var(--mono);
         margin-top:.75rem;padding-top:.65rem;border-top:1px solid var(--line-2)}
  .mermaid{overflow-x:auto;font-size:15px!important;text-align:center}
  .mermaid svg{max-width:100%;height:auto;min-width:0}
  .toc{background:var(--panel);border:1px solid var(--line);border-radius:10px;
       padding:1rem 1.2rem;margin:0 0 1rem}
  .toc ol{margin:.4rem 0 0;padding-left:1.2rem;columns:2;column-gap:2rem}
  .toc li{break-inside:avoid;font-size:.9rem}
  footer.doc{margin-top:3.5rem;padding-top:1.25rem;border-top:1px solid var(--line);
       font-size:.8rem;color:var(--ink-3);font-family:var(--mono)}
  .srcline{font-family:var(--mono);font-size:.76rem;color:var(--ink-3);margin:.35rem 0 0}
  .controls{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:1.1rem 0 .4rem}
  .controls label{font-family:var(--mono);font-size:.74rem;text-transform:uppercase;
       letter-spacing:.08em;color:var(--ink-3)}
  select,input[type=search]{font-family:var(--sans);font-size:.88rem;padding:.4rem .6rem;
       border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink)}
  .tabs{display:flex;flex-wrap:wrap;gap:.4rem;margin:1.2rem 0 0;border-bottom:2px solid var(--line)}
  .tabs button{font-family:var(--sans);font-size:.9rem;font-weight:600;padding:.55rem .95rem;
       border:none;background:none;color:var(--ink-3);cursor:pointer;border-bottom:3px solid transparent;
       margin-bottom:-2px}
  .tabs button[aria-selected=true]{color:var(--accent);border-bottom-color:var(--accent)}
  .tabs button:hover{color:var(--ink)}
  [role=tabpanel][hidden]{display:none}
  .legend{display:flex;flex-wrap:wrap;gap:.4rem .9rem;font-size:.8rem;color:var(--ink-2);margin:.6rem 0}
  @media (max-width:640px){
    body{font-size:15px}
    .toc ol{columns:1}
    th,td{padding:.5rem .6rem}
  }
  @media print{
    body{background:#fff}
    header.doc{background:#fff;color:#000;border-bottom:2px solid #000}
    header.doc h1,header.doc p.sub,header.doc .eyebrow,header.doc .meta{color:#000}
    .tabs{display:none}[role=tabpanel][hidden]{display:block!important}
  }
</style>
