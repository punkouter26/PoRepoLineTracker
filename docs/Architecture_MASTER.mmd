flowchart TB
    subgraph Edge["Edge Delivery"]
        Browser["Authenticated Browser\nBlazor WebAssembly + Radzen"]
        StaticHost["Static Asset Host\nindex.html + WASM + manifest"]
    end

    subgraph Compute["Compute Tier"]
        WebApp["Azure App Service\nCombined API + WASM Host"]
        Auth["Authentication Layer\nGitHub OAuth + Cookie Auth"]
        Api["Minimal API Surface\nAuth, Repositories, Settings, GitHub, Failed Ops, Diagnostics"]
        AppLayer["Application Layer\nMediatR Commands + Queries"]
        Background["Background Execution\nAnalysis, Re-analysis, Retry Loop"]
    end

    subgraph Data["Data Persistence"]
        Tables["Azure Table Storage\nUsers, Repositories, Commits, Failed Ops, Preferences, Top Files"]
        RepoCache["Repository Cache\n/home/LocalRepos or dev temp path"]
        Vault["Azure Key Vault\nGitHub client secrets + PAT"]
        Telemetry["Observability\nApplication Insights + Log Analytics"]
    end

    subgraph External["External Systems"]
        GitHub["GitHub\nOAuth, repo metadata, clone/pull"]
    end

