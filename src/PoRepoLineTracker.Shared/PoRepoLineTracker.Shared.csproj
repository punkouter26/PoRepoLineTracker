<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not marked trimmable: the WASM app that consumes these DTOs serializes them via
         reflection and is published untrimmed (see .Client). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Rule 2.2 — Shared is the leaf: DTOs + FluentValidation rules only, no project refs. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
