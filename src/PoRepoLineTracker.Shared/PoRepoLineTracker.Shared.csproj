<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Rule 1.2 — trimmable. This became true rather than aspirational once
         AppJsonSerializerContext replaced reflection-based serialization: the DTOs here are
         reached through generated metadata, so the trimmer can see every member that is
         actually used instead of having to assume all of them are. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
</Project>
