{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.AspNetCore.Authorization": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "System.Net.Http": "Warning",
      "OpenTelemetry": "Warning",
      "PoRepoLineTracker": "Information"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "GitHub": {
    "LocalReposPath": "/tmp/LocalRepos",
    "CallbackPath": "/signin-github"
  },
  "AzureTableStorage": {
    "ServiceUrl": "",
    "RepositoryTableName": "PoRepoLineTrackerRepositories",
    "CommitLineCountTableName": "PoRepoLineTrackerCommitLineCounts",
    "UserTableName": "PoRepoLineTrackerUsers",
    "UserPreferencesTableName": "PoRepoLineTrackerUserPreferences"
  },
  "OpenTelemetry": {
    "ServiceName": "PoRepoLineTracker",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": ""
  },
  "ChartSettings": {
    "MaxLinesOfCode": 500000
  },
  "FeatureFlags": {
    "EnableGitHubApi": true,
    "EnableBackgroundAnalysis": true,
    "EnableOpenTelemetryExport": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "PoRepoLineTracker"
    }
  }
}
