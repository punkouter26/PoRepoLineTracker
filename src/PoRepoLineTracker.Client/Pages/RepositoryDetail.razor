@page "/repositories/{Id:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject ILogger<RepositoryDetail> Logger
@inject NavigationManager Navigation
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService
@inject UserPreferencesClient PreferencesClient
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Shared.Domain
@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

<div class="app-stack">

    @* ─── Hero ──────────────────────────────────────────────────────────────── *@
    <PageHero>
        <Heading>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                              Click="@(() => Navigation.NavigateTo("/"))" title="Back to Repositories"
                              aria-label="Back to Repositories" />
                @if (_repo != null)
                {
                    <RadzenStack Gap="0.15rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H4" class="rd-title">@_repo.Owner/@_repo.Name</RadzenText>
                            <a href="@($"https://github.com/{_repo.Owner}/{_repo.Name}")" target="_blank"
                               title="Open on GitHub"
                               aria-label="@($"Open {_repo.Owner}/{_repo.Name} on GitHub in a new tab")"
                               class="rd-github-link">
                                @* RadzenIcon rather than a bare <span class="material-icons">: the
                                   glyph then comes from Radzen's bundled icon font instead of the
                                   Google Fonts CDN, so it renders as an icon rather than the
                                   literal text "open_in_new" whenever that request fails. *@
                                <RadzenIcon Icon="open_in_new" class="rd-github-link__icon" />
                            </a>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                            @if (_repo.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"Analyzed {ChartFormat.RelativeTime(_repo.LastAnalyzedCommitDate)}")" />
                                @if (_repoLatestLines > 0)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@($"{_repoLatestLines:N0} lines")" />
                                }
                                @* Supplied by AiMixChart once it has loaded, rather than fetched again here —
                                   the figure is lines-weighted and only that component holds the per-commit
                                   line counts needed to weight it. Hidden until non-zero so a repository
                                   analysed before AI scoring existed does not advertise a misleading 0%.

                                   Label states "of added lines" because the same page renders an
                                   "average AI score" bar under the human-vs-AI chart, which is the
                                   per-commit average, not a line-weighted share — without the
                                   qualifier the hero and the chart claimed to be the same figure
                                   but were not. *@
                                @if (_aiShare > 0)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning"
                                                 Text="@($"{_aiShare:F0}% AI (of added lines)")" />
                                }
                            }
                            else if (_isReanalyzing)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Re-analyzing…" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Not yet analyzed" />
                            }
                        </RadzenStack>
                    </RadzenStack>
                }
                else if (_isPageLoading)
                {
                    <RadzenSkeleton Width="220px" Height="28px" />
                }
            </RadzenStack>
        </Heading>
        <Actions>
            @* One range for the whole page. Every chart below reads _chartDays.

               There used to be three independent selectors — this card's, AiMixChart's and
               ContributorChart's — defaulting to 365, 90 and 90. The page therefore opened showing
               a year of line history above two 90-day authorship charts, and moving any one of
               them left the other two where they were. Whatever else that is, it is not a
               comparison. *@
            <ChartRangeSelector Days="@_chartDays" DaysChanged="@OnChartRangeChanged" />
            <RadzenButton Text="Re-analyze" Icon="refresh"
                          ButtonStyle="ButtonStyle.Warning"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Click="@ConfirmReanalyze"
                          Disabled="@(_repo == null || _isReanalyzing)" />
            <RadzenButton Text="Delete" Icon="delete"
                          ButtonStyle="ButtonStyle.Danger"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Click="@ConfirmDelete"
                          Disabled="@(_repo == null || _isReanalyzing)" />
        </Actions>
    </PageHero>

    @* ─── Errors ─────────────────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true" Close="@(() => _errorMessage = string.Empty)">
            @_errorMessage
        </RadzenAlert>
    }

    @* ─── Page loading skeleton ───────────────────────────────────────────────── *@
    @if (_isPageLoading)
    {
        <RadzenCard>
            <RadzenSkeleton Width="100%" Height="350px" />
        </RadzenCard>
    }
    else if (_repo == null)
    {
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" class="rz-p-8">
                <RadzenIcon Icon="search_off" class="rd-empty-icon" />
                <RadzenText TextStyle="TextStyle.H6">Repository not found</RadzenText>
                <RadzenButton Text="Back to Repositories" Icon="arrow_back" Click="@(() => Navigation.NavigateTo("/"))" />
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        @* ─── Re-analyzing banner ──────────────────────────────────────────────── *@
        @if (_isReanalyzing)
        {
            <RadzenCard class="rd-progress-card">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="sync" class="spin-icon rd-progress-icon" />
                    <RadzenStack Gap="0.1rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rd-progress-title">Re-analysis in progress</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rd-muted-tight">Commits are being scanned. This page will refresh automatically when complete.</RadzenText>
                    </RadzenStack>
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" class="rd-progress-bar" />
                </RadzenStack>
            </RadzenCard>
        }

        @* ─── Line Count Chart ────────────────────────────────────────────────── *@
        <ChartCard Title="Line Count History"
                   Description="@ChartDescription"
                   IsLoading="@_isLoadingChart"
                   ErrorMessage="@_chartError"
                   OnRetry="@(() => LoadLineHistory(_chartDays))"
                   IsEmpty="@(_lineHistory is null || !_lineHistory.Any())"
                   EmptyIcon="bar_chart"
                   EmptyText="No history data yet."
                   EmptyHint="Click Re-analyze to start scanning this repository.">
            <ChildContent>
                <RadzenChart>
                    <RadzenAreaSeries Data="@DisplayedLineHistory"
                                      CategoryProperty="Date"
                                      ValueProperty="TotalLines"
                                      Title="@ChartSeriesTitle"
                                      Stroke="var(--rz-primary)"
                                      Fill="rgba(103, 80, 164, 0.14)"
                                      StrokeWidth="3">
                        @* Markers only once the series is sparse enough to place them without
                           turning the line into a solid band of circles. *@
                        <RadzenMarkers MarkerType="@(DisplayedLineHistory.Count <= 60 ? MarkerType.Circle : MarkerType.None)" />
                        @* Growth trajectory is the question this page exists to answer, so draw
                           it rather than making the reader infer it from the curve. *@
                        <RadzenSeriesTrendLine Stroke="#ff7a59" StrokeWidth="2" LineType="LineType.Dashed" />
                    </RadzenAreaSeries>

                    @* Whole-day Step: see ChartFormat.DateAxisStep. *@
                    <RadzenCategoryAxis FormatString="{0:MMM d}"
                                        Step="@ChartFormat.DateAxisStep(DisplayedLineHistory.Select(d => d.Date))"
                                        LabelAutoRotation="-45">
                        <RadzenAxisTitle Text="Date" />
                        <RadzenGridLines Visible="true" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines">
                        <RadzenAxisTitle Text="Lines of Code" />
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                    <RadzenLegend Visible="false" />
                </RadzenChart>
            </ChildContent>
        </ChartCard>

        @* ─── Language composition over time ────────────────────────────────────
           The donut below answers "what is this repo made of"; this answers "how did that
           change", which is the more interesting question and was already answerable from data
           the page fetches (see ExtensionTimeSeries — no extra request). *@
        <ChartCard Title="Composition Over Time"
                   Description="Lines by file type across the selected range"
                   IsEmpty="@(ExtensionTimeSeries.Count == 0)"
                   EmptyIcon="layers"
                   EmptyText="No per-extension history yet."
                   EmptyHint="Re-analyze the repository to populate the file-type breakdown.">
            <RadzenChart>
                @{ var extSeries = ExtensionTimeSeries; }
                @for (var i = 0; i < extSeries.Count; i++)
                {
                    var s = extSeries[i];
                    <RadzenStackedAreaSeries Data="@s.Points"
                                             CategoryProperty="Date"
                                             ValueProperty="Lines"
                                             Title="@s.Label"
                                             Fill="@SeriesFill(i)"
                                             Stroke="@SeriesStroke(i)"
                                             StrokeWidth="1" />
                }
                <RadzenCategoryAxis FormatString="{0:MMM d}"
                                    Step="@ChartFormat.DateAxisStep(DisplayedLineHistory.Select(d => d.Date))"
                                    LabelAutoRotation="-45">
                    <RadzenAxisTitle Text="Date" />
                    <RadzenGridLines Visible="true" />
                </RadzenCategoryAxis>
                <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines">
                    <RadzenAxisTitle Text="Lines of Code" />
                    <RadzenGridLines Visible="true" />
                </RadzenValueAxis>
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        </ChartCard>

        @* ─── Extensions + Top Files ────────────────────────────────────────────
           An auto-fit dashboard grid replaces the RadzenRow Size="12" SizeMD="5"/"7" split.
           The 5/7 ratio was arbitrary and only ever produced one desktop layout; the grid fills
           whatever width the well actually has, which is the point of raising the content cap
           for landscape desktops. ChartCard's height:100% keeps the cards bottom-aligned — now
           that `.app-dashboard` stretches its items rather than starting them.

           The wrapper <div>s these two cards sat in are gone. They were not inert: an extra
           auto-height box between the grid and the card is exactly what stopped `height: 100%`
           from resolving, so the cards were ragged despite everything being set up for them not
           to be. ChartCard's own root <div> is the grid item now. *@
        <div class="app-dashboard">
                <ChartCard Title="By Extension"
                           Description="Share of tracked lines per file type"
                           IsEmpty="@(_extensions is null || !_extensions.Any())"
                           EmptyIcon="donut_large"
                           EmptyText="No extension data yet.">
                    @* A donut states the part-of-whole relationship directly; the stacked
                       progress bars underneath keep the exact percentages legible. *@
                    <RadzenChart>
                        <RadzenDonutSeries Data="@ExtensionSlices"
                                           CategoryProperty="Label"
                                           ValueProperty="Percentage"
                                           Title="Share of lines">
                            <RadzenSeriesDataLabels Visible="false" />
                        </RadzenDonutSeries>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>

                    <div class="rd-ext-list">
                        @foreach (var ext in _extensions!)
                        {
                            <div class="rd-ext-row">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <code class="rd-ext-code">@ext.FileExtension</code>
                                    <RadzenText TextStyle="TextStyle.Caption" class="rd-ext-pct">@ext.Percentage.ToString("F1")%</RadzenText>
                                </RadzenStack>
                                <progress class="rd-ext-bar"
                                          max="100"
                                          value="@Math.Min(ext.Percentage, 100)"
                                          aria-label="@($"{ext.FileExtension}: {ext.Percentage:F1}% of lines")"></progress>
                            </div>
                        }
                    </div>
                </ChartCard>

                <ChartCard Title="Largest Files"
                           Description="Files contributing the most lines"
                           IsEmpty="@(_topFiles is null || !_topFiles.Any())"
                           EmptyIcon="description"
                           EmptyText="No file data yet.">
                    <Toolbar>
                        <RadzenButton Text="View top 100" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small" Click="@OpenTopFilesModal" />
                    </Toolbar>
                    <ChildContent>
                        @* A horizontal bar chart rather than the badge list this used to be.
                           "Which files are biggest" is a ranked-magnitude question, and a bar's
                           length answers it pre-attentively — the reader no longer has to compare
                           formatted numbers down a column to see that one file dwarfs the rest.
                           RadzenBarSeries (not ColumnSeries) because the category labels are file
                           paths, which need horizontal room to stay readable. *@
                        <RadzenChart>
                            <RadzenBarSeries Data="@TopFileBars"
                                             CategoryProperty="Label"
                                             ValueProperty="LineCount"
                                             Title="Lines"
                                             Fill="var(--rz-primary)" />
                            <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines">
                                <RadzenAxisTitle Text="Lines" />
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenCategoryAxis>
                                <RadzenAxisTitle Text="File" />
                            </RadzenCategoryAxis>
                            <RadzenLegend Visible="false" />
                        </RadzenChart>

                        @* The exact paths and counts stay in text beneath the chart: the bar
                           categories are truncated to stay legible, and a screen reader gets the
                           full name here rather than an axis label. *@
                        @foreach (var f in _topFiles!)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center"
                                         Gap="0.5rem" class="rd-file-row">
                                <RadzenText class="rd-file-name"
                                            title="@f.FileName">@f.FileName</RadzenText>
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@f.LineCount.ToString("N0")" />
                            </RadzenStack>
                        }
                    </ChildContent>
                </ChartCard>
        </div>

        @* ─── Authorship: who wrote it, and how much of it was assisted ─────────────
           These two were separate full-width bands, which on a landscape monitor meant two more
           ~1900px-wide, 400px-tall strips to scroll past. They answer the same question from two
           directions, so they pair — and `--dash-min: 560px` means the pair only forms when both
           date axes still have room to label themselves, otherwise they stack as before. *@
        <div class="app-dashboard app-dashboard--panels">
            <AiMixChart RepositoryId="@RepositoryId" Days="@_chartDays" OverallShareChanged="@OnAiShareChanged" />
            <ContributorChart RepositoryId="@RepositoryId" Days="@_chartDays" />
        </div>

        @* ─── InstantReplay: Timeline Scrubber ────────────────────────────────────── *@
        <TimelineScrubber DailyData="@_lineHistory" OnDateSelected="@OnTimelineDateSelected" />
    }
</div>

@code {
    /// <summary>
    /// The Blazor router only materialises its built-in route-constraint types, so a
    /// {Id:guid} segment always arrives as a <see cref="Guid"/>. Declaring the parameter as
    /// the strongly-typed <see cref="Domain.Models.RepositoryId"/> made the router try to
    /// assign a Guid to it, throwing InvalidCastException and blanking the page. Bind the raw
    /// Guid, then wrap it once here so the rest of the component keeps the domain type
    /// (Rule 1.5) and cannot transpose it with a UserId.
    /// </summary>
    [Parameter] public Guid Id { get; set; }

    private RepositoryId RepositoryId => new(Id);

    private GitHubRepository? _repo;
    private List<DailyLineCountDto>? _lineHistory;
    private List<FileExtensionPercentageDto>? _extensions;
    private List<TopFileDto>? _topFiles;
    private bool _isPageLoading = true;
    private bool _isLoadingChart = false;
    private bool _isReanalyzing = false;
    /// <summary>
    /// The one range for the page. 90 rather than the 365 this used to hold: the two authorship
    /// charts have always defaulted to 90, and ChartRangeSelector's own default is 90, so 365 was
    /// the odd value out — and the one that made the page's three charts disagree on open.
    /// </summary>
    private int _chartDays = 90;
    private int _repoLatestLines = 0;
    private double _aiShare;
    private string _errorMessage = string.Empty;
    private string _chartError = string.Empty;
    private DateTime? _priorAnalyzedDate;
    private readonly CancellationTokenSource _disposeCts = new();
    private ChartDisplayMode _chartDisplayMode = ChartDisplayMode.TrueData;

    private IReadOnlyList<DailyLineCountDto> DisplayedLineHistory =>
        DailyLineCountChartTransformations.TransformForDisplay(_lineHistory, _chartDisplayMode);


    /// <summary>
    /// Donut slices for the extension breakdown. A repository can report dozens of extensions and
    /// a donut with dozens of slivers communicates nothing, so everything past the top eight is
    /// folded into a single "Other" wedge. The exact per-extension figures stay available in the
    /// bar list rendered beneath the chart.
    /// </summary>
    private IReadOnlyList<ExtensionSlice> ExtensionSlices
    {
        get
        {
            if (_extensions is null || _extensions.Count == 0) return [];

            var ranked = _extensions.OrderByDescending(e => e.Percentage).ToList();
            var slices = ranked.Take(8)
                .Select(e => new ExtensionSlice(e.FileExtension, e.Percentage))
                .ToList();

            var remainder = ranked.Skip(8).Sum(e => e.Percentage);
            if (remainder > 0) slices.Add(new ExtensionSlice("Other", remainder));

            return slices;
        }
    }

    private sealed record ExtensionSlice(string Label, double Percentage);

    /// <summary>
    /// Bars for the "Largest Files" panel. Only the top eight are plotted — beyond that the bars
    /// are too thin to compare and the point of the chart is lost; the full list is still printed
    /// underneath.
    ///
    /// The category is the file NAME, not its full path: a repository path can be 80 characters
    /// and Radzen draws category labels at a fixed size, so full paths overlap into an unreadable
    /// smear. Where two files share a name the parent directory is prefixed, so the labels stay
    /// distinguishable without going back to the full path.
    /// </summary>
    private IReadOnlyList<TopFileBar> TopFileBars
    {
        get
        {
            if (_topFiles is null || _topFiles.Count == 0) return [];

            var top = _topFiles.OrderByDescending(f => f.LineCount).Take(8).ToList();
            var leafCounts = top
                .GroupBy(f => LeafName(f.FileName))
                .ToDictionary(g => g.Key, g => g.Count());

            return top
                .Select(f =>
                {
                    var leaf = LeafName(f.FileName);
                    var label = leafCounts[leaf] > 1 ? WithParent(f.FileName) : leaf;
                    return new TopFileBar(Truncate(label), f.LineCount);
                })
                .ToList();
        }
    }

    private static string LeafName(string path) => path.Split('/', '\\')[^1];

    private static string WithParent(string path)
    {
        var parts = path.Split('/', '\\');
        return parts.Length >= 2 ? $"{parts[^2]}/{parts[^1]}" : parts[^1];
    }

    private static string Truncate(string value) =>
        value.Length <= 28 ? value : "…" + value[^27..];

    private sealed record TopFileBar(string Label, int LineCount);

    /// <summary>
    /// Series for the language-composition-over-time chart: one stacked band per file extension,
    /// so the reader sees not just what the repository is made of today but how that mix changed.
    ///
    /// This needs no new endpoint. <see cref="DailyLineCountDto.LinesByFileType"/> is already
    /// carried on every point the line-history call returns and was, until now, only ever used
    /// for a single-day snapshot — the time dimension was being fetched and thrown away.
    ///
    /// Capped at the six largest extensions with the rest folded into "Other", for the same
    /// reason the donut caps at eight: a stacked area with twenty bands is unreadable.
    /// </summary>
    private IReadOnlyList<ExtensionSeries> ExtensionTimeSeries
    {
        get
        {
            var history = DisplayedLineHistory;
            if (history.Count == 0) return [];

            var totals = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            foreach (var day in history)
                foreach (var (ext, lines) in day.LinesByFileType)
                    totals[ext] = totals.GetValueOrDefault(ext) + lines;

            if (totals.Count == 0) return [];

            var top = totals.OrderByDescending(kv => kv.Value).Take(6).Select(kv => kv.Key).ToList();
            var topSet = top.ToHashSet(StringComparer.OrdinalIgnoreCase);
            var hasOther = totals.Keys.Any(k => !topSet.Contains(k));

            var series = top
                .Select(ext => new ExtensionSeries(ext, history
                    .Select(d => new ExtensionPoint(d.Date, d.LinesByFileType.GetValueOrDefault(ext)))
                    .ToList()))
                .ToList();

            if (hasOther)
            {
                series.Add(new ExtensionSeries("Other", history
                    .Select(d => new ExtensionPoint(
                        d.Date,
                        d.LinesByFileType.Where(kv => !topSet.Contains(kv.Key)).Sum(kv => kv.Value)))
                    .ToList()));
            }

            return series;
        }
    }

    private sealed record ExtensionSeries(string Label, IReadOnlyList<ExtensionPoint> Points);
    private sealed record ExtensionPoint(DateTime Date, int Lines);

    /// <summary>
    /// Categorical palette for the composition chart. Radzen's Fill/Stroke are attribute values,
    /// not CSS, so these cannot be <c>var(--series-N)</c> — they are the same seven hues as the
    /// shared --series-* tokens in app.css, kept in step by hand.
    /// </summary>
    private static readonly string[] _seriesHues =
        { "#5b3df5", "#d46ae8", "#ff7a59", "#ffb84d", "#f95d9b", "#34c3b3", "#5aa9ff" };

    private static string SeriesStroke(int index) => _seriesHues[index % _seriesHues.Length];

    /// <summary>Same hue at 78% opacity — stacked bands need fills that read as a set, not seven flat blocks.</summary>
    private static string SeriesFill(int index)
    {
        var hex = SeriesStroke(index);
        var r = Convert.ToInt32(hex.Substring(1, 2), 16);
        var g = Convert.ToInt32(hex.Substring(3, 2), 16);
        var b = Convert.ToInt32(hex.Substring(5, 2), 16);
        return $"rgba({r}, {g}, {b}, 0.78)";
    }

    private string ChartDescription => _chartDisplayMode == ChartDisplayMode.MovingAverage
        ? "Rolling 90-day moving average of total lines of code"
        : "Total lines of code by day";

    private string ChartSeriesTitle => _chartDisplayMode == ChartDisplayMode.MovingAverage
        ? "90-Day Moving Average"
        : "Total Lines";

    protected override async Task OnInitializedAsync()
    {
        PreferencesClient.Changed += OnPreferencesChangedAsync;

        try
        {
            var repos = await Http.GetAppJsonAsync("/api/repositories", AppJsonSerializerContext.Default.ListGitHubRepository);
            _repo = repos?.FirstOrDefault(r => r.Id == RepositoryId);
            if (_repo != null)
            {
                _priorAnalyzedDate = _repo.LastAnalyzedCommitDate;
                await Task.WhenAll(
                    LoadChartDisplayMode(),
                    LoadLineHistory(_chartDays),
                    LoadExtensions(),
                    LoadTopFiles()
                );
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RepositoryDetail: failed to load repo {Id}", RepositoryId);
            _errorMessage = $"Could not load repository: {ex.Message}";
        }
        finally
        {
            _isPageLoading = false;
        }
    }

    private async Task LoadChartDisplayMode()
    {
        try
        {
            var preferences = await PreferencesClient.GetAsync();
            _chartDisplayMode = preferences?.ChartDisplayMode ?? ChartDisplayMode.TrueData;
            Logger.LogDebug("RepositoryDetail: loaded chart display mode {ChartDisplayMode} for repo {Id}", _chartDisplayMode, RepositoryId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RepositoryDetail: failed to load chart display mode for {Id}; defaulting to true data", RepositoryId);
            _chartDisplayMode = ChartDisplayMode.TrueData;
        }
    }

    /// <summary>
    /// Applies a chart-display-mode change saved on the Settings page without a reload. Every
    /// chart here re-transforms from history already in hand, so this costs no request.
    /// </summary>
    private async Task OnPreferencesChangedAsync(UserPreferences preferences)
    {
        if (_disposed) return;
        if (_chartDisplayMode == preferences.ChartDisplayMode) return;
        _chartDisplayMode = preferences.ChartDisplayMode;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnChartRangeChanged(int days)
    {
        _chartDays = days;
        await LoadLineHistory(days);
    }

    /// <summary>
    /// Mirrors AiMixChart's headline into the hero badge. The card owns the request; this only
    /// copies the result, so changing the card's range updates the badge with it.
    /// </summary>
    private void OnAiShareChanged(double share)
    {
        _aiShare = share;
        StateHasChanged();
    }

    private async Task LoadLineHistory(int days)
    {
        if (_disposed) return;

        _isLoadingChart = true;
        _chartError = string.Empty;
        StateHasChanged();
        try
        {
            _lineHistory = await Http.GetAppJsonAsync($"/api/repositories/{RepositoryId}/linehistory/{days}", AppJsonSerializerContext.Default.ListDailyLineCountDto);
            if (_lineHistory?.Any() == true)
                _repoLatestLines = _lineHistory.OrderByDescending(d => d.Date).First().TotalLines;
            else if (_repo?.LastAnalyzedCommitDate == null)
                _chartError = "This repository has not been analyzed yet. Click Re-analyze to start.";
            else
                _chartError = $"No history data for the last {days} days.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RepositoryDetail: failed to load line history for {Id}", RepositoryId);
            _chartError = $"Error loading chart data: {ex.Message}";
        }
        finally
        {
            // Guarded rather than an early `return`: control cannot leave a finally block
            // (CS0157). Same intent — do not touch component state after disposal.
            if (!_disposed)
            {
                _isLoadingChart = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadExtensions()
    {
        try
        {
            _extensions = await Http.GetAppJsonAsync($"/api/repositories/{RepositoryId}/file-extension-percentages", AppJsonSerializerContext.Default.ListFileExtensionPercentageDto);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RepositoryDetail: could not load extensions for {Id}", RepositoryId);
        }
    }

    private async Task LoadTopFiles()
    {
        try
        {
            _topFiles = await Http.GetAppJsonAsync($"/api/repositories/{RepositoryId}/top-files?count=10", AppJsonSerializerContext.Default.ListTopFileDto);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RepositoryDetail: could not load top files for {Id}", RepositoryId);
        }
    }

    private async Task ConfirmReanalyze()
    {
        if (_repo == null) return;
        var confirmed = await DialogService.Confirm(
            $"Re-analyze '{_repo.Owner}/{_repo.Name}' from scratch? All existing commit data will be replaced.",
            "Re-analyze Repository",
            new ConfirmOptions { OkButtonText = "Re-analyze", CancelButtonText = "Cancel" });

        if (confirmed == true)
            await StartReanalyze();
    }

    private async Task StartReanalyze()
    {
        if (_repo == null) return;
        bool queued = false;
        try
        {
            _isReanalyzing = true;
            StateHasChanged();
            var response = await Http.PostAsync($"/api/repositories/{RepositoryId}/reanalyze", null);
            if (response.IsSuccessStatusCode)
            {
                queued = true;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Re-analysis Started",
                    Detail = "This page will refresh automatically when analysis is complete.",
                    Duration = 5000
                });
                _ = PollForCompletionAsync(_priorAnalyzedDate);
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Could not start re-analysis: {response.StatusCode}",
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RepositoryDetail: error starting reanalysis for {Id}", RepositoryId);
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = ex.Message, Duration = 5000 });
        }
        finally
        {
            if (!queued)
            {
                _isReanalyzing = false;
                StateHasChanged();
            }
        }
    }

    private async Task PollForCompletionAsync(DateTime? priorDate)
    {
        using var cts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        cts.CancelAfter(TimeSpan.FromMinutes(30));
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                if (_disposed) return;
                try
                {
                    var repos = await Http.GetAppJsonAsync("/api/repositories", AppJsonSerializerContext.Default.ListGitHubRepository, cts.Token);
                    var updated = repos?.FirstOrDefault(r => r.Id == RepositoryId);
                    if (updated?.LastAnalyzedCommitDate != null && updated.LastAnalyzedCommitDate != priorDate)
                    {
                        _repo = updated;
                        _priorAnalyzedDate = updated.LastAnalyzedCommitDate;
                        _isReanalyzing = false;
                        await LoadLineHistory(_chartDays);
                        await LoadExtensions();
                        await LoadTopFiles();
                        NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Success,
                            Summary = "Analysis Complete",
                            Detail = $"'{updated.Owner}/{updated.Name}' has been re-analyzed.",
                            Duration = 5000
                        });
                        if (_disposed) return;
                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "RepositoryDetail: poll tick failed for {Id}", RepositoryId);
                }
            }
        }
        catch (OperationCanceledException) { }

        if (_disposed) return;
        _isReanalyzing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDelete()
    {
        if (_repo == null) return;
        var confirmed = await DialogService.Confirm(
            $"Delete '{_repo.Owner}/{_repo.Name}'? All associated data will be permanently removed.",
            "Delete Repository",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/repositories/{RepositoryId}");
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Deleted",
                        Detail = $"'{_repo.Owner}/{_repo.Name}' deleted.",
                        Duration = 4000
                    });
                    Navigation.NavigateTo("/");
                }
                else
                {
                    _errorMessage = $"Delete failed: {response.StatusCode}";
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "RepositoryDetail: error deleting {Id}", RepositoryId);
                _errorMessage = $"Error deleting repository: {ex.Message}";
            }
        }
    }

