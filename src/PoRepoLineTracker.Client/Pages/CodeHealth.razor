@page "/code-health"
@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<CodeHealth> Logger
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Domain
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Shared.Serialization
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

@* Every repository scored against every other. The per-repository card answers "how is this one";
   this answers "how do they compare", which is the question the score is actually reliable for —
   the absolute number is a guide, the ranking holds up. Ordered healthiest first.

   The repository grid is loaded on demand rather than on navigation: scoring means walking each
   repository's tree and parsing its C#, and that is a wait the user should choose. The trend chart,
   in contrast, is memoised per SHA in storage and is cheap to fetch — auto-loading it on mount
   replaces an empty chart card with a populated one on every visit past the first, at no extra
   user-visible cost. *@
<PageTitle>Code Health · PoRepoLineTracker</PageTitle>

<div class="app-stack">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.125rem">
                <h1 class="page-hero__title">Code Health</h1>
                <RadzenText TextStyle="TextStyle.Body1">
                    @if (_isLoading)
                    {
                        <span>Parsing every repository — this walks each tree, so give it a moment…</span>
                    }
                    else if (_rows is not null)
                    {
                        <span>@_measuredCount of @_rows.Count repositories measured · healthiest first</span>
                    }
                    else
                    {
                        <span>Rank every repository you track by how maintainable its code is</span>
                    }
                </RadzenText>
            </RadzenStack>
        </Heading>
    </PageHero>

    @* The grid is a snapshot — which repositories are healthy today. This says which are DRIFTING,
       which no column can show: a repository sitting at 66 and falling matters more than one at 62
       and flat. Its own button, because on a cold cache it measures every repository at every month
       boundary; after that it is served from the per-commit memo. *@
    <ChartCard Title="Health over time"
               IsLoading="@_isCharting"
               ErrorMessage="@_trendMessage"
               OnRetry="@LoadTrendsAsync"
               IsEmpty="@(_trends is null or { Count: 0 })"
               EmptyText="@TrendEmptyText">
        <Toolbar>
            <RadzenButton Text="@(_trends is null ? "Chart it" : "Refresh")"
                          Icon="@(_isCharting ? "hourglass_top" : "timeline")"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Disabled="@_isCharting"
                          Click="@LoadTrendsAsync" />
        </Toolbar>

        <ChildContent>
            @if (_trends is { Count: > 0 } trends)
            {
                <RadzenChart>
                    @foreach (var trend in trends)
                    {
                        var title = $"{trend.Owner}/{trend.Name}";
                        // Colour keyed to the repository's NAME, not its position, so adding a
                        // repository does not recolour every series after it. StableIndex rather
                        // than GetHashCode for the reason documented on it: .NET randomises string
                        // hashing per process, so the latter reshuffles colours on every reload.
                        var stroke = SeriesPalette.Color(SeriesPalette.StableIndex(title));

                        <RadzenLineSeries Data="@trend.Points"
                                          CategoryProperty="Month"
                                          ValueProperty="Score"
                                          Title="@title"
                                          Stroke="@stroke"
                                          StrokeWidth="2">
                            <TooltipTemplate Context="point">
                                @if (point is CodeHealthTrendPointDto p)
                                {
                                    <div class="arc-tip">
                                        <div class="arc-tip__title">@title</div>
                                        <div class="arc-tip__meta">@p.Month.ToString("MMMM yyyy")</div>
                                        <div class="arc-tip__value">
                                            <span class="arc-tip__label">Health:</span> @p.Score @(string.IsNullOrEmpty(p.Grade) ? "" : $"({p.Grade})")
                                        </div>
                                    </div>
                                }
                            </TooltipTemplate>
                            <ChildContent>
                                <RadzenMarkers MarkerType="MarkerType.None" />
                            </ChildContent>
                        </RadzenLineSeries>
                    }

                    <RadzenCategoryAxis FormatString="{0:MMM yy}" LabelAutoRotation="-45">
                        <RadzenAxisTitle Text="Month" />
                        <RadzenGridLines Visible="true" />
                    </RadzenCategoryAxis>

                    @* Fixed 0–100 rather than fitted. An auto-scaled axis turns a two-point wobble
                       into a cliff, which is exactly how this chart gets misread. *@
                    <RadzenValueAxis Min="0" Max="100">
                        <RadzenAxisTitle Text="Health score" />
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>

                    <RadzenLegend Position="LegendPosition.Bottom" />
                    <RadzenChartTooltipOptions Shared="false" />
                </RadzenChart>

                <RadzenText TextStyle="TextStyle.Caption" class="ch__caveat">
                    Each point is the last commit on or before that month's 1st. A flat run means nothing was
                    committed in those months, so the code — and the score — did not change. Repositories with
                    no measurable month are absent from the chart; the grid below says why.
                </RadzenText>
            }
        </ChildContent>
    </ChartCard>

    <ChartCard Title="Repositories"
               IsLoading="@_isLoading"
               ErrorMessage="@_message"
               OnRetry="@LoadAsync"
               IsEmpty="@(_rows is null or { Count: 0 })"
               EmptyText="@GridEmptyText">
        <Toolbar>
            <RadzenButton Text="@(_rows is null ? "Analyze all" : "Re-run")"
                          Icon="@(_isLoading ? "hourglass_top" : "insights")"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Disabled="@_isLoading"
                          Click="@LoadAsync" />
        </Toolbar>

        <ChildContent>
            @if (_rows is { Count: > 0 })
            {
                <div class="u-scroll-x">
                    <RadzenDataGrid Data="@_rows"
                                    TItem="CodeHealthSummaryDto"
                                    AllowSorting="true"
                                    AllowPaging="true"
                                    PageSize="10"
                                    PagerHorizontalAlign="HorizontalAlign.Center"
                                    ShowPagingSummary="true"
                                    PagingSummaryFormat="Showing {0} to {1} of {2} repositories"
                                    Density="Density.Compact"
                                    Responsive="true"
                                    class="ch-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="CodeHealthSummaryDto" Property="Name" Title="Repository" MinWidth="180px">
                                <Template Context="row">
                                    <RadzenStack Gap="0.1rem">
                                        <a href="@($"/repositories/{row.RepositoryId}")" class="ch-repo-link">
                                            <strong>@row.Owner/@row.Name</strong>
                                        </a>
                                        @if (!row.Measured && !string.IsNullOrEmpty(row.UnmeasuredReason))
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" class="ch-unmeasured-reason">@row.UnmeasuredReason</RadzenText>
                                        }
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="CodeHealthSummaryDto" Property="Score" Title="Health" Width="90px" TextAlign="TextAlign.Center" Sortable="true">
                                <Template Context="row">
                                    @if (row.Measured)
                                    {
                                        <RadzenBadge BadgeStyle="@HealthBadgeStyle(row.Score)" Text="@row.Score.ToString()" class="ch-score-badge" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="—" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="CodeHealthSummaryDto" Property="Grade" Title="Grade" Width="80px" TextAlign="TextAlign.Center" Sortable="true">
                                <Template Context="row">
                                    @if (row.Measured && !string.IsNullOrEmpty(row.Grade))
                                    {
                                        <strong class="ch-grade">@row.Grade</strong>
                                    }
                                    else
                                    {
                                        <span class="ch-muted">—</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="CodeHealthSummaryDto" Property="MaintainabilityIndex" Title="C# Maintainability" Width="140px" TextAlign="TextAlign.Right" Sortable="true">
                                <Template Context="row">
                                    @if (row.Measured && row.MaintainabilityIndex.HasValue)
                                    {
                                        <span>@row.MaintainabilityIndex.Value.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="ch-muted">—</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="CodeHealthSummaryDto" Property="CyclomaticComplexity" Title="Complexity" Width="120px" TextAlign="TextAlign.Right" Sortable="true">
                                <Template Context="row">
                                    @if (row.Measured)
                                    {
                                        <span>@row.CyclomaticComplexity.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="ch-muted">—</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="CodeHealthSummaryDto" Property="LinesOfSourceCode" Title="Source Lines" Width="120px" TextAlign="TextAlign.Right" Sortable="true">
                                <Template Context="row">
                                    @if (row.Measured)
                                    {
                                        <span>@row.LinesOfSourceCode.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="ch-muted">—</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>

                <RadzenText TextStyle="TextStyle.Caption" class="ch__caveat">
                    Health folds the parsed C# maintainability index and the line-oriented estimate for every
                    other language into one figure, weighted by how many lines each describes. The two inputs
                    are not calibrated against each other — Visual Studio treats any index above 20 as healthy,
                    while the estimate is built so 90 is an A — so the <em>ranking</em> is the trustworthy part
                    and a C#-heavy repository grades harsher here than the IDE would call it. Depth of
                    Inheritance and Class Coupling need a resolved compilation and are not shown.
                </RadzenText>
            }
        </ChildContent>
    </ChartCard>
</div>

@code {
    private List<CodeHealthSummaryDto>? _rows;
    private bool _isLoading;
    private string? _message;

    private List<CodeHealthTrendDto>? _trends;
    private bool _isCharting;
    private string? _trendMessage;

    /// <summary>
    /// Trends are served from the per-commit memo after the first run, so they are cheap enough
    /// to fetch on every navigation. The grid, in contrast, walks trees and parses C# when the
    /// memo is cold, which is a wait the user must opt into.
    /// </summary>
    protected override Task OnInitializedAsync() => LoadTrendsAsync();

    private async Task LoadTrendsAsync()
    {
        _isCharting = true;
        _trendMessage = null;
        StateHasChanged();

        try
        {
            _trends = await Http.GetFromJsonAsync(
                "api/code-health/trends",
                AppJsonSerializerContext.Default.ListCodeHealthTrendDto);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the portfolio health trends");
            _trendMessage = "Could not load the trend chart. Try again in a moment.";
            _trends = null;
        }
        finally
        {
            _isCharting = false;
        }
    }

    private int _measuredCount => _rows?.Count(r => r.Measured) ?? 0;

    /// <summary>Empty-state copy: distinguishes "never fetched" from "fetched and genuinely empty".</summary>
    private string TrendEmptyText => _trends is null
        ? "Plot every repository's health month by month, for the trailing two years."
        : "No repository has history spanning a month boundary yet, so there is nothing to plot.";

    private string GridEmptyText => _rows is null
        ? "Nothing has been measured yet. Analyzing walks each repository's tree and parses its C#, so it takes a few seconds per repository."
        : "No repositories yet. Add some from the Repositories page and analyze them first.";

    private async Task LoadAsync()
    {
        _isLoading = true;
        _message = null;
        StateHasChanged();

        try
        {
            _rows = await Http.GetFromJsonAsync(
                "api/code-health",
                AppJsonSerializerContext.Default.ListCodeHealthSummaryDto);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load portfolio code health");
            _message = "Could not load code health. Try again in a moment.";
            _rows = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>Shared banding with the code-health card, so one number is not two colours.</summary>
    private static string Band(int score) => score switch
    {
        >= 80 => "good",
        >= 60 => "ok",
        >= 40 => "warn",
        _ => "bad"
    };

    private static BadgeStyle HealthBadgeStyle(int score) => score switch
    {
        >= 80 => BadgeStyle.Success,
        >= 60 => BadgeStyle.Info,
        >= 40 => BadgeStyle.Warning,
        _     => BadgeStyle.Danger
    };
}
