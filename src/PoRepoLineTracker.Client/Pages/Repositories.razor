@page "/"
@page "/repositories"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject ILogger<Repositories> Logger
@inject NavigationManager Navigation
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService
@inject AnalysisFeedClient Feed
@inject UserPreferencesClient PreferencesClient
@using PoRepoLineTracker.Client.Services
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Shared.Domain
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Models
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

@* The home page. It owns loading, analysis state and the actions; the onboarding empty state, the
   grid and the fallback poll are their own units (RepositoryOnboarding, RepositoryGrid,
   AnalysisFallbackPoll). This file was 1078 lines with the column templates and the poll loop
   inlined into it.

   What did NOT move: OnAnalysisProgressAsync. Analysis completion has exactly one path, and both
   the hub and the poll reach it through that method. *@

<div class="app-stack">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.125rem">
                <RadzenText TextStyle="TextStyle.H3" class="rp-title">Repositories</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rp-muted-tight">
                    @if (pageState.IsLoadingRepositories)
                    {
                        <span>Loading your repositories...</span>
                    }
                    else
                    {
                        <span>Tracking @pageState.Repositories.Count @(pageState.Repositories.Count == 1 ? "repository" : "repositories")</span>
                    }
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Upload Local"
                          Icon="upload_file"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Click="@ShowUploadDialog" />
            <RadzenButton Text="@(_showAddPanel ? "Cancel" : "Add Repository")"
                          Icon="@(_showAddPanel ? "close" : "add_circle")"
                          ButtonStyle="@(_showAddPanel ? ButtonStyle.Light : ButtonStyle.Primary)"
                          Variant="@(_showAddPanel ? Variant.Outlined : Variant.Filled)"
                          Click="@ToggleAddPanel" />
        </Actions>
    </PageHero>

    @if (_showAddPanel)
    {
        <RadzenCard class="rp-inline-card">
            <AddRepositoryPanel OnCompleted="@HandleAddCompleted" />
        </RadzenCard>
    }

    @if (!string.IsNullOrEmpty(pageState.AddRepoMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="true" Close="@(() => pageState.AddRepoMessage = string.Empty)">
            @pageState.AddRepoMessage
        </RadzenAlert>
    }
    @if (!string.IsNullOrEmpty(pageState.ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true" Close="@(() => pageState.ErrorMessage = string.Empty)">
            @pageState.ErrorMessage
        </RadzenAlert>
    }

    @* Live analysis feed. Renders nothing while idle, so it costs no vertical space until a job
       actually starts. *@
    <AnalysisActivityFeed />

    @if (pageState.IsLoadingRepositories)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenSkeleton Width="200px" Height="24px" />
                <RadzenStack Gap="0.5rem">
                    @for (int i = 0; i < 5; i++)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenSkeleton Circle="true" Width="40px" Height="40px" />
                            <RadzenSkeleton Width="150px" />
                            <RadzenSkeleton Width="200px" />
                            <RadzenSkeleton Width="120px" />
                            <RadzenSkeleton Width="80px" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
    else if (!pageState.Repositories.Any())
    {
        <RepositoryOnboarding OnAddClicked="@ToggleAddPanel" />
    }
    else
    {
        @* ─── Multi-repo comparison chart ───────────────────────────────────────
           No <ChartDisplayModeCard> here. It is a saved account-wide preference, not a property
           of this page, and rendering the control in two places meant two independent copies of
           the state: changing it in Settings left this page on the old mode until a reload. The
           value is read from UserPreferencesClient below and pushed by its Changed event. *@
        <AllReposComparisonChart @ref="_comparisonChart" ChartDisplayMode="@_chartDisplayMode" />

        <PortfolioStatTiles RepositoryCount="@pageState.Repositories.Count"
                            TotalLines="@_repoLatestLineCounts.Values.Sum()"
                            AnalyzedCount="@AnalyzedCount"
                            Trend="@TotalLinesTrend" />

        <RepositoryGrid @ref="_grid"
                        Rows="@FilteredRepositories"
                        SearchText="@searchText"
                        SearchTextChanged="@OnSearchTextChanged"
                        AnalysisProgress="@_analysisProgress"
                        ReanalysisStartTimes="@_reanalysisStartTimes"
                        ReanalyzingRepositoryId="@reanalyzingRepositoryId"
                        IsDeletingAll="@isDeletingAll"
                        OnRowActivated="@OnRowActivated"
                        OnReanalyze="@ConfirmReanalyze"
                        OnDelete="@ConfirmDeleteRepository"
                        OnDeleteAll="@ConfirmDeleteAll" />
    }
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private RepositoryPageState pageState = new();
    private RepositoryGrid? _grid;
    private AllReposComparisonChart? _comparisonChart;
    private bool _chartPrimed;
    private RepositoryId? reanalyzingRepositoryId;
    private bool _showAddPanel = false;
    private bool isDeletingAll = false;
    private string searchText = string.Empty;
    // Tracks the last Q value we wrote to the URL ourselves, so OnParametersSet
    // does not overwrite searchText after our own NavigateTo call.
    private string? _lastSyncedQ;
    private Dictionary<RepositoryId, DateTime> _reanalysisStartTimes = new();
    private Dictionary<RepositoryId, int> _repoLatestLineCounts = new();

    /// <summary>
    /// Per-repository daily totals for the grid sparkline column. Built from the SAME
    /// /allcharts/365 response that already feeds the line-count figures, so a trend beside every
    /// row costs no additional request — the series was being fetched and discarded.
    /// Trimmed to the last 45 points: a ~90px sparkline cannot resolve more.
    /// </summary>
    private Dictionary<RepositoryId, IReadOnlyList<DailyLineCountDto>> _repoTrends = new();
    private Dictionary<RepositoryId, AnalysisProgressDto> _analysisProgress = new();
    private readonly CancellationTokenSource _disposeCts = new();
    private ChartDisplayMode _chartDisplayMode = ChartDisplayMode.TrueData;

    /// <summary>
    /// True after <see cref="DisposeAsync"/> has run. Radzen charts and grids capture
    /// <c>DotNetObjectReference</c>s the JS module can still call into for a frame or two after
    /// disposal, which surfaced in the browser console as *"There is no tracked object with id
    /// '6'"* when navigating away from this page. Every async continuation early-exits on this
    /// flag rather than touching torn-down state.
    /// </summary>
    private bool _disposed;

    /// <summary>
    /// The one fallback for a hub that cannot be reached. It publishes frames through
    /// <see cref="OnAnalysisProgressAsync"/> and decides nothing itself — see the class comment
    /// for why that separation is load-bearing.
    /// </summary>
    private AnalysisFallbackPoll? _fallbackPoll;

    private AnalysisFallbackPoll FallbackPoll => _fallbackPoll ??= new AnalysisFallbackPoll(
        Http,
        Logger,
        isFeedConnected: () => Feed.IsConnected,
        publish: OnAnalysisProgressAsync,
        onRepositoryRefreshed: updated =>
        {
            var index = pageState.Repositories.FindIndex(r => r.Id == updated.Id);
            if (index >= 0) pageState.Repositories[index] = updated;
        },
        seenProgress: () => _analysisProgress);

    private IEnumerable<RepositoryGridRow> FilteredRepositories =>
        string.IsNullOrWhiteSpace(searchText)
            ? RepositoryRows
            : RepositoryRows.Where(r =>
                r.Owner.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                r.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<RepositoryGridRow> RepositoryRows => pageState.Repositories.Select(repository => new RepositoryGridRow(
        repository,
        _repoLatestLineCounts.TryGetValue(repository.Id, out var totalLines) ? totalLines : null,
        _repoTrends.TryGetValue(repository.Id, out var trend) ? trend : []));

    private int AnalyzedCount => pageState.Repositories.Count(r => r.LastAnalyzedCommitDate.HasValue);

    /// <summary>
    /// Portfolio-wide daily totals for the Total Lines sparkline. Built from the history already
    /// fetched by <see cref="LoadLatestLineCounts"/>, so the trend costs no extra request.
    /// Capped at the most recent 60 points — a sparkline a few centimetres wide cannot resolve
    /// 365 and the extra nodes are pure render cost.
    /// </summary>
    private List<DailyLineCountDto> TotalLinesTrend { get; set; } = [];

    protected override void OnParametersSet()
    {
        // Only sync searchText from the URL query param when the value genuinely
        // changed from outside (e.g., the user typed a URL directly or the browser
        // navigated back/forward).  When we call NavigateTo ourselves inside
        // OnSearchTextChanged we pre-set _lastSyncedQ so this guard fires and we
        // do NOT overwrite the value the user is actively typing.
        if (Q != _lastSyncedQ)
        {
            _lastSyncedQ = Q;
            searchText = Q ?? string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Feed.ProgressReceived += OnAnalysisProgressAsync;
        PreferencesClient.Changed += OnPreferencesChangedAsync;

        await Task.WhenAll(
            LoadRepositories(),
            LoadLatestLineCounts(),
            LoadChartDisplayMode(),
            Feed.EnsureConnectedAsync());

        StartFallbackPollIfNeeded();
    }

    /// <summary>
    /// Applies a progress frame to the grid. THE completion path — both the SignalR hub and
    /// <see cref="AnalysisFallbackPoll"/> arrive here, which is the whole reason the poll
    /// synthesises frames instead of handling completion itself.
    ///
    /// <para>This is the same state the poll used to fetch, arriving as it happens rather than up
    /// to five seconds later — and without the request-per-pending-repository that produced it.
    /// The completion branch does the reload the poll used to do, which is why the poll can be
    /// skipped entirely while the hub is up.</para>
    /// </summary>
    private async Task OnAnalysisProgressAsync(AnalysisProgressDto progress)
    {
        if (_disposed) return;

        var wasRunning = _analysisProgress.TryGetValue(progress.RepositoryId, out var previous) && previous.IsRunning;
        _analysisProgress[progress.RepositoryId] = progress;

        if (progress.IsRunning)
        {
            reanalyzingRepositoryId ??= progress.RepositoryId;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Only act on the transition. The service pushes the terminal frame once, but a reconnect
        // can replay state, and re-running the reload on each replay would restart the chart
        // fetches for a job that finished minutes ago.
        if (!wasRunning)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (reanalyzingRepositoryId == progress.RepositoryId) reanalyzingRepositoryId = null;
        _reanalysisStartTimes.Remove(progress.RepositoryId);
        FallbackPoll.StopWatching(progress.RepositoryId);

        if (progress.ErrorMessage is null)
        {
            _analysisProgress.Remove(progress.RepositoryId);

            await LoadRepositories();
            await LoadLatestLineCounts();
            await ReloadComparisonChartAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Analysis Complete",
                Detail = $"'{progress.Owner}/{progress.Name}' has been analyzed.",
                Duration = 5000
            });
        }

        await InvokeAsync(StateHasChanged);
        await ReloadGridAsync();
    }

    /// <summary>
    /// Kicks off the growth chart's first fetch once the page has painted.
    /// <para>
    /// AllReposComparisonChart deliberately does not load in OnInitializedAsync so the request
    /// stays off the initial render path, and documents that the parent primes it afterwards —
    /// but no parent ever did. The card therefore always rendered its "No history data yet"
    /// empty state until the user happened to click a range button, even with repositories
    /// analysed and the very same endpoint already supplying the Total Lines figure above it.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not gated on firstRender: the chart lives inside the "repositories loaded" branch, so
        // on the very first pass the page is still showing its skeleton and @ref is null. Prime
        // on the first render where the ref actually exists, and only once.
        if (_chartPrimed || _comparisonChart is null) return;
        _chartPrimed = true;
        await _comparisonChart.PrimeAsync();
    }

    private async Task LoadChartDisplayMode()
    {
        try
        {
            var preferences = await PreferencesClient.GetAsync();
            _chartDisplayMode = preferences?.ChartDisplayMode ?? ChartDisplayMode.TrueData;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load chart display mode; defaulting to true data");
            _chartDisplayMode = ChartDisplayMode.TrueData;
        }
    }

    /// <summary>
    /// Applies a preference saved anywhere in the app — in practice, the card on the Settings
    /// page — without a reload. The comparison chart re-transforms from data it already holds,
    /// so this costs no request.
    /// </summary>
    private async Task OnPreferencesChangedAsync(UserPreferences preferences)
    {
        if (_chartDisplayMode == preferences.ChartDisplayMode) return;
        _chartDisplayMode = preferences.ChartDisplayMode;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLatestLineCounts()
    {
        if (_disposed) return;
        try
        {
            var all = await Http.GetAppJsonAsync("/api/repositories/allcharts/365", AppJsonSerializerContext.Default.ListRepositoryLineCountHistoryDto);
            if (all != null)
            {
                // r.TotalLines, NOT the last point of the windowed series. The server computes it
                // from every commit the repository has (see RepositoryTotals), so a repository
                // untouched for longer than the 365-day window still reports its real size here.
                // Reading it off the series is what made this page's "Total Lines" smaller than
                // the identically-labelled figure on Insights.
                _repoLatestLineCounts = all
                    .Where(r => r.TotalLines > 0)
                    .ToDictionary(r => r.RepositoryId, r => r.TotalLines);
                _repoTrends = all
                    .Where(r => r.DailyLineCounts.Any())
                    .ToDictionary(
                        r => r.RepositoryId,
                        r => (IReadOnlyList<DailyLineCountDto>)r.DailyLineCounts
                            .OrderBy(d => d.Date)
                            .TakeLast(45)
                            .ToList());

                Logger.LogInformation("Loaded latest line counts for {Count} repositories", _repoLatestLineCounts.Count);

                // Sum every repo's per-day total into one portfolio series for the sparkline.
                TotalLinesTrend = all
                    .SelectMany(r => r.DailyLineCounts)
                    .GroupBy(d => d.Date.Date)
                    .OrderBy(g => g.Key)
                    .Select(g => new DailyLineCountDto { Date = g.Key, TotalLines = g.Sum(d => d.TotalLines) })
                    .TakeLast(60)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load latest line counts — Total Lines column will show dashes");
        }
    }

    private void OnSearchTextChanged(string value)
    {
        searchText = value;
        // Pre-sync _lastSyncedQ so that the OnParametersSet triggered by NavigateTo
        // does not overwrite the value the user just typed.
        _lastSyncedQ = string.IsNullOrEmpty(value) ? null : value;
        var uri = Navigation.GetUriWithQueryParameter("q", string.IsNullOrEmpty(value) ? null : value);
        Navigation.NavigateTo(uri, replace: true);
    }

    private void OnRowActivated(RepositoryGridRow row) => Navigation.NavigateTo($"/repositories/{row.Id}");

    // ToRelativeTime moved to ChartFormat — it was duplicated verbatim on RepositoryDetail.

    private void ToggleAddPanel()
    {
        _showAddPanel = !_showAddPanel;
    }

    private async Task ShowUploadDialog()
    {
        await DialogService.OpenAsync<UploadRepositoryDialog>("Upload Local Repository",
            new Dictionary<string, object> { },
            new DialogOptions
            {
                Width = "500px",
                Height = "auto",
                Resizable = true,
                Draggable = true
            });
    }

    private async Task HandleAddCompleted()
    {
        _showAddPanel = false;
        await LoadRepositories();
        await LoadLatestLineCounts();
        await ReloadComparisonChartAsync();
        StartFallbackPollIfNeeded();
        StateHasChanged();
    }

    /// <summary>
    /// Reloads the "All Repositories — Growth Overview" chart on the UI context.
    /// No-op until the chart is rendered (it only exists once repositories load).
    /// </summary>
    private Task ReloadComparisonChartAsync() =>
        _comparisonChart is null ? Task.CompletedTask : InvokeAsync(_comparisonChart.ReloadAsync);

    /// <summary>Same contract as the chart above: no-op until the grid exists.</summary>
    private Task ReloadGridAsync() =>
        _grid is null ? Task.CompletedTask : InvokeAsync(_grid.ReloadAsync);

    /// <summary>
    /// The _disposed guard is load-bearing. OnInitializedAsync awaits four loads and then calls
    /// this; navigating away in between disposes _disposeCts, and the continuation still arrives.
    /// The CTS is handed over whole rather than as a Token so nothing reads .Token on a disposed
    /// source — see AnalysisFallbackPoll.StartIfNeeded.
    /// </summary>
    private void StartFallbackPollIfNeeded()
    {
        if (_disposed) return;
        FallbackPoll.StartIfNeeded(pageState.Repositories, _disposeCts);
    }

    private async Task LoadRepositories()
    {
        if (_disposed) return;

        pageState.IsLoadingRepositories = true;
        pageState.ClearMessages();

        try
        {
            var repositories = await Http.GetAppJsonAsync("/api/repositories", AppJsonSerializerContext.Default.ListGitHubRepository);
            pageState.Repositories = repositories ?? new List<GitHubRepository>();
            Logger.LogInformation("Loaded {Count} repositories.", pageState.Repositories.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading repositories: {Message}", ex.Message);
            pageState.ErrorMessage = $"Error loading repositories: {ex.Message}";
        }
        finally
        {
            // Guarded rather than an early `return`: control cannot leave a finally block
            // (CS0157). Same intent — do not touch component state after disposal.
            if (!_disposed)
            {
                pageState.IsLoadingRepositories = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ConfirmDeleteRepository(GitHubRepository repo)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{repo.Owner}/{repo.Name}'? This will remove all associated data.",
            "Delete Repository",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await DeleteRepository(repo.Id);
        }
    }

    private async Task ConfirmReanalyze(GitHubRepository repo)
    {
        var confirmed = await DialogService.Confirm(
            $"Re-analyze '{repo.Owner}/{repo.Name}' from scratch?\n\nThis will delete all existing commit data and re-analyze the entire repository using your current file extension settings. This may take some time for repositories with many commits.",
            "Re-analyze Repository",
            new ConfirmOptions { OkButtonText = "Re-analyze", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await ReanalyzeRepository(repo);
        }
    }

    private async Task ReanalyzeRepository(GitHubRepository repo)
    {
        var priorDate = repo.LastAnalyzedCommitDate; // baseline for polling
        bool successfullyQueued = false;

        try
        {
            reanalyzingRepositoryId = repo.Id;
            _reanalysisStartTimes[repo.Id] = DateTime.UtcNow;
            StateHasChanged();

            Logger.LogInformation("Re-analyzing repository {RepositoryId}", repo.Id);
            var response = await Http.PostAsync($"/api/repositories/{repo.Id}/reanalyze", null);

            if (response.IsSuccessStatusCode)
            {
                successfullyQueued = true;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Re-analysis Started",
                    Detail = $"Re-analyzing '{repo.Owner}/{repo.Name}' with your current file extension settings. The badge will clear automatically when complete.",
                    Duration = 6000
                });
                Logger.LogInformation("Re-analysis queued for repository {RepositoryId}", repo.Id);

                // Register the wait and let the one fallback loop cover it. It no-ops while the
                // hub is connected, and the hub's frames clear the entry through the same handler.
                FallbackPoll.Watch(repo.Id, priorDate);
                StartFallbackPollIfNeeded();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to start re-analysis: {response.StatusCode}",
                    Duration = 6000
                });
                Logger.LogError("Failed to re-analyze repository {RepositoryId}. Status: {StatusCode}", repo.Id, response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error starting re-analysis: {ex.Message}",
                Duration = 6000
            });
            Logger.LogError(ex, "Error re-analyzing repository {RepositoryId}", repo.Id);
        }
        finally
        {
            // Only clear the badge immediately if the API call failed — on success the fallback
            // poll or the hub handles cleanup.
            if (!successfullyQueued)
            {
                reanalyzingRepositoryId = null;
                _reanalysisStartTimes.Remove(repo.Id);
                FallbackPoll.StopWatching(repo.Id);
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        // Unsubscribe only. AnalysisFeedClient is container-owned and shared with the activity
        // feed, so disposing it here would take the feed's connection down with the page.
        Feed.ProgressReceived -= OnAnalysisProgressAsync;
        PreferencesClient.Changed -= OnPreferencesChangedAsync;

        await _disposeCts.CancelAsync();
        _disposeCts.Dispose();
    }

    private async Task DeleteRepository(RepositoryId repositoryId)
    {
        try
        {
            Logger.LogInformation("Deleting repository {RepositoryId}", repositoryId);
            var response = await Http.DeleteAsync($"/api/repositories/{repositoryId}");

            if (response.IsSuccessStatusCode)
            {
                var repoToRemove = pageState.Repositories.FirstOrDefault(r => r.Id == repositoryId);
                if (repoToRemove != null)
                {
                    pageState.Repositories.Remove(repoToRemove);
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Deleted",
                        Detail = $"Repository '{repoToRemove.Owner}/{repoToRemove.Name}' deleted successfully!",
                        Duration = 4000
                    });
                }

                await ReloadGridAsync();
                Logger.LogInformation("Repository {RepositoryId} deleted successfully", repositoryId);
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to delete repository: {response.StatusCode}",
                    Duration = 6000
                });
                Logger.LogError("Failed to delete repository {RepositoryId}. Status: {StatusCode}", repositoryId, response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error deleting repository: {ex.Message}",
                Duration = 6000
            });
            Logger.LogError(ex, "Error deleting repository {RepositoryId}: {Message}", repositoryId, ex.Message);
        }
    }

    private async Task ConfirmDeleteAll()
    {
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete ALL repositories? This action cannot be undone.",
            "Delete All Repositories",
            new ConfirmOptions { OkButtonText = "Delete All", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await DeleteAllRepositories();
        }
    }

    private async Task DeleteAllRepositories()
    {
        try
        {
            isDeletingAll = true;
            Logger.LogInformation("Starting deletion of all repositories via API endpoint.");

            var response = await Http.DeleteAsync("/api/repositories/all");

            if (response.IsSuccessStatusCode)
            {
                pageState.Repositories.Clear();

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = "All repositories and data have been successfully deleted!",
                    Duration = 4000
                });
                Logger.LogInformation("All repositories deleted successfully.");
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Error deleting repositories: {response.StatusCode}",
                    Duration = 6000
                });
                Logger.LogError("Failed to delete all repositories. Status: {StatusCode}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error deleting all repositories: {ex.Message}",
                Duration = 6000
            });
            Logger.LogError(ex, "Error deleting all repositories: {Message}", ex.Message);
        }
        finally
        {
            isDeletingAll = false;
        }
    }
}
