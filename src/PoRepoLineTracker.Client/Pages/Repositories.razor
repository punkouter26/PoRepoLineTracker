@page "/"
@page "/repositories"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject ILogger<Repositories> Logger
@inject NavigationManager Navigation
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService
@inject AnalysisFeedClient Feed
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Domain.Models
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Models
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

<RadzenStack Gap="1rem">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.125rem">
                <RadzenText TextStyle="TextStyle.H3" class="rp-title">Repositories</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rp-muted-tight">
                    @if (pageState.IsLoadingRepositories)
                    {
                        <span>Loading your repositories...</span>
                    }
                    else
                    {
                        <span>Tracking @pageState.Repositories.Count @(pageState.Repositories.Count == 1 ? "repository" : "repositories")</span>
                    }
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Upload Local"
                          Icon="upload_file"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Click="@ShowUploadDialog" />
            <RadzenButton Text="@(_showAddPanel ? "Cancel" : "Add Repository")"
                          Icon="@(_showAddPanel ? "close" : "add_circle")"
                          ButtonStyle="@(_showAddPanel ? ButtonStyle.Light : ButtonStyle.Primary)"
                          Variant="@(_showAddPanel ? Variant.Outlined : Variant.Filled)"
                          Click="@ToggleAddPanel" />
        </Actions>
    </PageHero>

    @* Inline Add Repository Panel *@
    @if (_showAddPanel)
    {
        <RadzenCard class="rp-inline-card">
            <AddRepository IsInline="true" OnInlineCompleted="@HandleAddCompleted" />
        </RadzenCard>
    }

    @* Notification Messages *@
    @if (!string.IsNullOrEmpty(pageState.AddRepoMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="true" Close="@(() => pageState.AddRepoMessage = string.Empty)">
            @pageState.AddRepoMessage
        </RadzenAlert>
    }
    @if (!string.IsNullOrEmpty(pageState.ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true" Close="@(() => pageState.ErrorMessage = string.Empty)">
            @pageState.ErrorMessage
        </RadzenAlert>
    }

    @* Live analysis feed. Renders nothing while idle, so it costs no vertical space until a job
       actually starts. *@
    <AnalysisActivityFeed />

    @* Repository Data Grid *@
    @if (pageState.IsLoadingRepositories)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenSkeleton Width="200px" Height="24px" />
                <RadzenStack Gap="0.5rem">
                    @for (int i = 0; i < 5; i++)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenSkeleton Circle="true" Width="40px" Height="40px" />
                            <RadzenSkeleton Width="150px" />
                            <RadzenSkeleton Width="200px" />
                            <RadzenSkeleton Width="120px" />
                            <RadzenSkeleton Width="80px" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
    else if (!pageState.Repositories.Any())
    {
        @* Animated onboarding empty state — step indicators + CTA *@
        <RadzenCard class="rp-onboarding-card">
            <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem">
                <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="code" class="rp-onboarding-icon" />
                    <RadzenText TextStyle="TextStyle.H5" class="rp-onboarding-title">No repositories yet</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="rp-onboarding-lede">
                        Add your first GitHub repository and start tracking lines of code over time.
                    </RadzenText>
                </RadzenStack>

                @* How it works — 3-step flow *@
                <div class="rp-onboarding-steps">
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="add_link" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rp-step-title">Add Repo</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rp-step-caption">Connect your GitHub repository</RadzenText>
                    </div>
                    <div class="onboarding-connector" aria-hidden="true"></div>
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="manage_search" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rp-step-title">Auto-Analyze</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rp-step-caption">Commits scanned in background</RadzenText>
                    </div>
                    <div class="onboarding-connector" aria-hidden="true"></div>
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="trending_up" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rp-step-title">Track Trends</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rp-step-caption">Charts, extensions & top files</RadzenText>
                    </div>
                </div>

                <RadzenButton Text="Add Your First Repository"
                              Icon="add_circle"
                              ButtonStyle="ButtonStyle.Primary"
                              class="onboarding-cta-pulse rp-onboarding-cta"
                              Click="@ToggleAddPanel" />
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        @* ─── Multi-repo comparison chart ─────────────────────────────────────── *@
        <ChartDisplayModeCard Title="Chart Display"
                              Description="Switch between true values and a rolling 90-day moving average."
                              ValueChanged="OnChartDisplayModeChanged" />

        <AllReposComparisonChart @ref="_comparisonChart" ChartDisplayMode="@_chartDisplayMode" />

        @* ─── Stats cards ────────────────────────────────────────────────────────
           An auto-fit grid rather than a 3-column RadzenRow: the tiles reflow from 3 → 2 → 1
           across the range on their own, without a breakpoint per step, and never leave a
           half-empty final row. *@
        <div class="rp-stat-grid">
            <RadzenCard class="stat-card rp-stat rp-stat--repos">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="folder" class="rp-stat-icon rp-stat-icon--repos" />
                    <div class="rp-stat-body">
                        <div class="stat-value">@pageState.Repositories.Count</div>
                        <div class="stat-label">Repositories</div>
                    </div>
                </RadzenStack>
            </RadzenCard>
            <RadzenCard class="stat-card rp-stat rp-stat--lines">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="code" class="rp-stat-icon rp-stat-icon--lines" />
                    <div class="rp-stat-body">
                        <div class="stat-value">@(_repoLatestLineCounts.Values.Sum().ToString("N0"))</div>
                        <div class="stat-label">Total Lines</div>
                    </div>
                    @* The 365-day history is already in hand from LoadLatestLineCounts, so the
                       trend costs no extra request. *@
                    @if (TotalLinesTrend.Count > 1)
                    {
                        <div class="rp-stat-spark">
                            <RadzenSparkline Data="@TotalLinesTrend"
                                             CategoryProperty="Date"
                                             ValueProperty="TotalLines"
                                             Stroke="#0891b2"
                                             Fill="rgba(8, 145, 178, 0.16)" />
                        </div>
                    }
                </RadzenStack>
            </RadzenCard>
            <RadzenCard class="stat-card rp-stat rp-stat--analyzed">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="check_circle" class="rp-stat-icon rp-stat-icon--analyzed" />
                    <div class="rp-stat-body">
                        <div class="stat-value">@AnalyzedCount</div>
                        <div class="stat-label">Analyzed</div>
                    </div>
                    @* Completion at a glance — a gauge reads faster than "7" next to a count of 9. *@
                    @if (pageState.Repositories.Count > 0)
                    {
                        <div class="rp-stat-gauge">
                            <RadzenArcGauge>
                                <RadzenArcGaugeScale Min="0" Max="@pageState.Repositories.Count"
                                                     Step="@Math.Max(1, pageState.Repositories.Count / 4d)"
                                                     ShowTickLabels="false" TickPosition="GaugeTickPosition.None">
                                    <RadzenArcGaugeScaleValue Value="@AnalyzedCount" ShowValue="false" Fill="#059669" />
                                </RadzenArcGaugeScale>
                            </RadzenArcGauge>
                        </div>
                    }
                </RadzenStack>
            </RadzenCard>
        </div>

        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rp-searchbar">
                <RadzenIcon Icon="search" class="rp-muted-icon" />
                <RadzenTextBox Value="@searchText" ValueChanged="@OnSearchTextChanged" Placeholder="Search owner or repository..." class="rp-search-input" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="@(() => OnSearchTextChanged(string.Empty))" title="Clear search"
                                  aria-label="Clear repository search" />
                }
            </RadzenStack>

            @* Responsive="true" makes Radzen stack each row into a labelled card below its
               breakpoint. Without it the fixed column widths summed to ~736px, so on a phone the
               grid scrolled sideways and the Actions column sat permanently off-screen.

               RowRender is bound to OnRowRender rather than the inline lambda it used to carry:
               the lambda set only `cursor: pointer`, leaving rows unreachable by keyboard even
               though OnRowRender — which adds tabindex, role and Enter/Space handling — was
               already written and simply never wired up. *@
            <div class="u-scroll-x">
            <RadzenDataGrid @ref="grid"
                            Data="@FilteredRepositories"
                            TItem="RepositoryGridRow"
                            AllowFiltering="false"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="10"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="Showing {0} to {1} of {2} repositories"
                            AllowColumnResize="true"
                            Responsive="true"
                            RowRender="@OnRowRender"
                            RowClick="@OnRowClick"
                            Density="Density.Default"
                            class="rp-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Repository" MinWidth="160px">
                        <Template Context="row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
                                <RadzenText class="rp-repo-name" title="@($"{row.Owner}/{row.Name}")">@($"{row.Owner}/{row.Name}")</RadzenText>
                                <span @onclick:stopPropagation="true">
                                    <a href="@($"https://github.com/{row.Owner}/{row.Name}")" target="_blank"
                                       title="Open on GitHub"
                                       aria-label="@($"Open {row.Owner}/{row.Name} on GitHub in a new tab")"
                                       class="rp-github-link">
                                        @* RadzenIcon, not a bare <span class="material-icons">: the glyph
                                           comes from Radzen's bundled font rather than the Google Fonts
                                           CDN, so a failed CDN request cannot leave the literal text
                                           "open_in_new" in the middle of the grid row. *@
                                        <RadzenIcon Icon="open_in_new" class="rp-github-link__icon" />
                                    </a>
                                </span>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Property="TotalLinesSortValue" Title="Total Lines" Width="130px" TextAlign="TextAlign.Right" Sortable="true" Filterable="false">
                        <Template Context="row">
                            @if (row.TotalLinesSortValue.HasValue)
                            {
                                <RadzenText class="rp-lines-value">@row.TotalLinesSortValue.Value.ToString("N0")</RadzenText>
                            }
                            else if (row.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenSkeleton Width="70px" Height="18px" />
                            }
                            else
                            {
                                <RadzenText class="rp-disabled">—</RadzenText>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    @* Trend column. The 45-point series comes from the /allcharts/365 response the
                       page already fetches for the Total Lines figures, so this adds a per-row
                       trend for zero extra network cost. Sortable="false": a sparkline has no
                       meaningful ordering, and the adjacent Total Lines column already sorts. *@
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Trend" Width="110px" Sortable="false" Filterable="false">
                        <Template Context="row">
                            @if (row.HasTrend)
                            {
                                <div class="rp-row-spark">
                                    <RadzenSparkline Data="@row.Trend"
                                                     CategoryProperty="Date"
                                                     ValueProperty="TotalLines"
                                                     Stroke="var(--rz-primary)"
                                                     Fill="rgba(103, 80, 164, 0.16)" />
                                </div>
                            }
                            else
                            {
                                <RadzenText class="rp-disabled">—</RadzenText>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Property="LastAnalyzedCommitDate" Title="Last Analyzed" Width="130px" Sortable="true">
                        <Template Context="row">
                            @if (row.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenStack Gap="0.1rem">
                                    <RadzenText class="rp-relative-time">@ChartFormat.RelativeTime(row.LastAnalyzedCommitDate)</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" class="rp-muted">@row.LastAnalyzedCommitDate.Value.ToString("MM/dd/yy HH:mm")</RadzenText>
                                </RadzenStack>
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Never" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Status" Width="200px" Filterable="false" Sortable="false">
                        <Template Context="row">
                            @{
                                var prog = _analysisProgress.TryGetValue(row.Id, out var p) ? p : null;
                            }
                            @if (reanalyzingRepositoryId == row.Id || (prog != null && prog.IsRunning))
                            {
                                <RadzenStack Gap="0.25rem">
                                    @* Step badge + spin icon *@
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenIcon Icon="sync" class="spin-icon rp-sync-icon" />
                                        <RadzenBadge BadgeStyle="@(prog?.IsStuck == true ? BadgeStyle.Danger : BadgeStyle.Info)"
                                                     Text="@(prog?.StepName ?? "Analyzing")" />
                                    </RadzenStack>

                                    @* Detailed step description *@
                                    @if (prog != null)
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" class="rp-prog-note">
                                            @prog.StepDescription
                                        </RadzenText>

                                        @* Progress bar — determinate when commit count is known *@
                                        @if (prog.CommitsTotal > 0)
                                        {
                                            <div class="reanalysis-progress-wrap">
                                                <RadzenProgressBar Mode="ProgressBarMode.Determinate"
                                                                   Value="@prog.ProgressPercent"
                                                                   class="rp-prog-bar" />
                                            </div>
                                            <RadzenText TextStyle="TextStyle.Caption" class="rp-prog-sub">
                                                @prog.CommitsProcessed / @prog.CommitsTotal commits (@prog.ProgressPercent%)
                                            </RadzenText>
                                        }
                                        else
                                        {
                                            <div class="reanalysis-progress-wrap">
                                                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                                                                   Value="100"
                                                                   class="rp-prog-bar" />
                                            </div>
                                        }

                                        @* Stuck warning *@
                                        @if (prog.IsStuck)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.2rem">
                                                <RadzenIcon Icon="warning" class="rp-warn-icon" />
                                                <RadzenText TextStyle="TextStyle.Caption" class="rp-danger-sub">
                                                    No progress in 3+ min — may be stuck
                                                </RadzenText>
                                            </RadzenStack>
                                        }

                                        @* Error message *@
                                        @if (!string.IsNullOrEmpty(prog.ErrorMessage))
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" class="rp-danger-sub" title="@prog.ErrorMessage">
                                                Error: @(prog.ErrorMessage.Length > 40 ? prog.ErrorMessage[..40] + "…" : prog.ErrorMessage)
                                            </RadzenText>
                                        }
                                    }
                                    else if (_reanalysisStartTimes.TryGetValue(row.Id, out var startTime))
                                    {
                                        <div class="reanalysis-progress-wrap">
                                            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                                                               Value="100"
                                                               class="rp-prog-bar" />
                                        </div>
                                        <RadzenText TextStyle="TextStyle.Caption" class="rp-prog-note">
                                            @GetReanalysisElapsed(startTime)
                                        </RadzenText>
                                    }
                                </RadzenStack>
                            }
                            else if (prog != null && !string.IsNullOrEmpty(prog.ErrorMessage))
                            {
                                <RadzenStack Gap="0.2rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenIcon Icon="error_outline" class="rp-error-icon" />
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
                                    </RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Caption" class="rp-danger-sub" title="@prog.ErrorMessage">
                                        @(prog.ErrorMessage.Length > 50 ? prog.ErrorMessage[..50] + "…" : prog.ErrorMessage)
                                    </RadzenText>
                                </RadzenStack>
                            }
                            else if (!row.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Pending" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Done" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Actions" Width="80px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="row">
                            <span @onclick:stopPropagation="true">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                    <RadzenButton Icon="refresh" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined"
                                                  Click="@(() => ConfirmReanalyze(row.Repository))"
                                                  title="Re-analyze from scratch"
                                                  aria-label="@($"Re-analyze {row.Owner}/{row.Name}")"
                                                  Disabled="@(reanalyzingRepositoryId == row.Id)" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                                  Click="@(() => ConfirmDeleteRepository(row.Repository))"
                                                  title="Delete repository"
                                                  aria-label="@($"Delete {row.Owner}/{row.Name}")" />
                                </RadzenStack>
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="" Width="36px" Filterable="false" Sortable="false">
                        <Template>
                            <RadzenIcon Icon="chevron_right" class="rp-chevron" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            </div>

            @* Danger Zone — separated from primary actions *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                         class="rp-danger-zone">
                <RadzenText TextStyle="TextStyle.Caption" class="rp-danger-zone__label">Danger Zone</RadzenText>
                <RadzenButton Text="Remove All Repositories"
                              Icon="delete_forever"
                              ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Outlined"
                              Size="ButtonSize.Small"
                              Click="@ConfirmRemoveAll"
                              IsBusy="@isRemovingAll"
                              BusyText="Removing..." />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>



@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private RepositoryPageState pageState = new();
    private RadzenDataGrid<RepositoryGridRow>? grid;
    private AllReposComparisonChart? _comparisonChart;
    private bool _chartPrimed;
    private RepositoryId? reanalyzingRepositoryId;
    private bool _showAddPanel = false;
    private bool isRemovingAll = false;
    private string searchText = string.Empty;
    // Tracks the last Q value we wrote to the URL ourselves, so OnParametersSet
    // does not overwrite searchText after our own NavigateTo call.
    private string? _lastSyncedQ;
    private Dictionary<RepositoryId, DateTime> _reanalysisStartTimes = new();
    private Dictionary<RepositoryId, int> _repoLatestLineCounts = new();

    /// <summary>
    /// Per-repository daily totals for the grid sparkline column. Built from the SAME
    /// /allcharts/365 response that already feeds the line-count figures, so a trend beside every
    /// row costs no additional request — the series was being fetched and discarded.
    /// Trimmed to the last 45 points: a ~90px sparkline cannot resolve more.
    /// </summary>
    private Dictionary<RepositoryId, IReadOnlyList<DailyLineCountDto>> _repoTrends = new();
    private Dictionary<RepositoryId, AnalysisProgressDto> _analysisProgress = new();
    private readonly CancellationTokenSource _disposeCts = new();
    private ChartDisplayMode _chartDisplayMode = ChartDisplayMode.TrueData;

    private IEnumerable<RepositoryGridRow> FilteredRepositories =>
        string.IsNullOrWhiteSpace(searchText)
            ? RepositoryRows
            : RepositoryRows.Where(r =>
                r.Owner.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                r.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<RepositoryGridRow> RepositoryRows => pageState.Repositories.Select(repository => new RepositoryGridRow(
        repository,
        _repoLatestLineCounts.TryGetValue(repository.Id, out var totalLines) ? totalLines : null,
        _repoTrends.TryGetValue(repository.Id, out var trend) ? trend : []));

    private int AnalyzedCount => pageState.Repositories.Count(r => r.LastAnalyzedCommitDate.HasValue);

    /// <summary>
    /// Portfolio-wide daily totals for the Total Lines sparkline. Built from the history already
    /// fetched by <see cref="LoadLatestLineCounts"/>, so the trend costs no extra request.
    /// Capped at the most recent 60 points — a sparkline a few centimetres wide cannot resolve
    /// 365 and the extra nodes are pure render cost.
    /// </summary>
    private List<DailyLineCountDto> TotalLinesTrend { get; set; } = [];


    protected override void OnParametersSet()
    {
        // Only sync searchText from the URL query param when the value genuinely
        // changed from outside (e.g., the user typed a URL directly or the browser
        // navigated back/forward).  When we call NavigateTo ourselves inside
        // OnSearchTextChanged we pre-set _lastSyncedQ so this guard fires and we
        // do NOT overwrite the value the user is actively typing.
        if (Q != _lastSyncedQ)
        {
            _lastSyncedQ = Q;
            searchText = Q ?? string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Feed.ProgressReceived += OnAnalysisProgressAsync;

        await Task.WhenAll(
            LoadRepositories(),
            LoadLatestLineCounts(),
            Feed.EnsureConnectedAsync());

        StartPassivePendingPollIfNeeded();
    }

    /// <summary>
    /// Applies a pushed progress frame to the grid.
    ///
    /// <para>This is the same state the poll used to fetch, arriving as it happens rather than up
    /// to five seconds later — and without the request-per-pending-repository that produced it.
    /// The completion branch does the reload the poll used to do, which is why the poll can be
    /// skipped entirely while the hub is up.</para>
    /// </summary>
    private async Task OnAnalysisProgressAsync(AnalysisProgressDto progress)
    {
        var wasRunning = _analysisProgress.TryGetValue(progress.RepositoryId, out var previous) && previous.IsRunning;
        _analysisProgress[progress.RepositoryId] = progress;

        if (progress.IsRunning)
        {
            reanalyzingRepositoryId ??= progress.RepositoryId;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Only act on the transition. The service pushes the terminal frame once, but a reconnect
        // can replay state, and re-running the reload on each replay would restart the chart
        // fetches for a job that finished minutes ago.
        if (!wasRunning)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (reanalyzingRepositoryId == progress.RepositoryId) reanalyzingRepositoryId = null;
        _reanalysisStartTimes.Remove(progress.RepositoryId);

        if (progress.ErrorMessage is null)
        {
            _analysisProgress.Remove(progress.RepositoryId);

            await LoadRepositories();
            await LoadLatestLineCounts();
            await ReloadComparisonChartAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Analysis Complete",
                Detail = $"'{progress.Owner}/{progress.Name}' has been analyzed.",
                Duration = 5000
            });
        }

        await InvokeAsync(StateHasChanged);
        if (grid is not null) await InvokeAsync(grid.Reload);
    }

    /// <summary>
    /// Kicks off the growth chart's first fetch once the page has painted.
    /// <para>
    /// AllReposComparisonChart deliberately does not load in OnInitializedAsync so the request
    /// stays off the initial render path, and documents that the parent primes it afterwards —
    /// but no parent ever did. The card therefore always rendered its "No history data yet"
    /// empty state until the user happened to click a range button, even with repositories
    /// analysed and the very same endpoint already supplying the Total Lines figure above it.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not gated on firstRender: the chart lives inside the "repositories loaded" branch, so
        // on the very first pass the page is still showing its skeleton and @ref is null. Prime
        // on the first render where the ref actually exists, and only once.
        if (_chartPrimed || _comparisonChart is null) return;
        _chartPrimed = true;
        await _comparisonChart.PrimeAsync();
    }

