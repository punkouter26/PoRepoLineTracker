@page "/"
@page "/repositories"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject ILogger<Repositories> Logger
@inject NavigationManager Navigation
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Domain.Models
@using PoRepoLineTracker.Application.Models
@using PoRepoLineTracker.Shared.Models
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

<RadzenStack Gap="1rem">
    <div class="repo-hero">
    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenStack Gap="0.125rem">
                <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">Repositories</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color); margin: 0;">
                    @if (pageState.IsLoadingRepositories)
                    {
                        <span>Loading your repositories...</span>
                    }
                    else
                    {
                        <span>Tracking @pageState.Repositories.Count @(pageState.Repositories.Count == 1 ? "repository" : "repositories")</span>
                    }
                </RadzenText>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-end">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                <RadzenButton Text="@(_showAddPanel ? "Cancel" : "Add Repository")"
                              Icon="@(_showAddPanel ? "close" : "add_circle")"
                              ButtonStyle="@(_showAddPanel ? ButtonStyle.Light : ButtonStyle.Primary)"
                              Variant="@(_showAddPanel ? Variant.Outlined : Variant.Filled)"
                              Click="@ToggleAddPanel" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    </div>

    @* Inline Add Repository Panel *@
    @if (_showAddPanel)
    {
        <RadzenCard Style="border-left: 3px solid var(--rz-primary); animation: fadeSlideUp 0.25s ease both;">
            <AddRepository IsInline="true" OnInlineCompleted="@HandleAddCompleted" />
        </RadzenCard>
    }

    @* Notification Messages *@
    @if (!string.IsNullOrEmpty(pageState.AddRepoMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="true" Close="@(() => pageState.AddRepoMessage = string.Empty)">
            @pageState.AddRepoMessage
        </RadzenAlert>
    }
    @if (!string.IsNullOrEmpty(pageState.ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true" Close="@(() => pageState.ErrorMessage = string.Empty)">
            @pageState.ErrorMessage
        </RadzenAlert>
    }

    @* Repository Data Grid *@
    @if (pageState.IsLoadingRepositories)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenSkeleton Width="200px" Height="24px" />
                <RadzenStack Gap="0.5rem">
                    @for (int i = 0; i < 5; i++)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenSkeleton Circle="true" Width="40px" Height="40px" />
                            <RadzenSkeleton Width="150px" />
                            <RadzenSkeleton Width="200px" />
                            <RadzenSkeleton Width="120px" />
                            <RadzenSkeleton Width="80px" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
    else if (!pageState.Repositories.Any())
    {
        @* Animated onboarding empty state — step indicators + CTA *@
        <RadzenCard Style="padding: 2.5rem 2rem;">
            <RadzenStack AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="code" Style="font-size: 2.8rem; color: var(--rz-primary); animation: fadeSlideUp 0.4s ease both;" />
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; animation: fadeSlideUp 0.4s ease 0.05s both;">No repositories yet</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color); text-align: center; max-width: 380px; animation: fadeSlideUp 0.4s ease 0.1s both;">
                        Add your first GitHub repository and start tracking lines of code over time.
                    </RadzenText>
                </RadzenStack>

                @* How it works — 3-step flow *@
                <div style="display: flex; align-items: flex-start; justify-content: center; gap: 0; flex-wrap: wrap; width: 100%; max-width: 520px;">
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="add_link" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; text-align: center;">Add Repo</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); text-align: center;">Connect your GitHub repository</RadzenText>
                    </div>
                    <div class="onboarding-connector" aria-hidden="true"></div>
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="manage_search" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; text-align: center;">Auto-Analyze</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); text-align: center;">Commits scanned in background</RadzenText>
                    </div>
                    <div class="onboarding-connector" aria-hidden="true"></div>
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="trending_up" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; text-align: center;">Track Trends</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); text-align: center;">Charts, extensions & top files</RadzenText>
                    </div>
                </div>

                <RadzenButton Text="Add Your First Repository"
                              Icon="add_circle"
                              ButtonStyle="ButtonStyle.Primary"
                              class="onboarding-cta-pulse"
                              Style="padding: 0.75rem 2rem; font-size: 1rem; font-weight: 600; border-radius: 12px;"
                              Click="@ToggleAddPanel" />
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        @* ─── Multi-repo comparison chart ─────────────────────────────────────── *@
        <ChartDisplayModeCard Title="Chart Display"
                              Description="Switch between true values and a rolling 90-day moving average."
                              ValueChanged="OnChartDisplayModeChanged" />

        <AllReposComparisonChart ChartDisplayMode="@_chartDisplayMode" />

        @* ─── Stats cards ──────────────────────────────────────────────────────── *@
        <RadzenRow Gap="0.75rem" Style="margin-bottom: 0.25rem;">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="stat-card" Style="--stat-accent: var(--rz-primary); padding: 1rem;">
                    <div class="stat-value">@pageState.Repositories.Count</div>
                    <div class="stat-label">Repositories</div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="stat-card" Style="--stat-accent: #0891b2; padding: 1rem;">
                    <div class="stat-value">@(_repoLatestLineCounts.Values.Sum().ToString("N0"))</div>
                    <div class="stat-label">Total Lines</div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="stat-card" Style="--stat-accent: #059669; padding: 1rem;">
                    <div class="stat-value">@(pageState.Repositories.Count(r => r.LastAnalyzedCommitDate.HasValue))</div>
                    <div class="stat-label">Analyzed</div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="search" Style="color: var(--rz-text-secondary-color);" />
                <RadzenTextBox Value="@searchText" ValueChanged="@OnSearchTextChanged" Placeholder="Search owner or repository..." Style="width: 280px;" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="@(() => OnSearchTextChanged(string.Empty))" title="Clear search" />
                }
            </RadzenStack>

            <div style="overflow-x: auto;">
            <RadzenDataGrid @ref="grid"
                            Data="@FilteredRepositories"
                            TItem="RepositoryGridRow"
                            AllowFiltering="false"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="10"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="Showing {0} to {1} of {2} repositories"
                            AllowColumnResize="true"
                            RowRender="@(args => args.Attributes["style"] = "cursor: pointer;")"
                            RowClick="@OnRowClick"
                            Density="Density.Default"
                            Style="height: auto;">
                <Columns>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Repository" MinWidth="160px">
                        <Template Context="row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
                                <RadzenText Style="font-weight: 600;" title="@($"{row.Owner}/{row.Name}")">@($"{row.Owner}/{row.Name}")</RadzenText>
                                <span @onclick:stopPropagation="true">
                                    <a href="@($"https://github.com/{row.Owner}/{row.Name}")" target="_blank"
                                       title="Open on GitHub" style="color: var(--rz-text-disabled-color); display: flex; align-items: center; line-height: 1;">
                                        <span class="material-icons" style="font-size: 0.95rem;">open_in_new</span>
                                    </a>
                                </span>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Property="TotalLinesSortValue" Title="Total Lines" Width="110px" TextAlign="TextAlign.Right" Sortable="true" Filterable="false">
                        <Template Context="row">
                            @if (row.TotalLinesSortValue.HasValue)
                            {
                                <RadzenText Style="font-weight: 600; color: var(--rz-primary);">@row.TotalLinesSortValue.Value.ToString("N0")</RadzenText>
                            }
                            else if (row.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenSkeleton Width="70px" Height="18px" />
                            }
                            else
                            {
                                <RadzenText Style="color: var(--rz-text-disabled-color);">—</RadzenText>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Property="LastAnalyzedCommitDate" Title="Last Analyzed" Width="130px" Sortable="true">
                        <Template Context="row">
                            @if (row.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenStack Gap="0.1rem">
                                    <RadzenText Style="font-weight: 500;">@ToRelativeTime(row.LastAnalyzedCommitDate)</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@row.LastAnalyzedCommitDate.Value.ToString("MM/dd/yy HH:mm")</RadzenText>
                                </RadzenStack>
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Never" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Status" Width="200px" Filterable="false" Sortable="false">
                        <Template Context="row">
                            @{
                                var prog = _analysisProgress.TryGetValue(row.Id, out var p) ? p : null;
                            }
                            @if (reanalyzingRepositoryId == row.Id || (prog != null && prog.IsRunning))
                            {
                                <RadzenStack Gap="0.25rem">
                                    @* Step badge + spin icon *@
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenIcon Icon="sync" class="spin-icon" Style="font-size: 0.9rem; color: var(--rz-info); flex-shrink:0;" />
                                        <RadzenBadge BadgeStyle="@(prog?.IsStuck == true ? BadgeStyle.Danger : BadgeStyle.Info)"
                                                     Text="@(prog?.StepName ?? "Analyzing")" />
                                    </RadzenStack>

                                    @* Detailed step description *@
                                    @if (prog != null)
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); font-size: 0.68rem; line-height: 1.3;">
                                            @prog.StepDescription
                                        </RadzenText>

                                        @* Progress bar — determinate when commit count is known *@
                                        @if (prog.CommitsTotal > 0)
                                        {
                                            <div class="reanalysis-progress-wrap">
                                                <RadzenProgressBar Mode="ProgressBarMode.Determinate"
                                                                   Value="@prog.ProgressPercent"
                                                                   Style="height: 5px; border-radius: 4px;" />
                                            </div>
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); font-size: 0.65rem;">
                                                @prog.CommitsProcessed / @prog.CommitsTotal commits (@prog.ProgressPercent%)
                                            </RadzenText>
                                        }
                                        else
                                        {
                                            <div class="reanalysis-progress-wrap">
                                                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                                                                   Value="100"
                                                                   Style="height: 5px; border-radius: 4px;" />
                                            </div>
                                        }

                                        @* Stuck warning *@
                                        @if (prog.IsStuck)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.2rem">
                                                <RadzenIcon Icon="warning" Style="font-size: 0.8rem; color: var(--rz-danger);" />
                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger); font-size: 0.65rem;">
                                                    No progress in 3+ min — may be stuck
                                                </RadzenText>
                                            </RadzenStack>
                                        }

                                        @* Error message *@
                                        @if (!string.IsNullOrEmpty(prog.ErrorMessage))
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger); font-size: 0.65rem;" title="@prog.ErrorMessage">
                                                Error: @(prog.ErrorMessage.Length > 40 ? prog.ErrorMessage[..40] + "…" : prog.ErrorMessage)
                                            </RadzenText>
                                        }
                                    }
                                    else if (_reanalysisStartTimes.TryGetValue(row.Id, out var startTime))
                                    {
                                        <div class="reanalysis-progress-wrap">
                                            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                                                               Value="100"
                                                               Style="height: 5px; border-radius: 4px;" />
                                        </div>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); font-size: 0.68rem;">
                                            @GetReanalysisElapsed(startTime)
                                        </RadzenText>
                                    }
                                </RadzenStack>
                            }
                            else if (prog != null && !string.IsNullOrEmpty(prog.ErrorMessage))
                            {
                                <RadzenStack Gap="0.2rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenIcon Icon="error_outline" Style="font-size: 0.9rem; color: var(--rz-danger);" />
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
                                    </RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger); font-size: 0.65rem;" title="@prog.ErrorMessage">
                                        @(prog.ErrorMessage.Length > 50 ? prog.ErrorMessage[..50] + "…" : prog.ErrorMessage)
                                    </RadzenText>
                                </RadzenStack>
                            }
                            else if (!row.LastAnalyzedCommitDate.HasValue)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Pending" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Done" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Actions" Width="80px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="row">
                            <span @onclick:stopPropagation="true">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                    <RadzenButton Icon="refresh" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined"
                                                  Click="@(() => ConfirmReanalyze(row.Repository))"
                                                  title="Re-analyze from scratch"
                                                  Disabled="@(reanalyzingRepositoryId == row.Id)" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                                  Click="@(() => ConfirmDeleteRepository(row.Repository))"
                                                  title="Delete repository" />
                                </RadzenStack>
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepositoryGridRow" Title="" Width="36px" Filterable="false" Sortable="false">
                        <Template>
                            <RadzenIcon Icon="chevron_right" Style="color: var(--rz-text-disabled-color); font-size: 1.1rem;" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            </div>

            @* Danger Zone — separated from primary actions *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                         Style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--rz-border-disabled-color);">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-disabled-color); font-style: italic;">Danger Zone</RadzenText>
                <RadzenButton Text="Remove All Repositories"
                              Icon="delete_forever"
                              ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Outlined"
                              Size="ButtonSize.Small"
                              Click="@ConfirmRemoveAll"
                              IsBusy="@isRemovingAll"
                              BusyText="Removing..." />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>



@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private RepositoryPageState pageState = new();
    private RadzenDataGrid<RepositoryGridRow>? grid;
    private Guid? reanalyzingRepositoryId;
    private bool _showAddPanel = false;
    private bool isRemovingAll = false;
    private string searchText = string.Empty;
    // Tracks the last Q value we wrote to the URL ourselves, so OnParametersSet
    // does not overwrite searchText after our own NavigateTo call.
    private string? _lastSyncedQ;
    private Dictionary<Guid, DateTime> _reanalysisStartTimes = new();
    private Dictionary<Guid, int> _repoLatestLineCounts = new();
    private Dictionary<Guid, AnalysisProgressDto> _analysisProgress = new();
    private readonly CancellationTokenSource _disposeCts = new();
    private ChartDisplayMode _chartDisplayMode = ChartDisplayMode.TrueData;

    private IEnumerable<RepositoryGridRow> FilteredRepositories =>
        string.IsNullOrWhiteSpace(searchText)
            ? RepositoryRows
            : RepositoryRows.Where(r =>
                r.Owner.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                r.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<RepositoryGridRow> RepositoryRows => pageState.Repositories.Select(repository => new RepositoryGridRow(
        repository,
        _repoLatestLineCounts.TryGetValue(repository.Id, out var totalLines) ? totalLines : null));


    protected override void OnParametersSet()
    {
        // Only sync searchText from the URL query param when the value genuinely
        // changed from outside (e.g., the user typed a URL directly or the browser
        // navigated back/forward).  When we call NavigateTo ourselves inside
        // OnSearchTextChanged we pre-set _lastSyncedQ so this guard fires and we
        // do NOT overwrite the value the user is actively typing.
        if (Q != _lastSyncedQ)
        {
            _lastSyncedQ = Q;
            searchText = Q ?? string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadRepositories(),
            LoadLatestLineCounts());
        StartPassivePendingPollIfNeeded();
    }

    private async Task OnChartDisplayModeChanged(ChartDisplayMode chartDisplayMode)
    {
        _chartDisplayMode = chartDisplayMode;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLatestLineCounts()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<RepositoryLineCountHistoryDto>>("/api/repositories/allcharts/365");
            if (all != null)
            {
                _repoLatestLineCounts = all
                    .Where(r => r.DailyLineCounts.Any())
                    .ToDictionary(
                        r => r.RepositoryId,
                        r => r.DailyLineCounts.OrderByDescending(d => d.Date).First().TotalLines);
                Logger.LogInformation("Loaded latest line counts for {Count} repositories", _repoLatestLineCounts.Count);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load latest line counts — Total Lines column will show dashes");
        }
    }

    private void OnSearchTextChanged(string value)
    {
        searchText = value;
        // Pre-sync _lastSyncedQ so that the OnParametersSet triggered by NavigateTo
        // does not overwrite the value the user just typed.
        _lastSyncedQ = string.IsNullOrEmpty(value) ? null : value;
        var uri = Navigation.GetUriWithQueryParameter("q", string.IsNullOrEmpty(value) ? null : value);
        Navigation.NavigateTo(uri, replace: true);
    }

    private void OnRowClick(DataGridRowMouseEventArgs<RepositoryGridRow> args)
    {
        Navigation.NavigateTo($"/repositories/{args.Data.Id}");
    }

    private static string ToRelativeTime(DateTime? dt)
    {
        if (!dt.HasValue) return string.Empty;
        var diff = DateTime.UtcNow - dt.Value.ToUniversalTime();
        if (diff.TotalHours < 1) return "just now";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 30) return $"{(int)(diff.TotalDays / 7)}w ago";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)}mo ago";
        return $"{(int)(diff.TotalDays / 365)}y ago";
    }

    private void ToggleAddPanel()
    {
        _showAddPanel = !_showAddPanel;
    }

    private async Task HandleAddCompleted()
    {
        _showAddPanel = false;
        await LoadRepositories();
        await LoadLatestLineCounts();
        StartPassivePendingPollIfNeeded();
        StateHasChanged();
    }

    private static string GetReanalysisElapsed(DateTime startTime)
    {
        var elapsed = DateTime.UtcNow - startTime;
        if (elapsed.TotalMinutes < 1) return "just started";
        if (elapsed.TotalMinutes < 60) return $"started {(int)elapsed.TotalMinutes} min ago";
        return $"started {(int)elapsed.TotalHours}h ago";
    }

    private async Task LoadRepositories()
    {
        pageState.IsLoadingRepositories = true;
        pageState.ClearMessages();
        
        try
        {
            var repositories = await Http.GetFromJsonAsync<List<GitHubRepository>>("/api/repositories");
            pageState.Repositories = repositories ?? new List<GitHubRepository>();
            Logger.LogInformation("Loaded {Count} repositories.", pageState.Repositories.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading repositories: {Message}", ex.Message);
            pageState.ErrorMessage = $"Error loading repositories: {ex.Message}";
        }
        finally
        {
            pageState.IsLoadingRepositories = false;
        }
    }

    private async Task ConfirmDeleteRepository(GitHubRepository repo)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{repo.Owner}/{repo.Name}'? This will remove all associated data.",
            "Delete Repository",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await DeleteRepository(repo.Id);
        }
    }

    private async Task ConfirmReanalyze(GitHubRepository repo)
    {
        var confirmed = await DialogService.Confirm(
            $"Re-analyze '{repo.Owner}/{repo.Name}' from scratch?\n\nThis will delete all existing commit data and re-analyze the entire repository using your current file extension settings. This may take some time for repositories with many commits.",
            "Re-analyze Repository",
            new ConfirmOptions { OkButtonText = "Re-analyze", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await ReanalyzeRepository(repo);
        }
    }

    private async Task ReanalyzeRepository(GitHubRepository repo)
    {
        var priorDate = repo.LastAnalyzedCommitDate; // baseline for polling
        bool successfullyQueued = false;

        try
        {
            reanalyzingRepositoryId = repo.Id;
            _reanalysisStartTimes[repo.Id] = DateTime.UtcNow;
            StateHasChanged();

            Logger.LogInformation("Re-analyzing repository {RepositoryId}", repo.Id);
            var response = await Http.PostAsync($"/api/repositories/{repo.Id}/reanalyze", null);

            if (response.IsSuccessStatusCode)
            {
                successfullyQueued = true;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Re-analysis Started",
                    Detail = $"Re-analyzing '{repo.Owner}/{repo.Name}' with your current file extension settings. The badge will clear automatically when complete.",
                    Duration = 6000
                });
                Logger.LogInformation("Re-analysis queued for repository {RepositoryId}", repo.Id);

                // Keep the "Re-analyzing" badge alive — poll until LastAnalyzedCommitDate changes
                _ = PollForReanalysisCompletionAsync(repo.Id, priorDate);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to start re-analysis: {response.StatusCode}",
                    Duration = 6000
                });
                Logger.LogError("Failed to re-analyze repository {RepositoryId}. Status: {StatusCode}", repo.Id, response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error starting re-analysis: {ex.Message}",
                Duration = 6000
            });
            Logger.LogError(ex, "Error re-analyzing repository {RepositoryId}", repo.Id);
        }
        finally
        {
            // Only clear the badge immediately if the API call failed — on success polling handles cleanup
            if (!successfullyQueued)
            {
                reanalyzingRepositoryId = null;
                _reanalysisStartTimes.Remove(repo.Id);
                StateHasChanged();
            }
        }
    }

    /// Starts a passive background poll when any repos have PENDING status (never analyzed).
    /// Only one passive poll runs at a time; it exits automatically when no PENDING repos remain.
    private bool _passivePollRunning = false;

    private void StartPassivePendingPollIfNeeded()
    {
        if (_passivePollRunning) return;
        if (!pageState.Repositories.Any(r => r.LastAnalyzedCommitDate == null)) return;
        _ = PollForPendingRepositoriesAsync();
    }

    private async Task PollForPendingRepositoriesAsync()
    {
        _passivePollRunning = true;
        using var cts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        cts.CancelAfter(TimeSpan.FromMinutes(60));

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        Logger.LogInformation("Passive PENDING poll started for {Count} repos", pageState.Repositories.Count(r => r.LastAnalyzedCommitDate == null));

        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                try
                {
                    var repos = await Http.GetFromJsonAsync<List<GitHubRepository>>("/api/repositories", cts.Token);
                    if (repos == null) continue;

                    // For any pending repo, try to fetch live progress
                    bool uiChanged = false;
                    foreach (var pending in pageState.Repositories.Where(r => r.LastAnalyzedCommitDate == null))
                    {
                        try
                        {
                            var prog = await Http.GetFromJsonAsync<AnalysisProgressDto>(
                                $"/api/repositories/{pending.Id}/analysis-progress", cts.Token);
                            if (prog != null && (prog.IsRunning || !string.IsNullOrEmpty(prog.ErrorMessage)))
                            {
                                _analysisProgress[pending.Id] = prog;
                                reanalyzingRepositoryId ??= pending.Id;
                                uiChanged = true;
                            }
                        }
                        catch { /* no active job yet — ignore */ }
                    }

                    bool anyChange = false;
                    foreach (var updated in repos.Where(r => r.LastAnalyzedCommitDate != null))
                    {
                        var idx = pageState.Repositories.FindIndex(r => r.Id == updated.Id && r.LastAnalyzedCommitDate == null);
                        if (idx >= 0)
                        {
                            pageState.Repositories[idx] = updated;
                            anyChange = true;
                            _analysisProgress.Remove(updated.Id);
                            if (reanalyzingRepositoryId == updated.Id) reanalyzingRepositoryId = null;
                            Logger.LogInformation("Passive poll: repo {Owner}/{Name} completed analysis", updated.Owner, updated.Name);
                        }
                    }

                    if (anyChange)
                    {
                        await LoadLatestLineCounts();
                        await InvokeAsync(StateHasChanged);
                        if (grid is not null) await InvokeAsync(grid.Reload);
                    }
                    else if (uiChanged)
                    {
                        await InvokeAsync(StateHasChanged);
                    }

                    // Stop when no more PENDING repos
                    if (!pageState.Repositories.Any(r => r.LastAnalyzedCommitDate == null))
                    {
                        Logger.LogInformation("Passive poll: all repos analyzed, stopping");
                        break;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Passive poll tick failed — will retry");
                }
            }
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Passive PENDING poll cancelled");
        }
        finally
        {
            _passivePollRunning = false;
        }
    }

    /// <summary>
    /// Polls /api/repositories every 5 seconds until the target repo's LastAnalyzedCommitDate
    /// changes (indicating the server-side analysis finished), then clears the "Re-analyzing" badge.
    /// Also polls /api/repositories/{id}/analysis-progress for live step details.
    /// Automatically stops after 30 minutes or when the component is disposed.
    /// </summary>
    private async Task PollForReanalysisCompletionAsync(Guid repositoryId, DateTime? priorDate)
    {
        using var cts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        cts.CancelAfter(TimeSpan.FromMinutes(30)); // hard stop — very large repos won't hang forever

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        Logger.LogInformation("Poll started for repository {RepositoryId}", repositoryId);

        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                try
                {
                    // Fetch progress details from the dedicated endpoint
                    try
                    {
                        var prog = await Http.GetFromJsonAsync<AnalysisProgressDto>(
                            $"/api/repositories/{repositoryId}/analysis-progress", cts.Token);
                        if (prog != null)
                        {
                            _analysisProgress[repositoryId] = prog;
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    catch (Exception progEx)
                    {
                        Logger.LogDebug(progEx, "Progress poll fetch failed for {RepositoryId} — ignoring", repositoryId);
                    }

                    var repos = await Http.GetFromJsonAsync<List<GitHubRepository>>("/api/repositories", cts.Token);
                    var updated = repos?.FirstOrDefault(r => r.Id == repositoryId);

                    if (updated?.LastAnalyzedCommitDate != null && updated.LastAnalyzedCommitDate != priorDate)
                    {
                        Logger.LogInformation("Re-analysis complete for repository {RepositoryId}", repositoryId);

                        var idx = pageState.Repositories.FindIndex(r => r.Id == repositoryId);
                        if (idx >= 0) pageState.Repositories[idx] = updated;

                        reanalyzingRepositoryId = null;
                        _reanalysisStartTimes.Remove(repositoryId);
                        _analysisProgress.Remove(repositoryId);
                        await LoadLatestLineCounts();

                        NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Success,
                            Summary = "Analysis Complete",
                            Detail = $"'{updated.Owner}/{updated.Name}' has been fully re-analyzed.",
                            Duration = 5000
                        });

                        await InvokeAsync(StateHasChanged);
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Poll tick failed for repository {RepositoryId} — will retry", repositoryId);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Either component disposed or 30-min safety timeout
            Logger.LogInformation("Polling cancelled for repository {RepositoryId}", repositoryId);
        }

        // Safety: ensure badge always clears, even on timeout
        reanalyzingRepositoryId = null;
        _reanalysisStartTimes.Remove(repositoryId);
        _analysisProgress.Remove(repositoryId);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await _disposeCts.CancelAsync();
        _disposeCts.Dispose();
    }

    private sealed record RepositoryGridRow(GitHubRepository Repository, int? TotalLinesSortValue)
    {
        public Guid Id => Repository.Id;
        public string Owner => Repository.Owner;
        public string Name => Repository.Name;
        public DateTime? LastAnalyzedCommitDate => Repository.LastAnalyzedCommitDate;
    }

    private async Task DeleteRepository(Guid repositoryId)
    {
        try
        {
            Logger.LogInformation("Deleting repository {RepositoryId}", repositoryId);
            var response = await Http.DeleteAsync($"/api/repositories/{repositoryId}");

            if (response.IsSuccessStatusCode)
            {
                var repoToRemove = pageState.Repositories.FirstOrDefault(r => r.Id == repositoryId);
                if (repoToRemove != null)
                {
                    pageState.Repositories.Remove(repoToRemove);
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Deleted",
                        Detail = $"Repository '{repoToRemove.Owner}/{repoToRemove.Name}' deleted successfully!",
                        Duration = 4000
                    });
                }

                if (grid is not null)
                    await grid.Reload();
                Logger.LogInformation("Repository {RepositoryId} deleted successfully", repositoryId);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to delete repository: {response.StatusCode}",
                    Duration = 6000
                });
                Logger.LogError("Failed to delete repository {RepositoryId}. Status: {StatusCode}", repositoryId, response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error deleting repository: {ex.Message}",
                Duration = 6000
            });
            Logger.LogError(ex, "Error deleting repository {RepositoryId}: {Message}", repositoryId, ex.Message);
        }
    }

    private async Task ConfirmRemoveAll()
    {
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to remove ALL repositories? This action cannot be undone.",
            "Remove All Repositories",
            new ConfirmOptions { OkButtonText = "Remove All", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await RemoveAllRepositories();
        }
    }

    private async Task RemoveAllRepositories()
    {
        try
        {
            isRemovingAll = true;
            Logger.LogInformation("Starting removal of all repositories via API endpoint.");
            
            var response = await Http.DeleteAsync("/api/repositories/all");
            
            if (response.IsSuccessStatusCode)
            {
                pageState.Repositories.Clear();

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = "All repositories and data have been successfully removed!",
                    Duration = 4000
                });
                Logger.LogInformation("All repositories removed successfully.");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Error removing repositories: {response.StatusCode}",
                    Duration = 6000
                });
                Logger.LogError("Failed to remove all repositories. Status: {StatusCode}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Error removing all repositories: {ex.Message}",
                Duration = 6000
            });
            Logger.LogError(ex, "Error removing all repositories: {Message}", ex.Message);
        }
        finally
        {
            isRemovingAll = false;
        }
    }
