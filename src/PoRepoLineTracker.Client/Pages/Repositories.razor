    private async Task LoadLatestLineCounts()
    {
        try
        {
            var all = await Http.GetAppJsonAsync("/api/repositories/allcharts/365", AppJsonSerializerContext.Default.ListRepositoryLineCountHistoryDto);
            if (all != null)
            {
                _repoLatestLineCounts = all
                    .Where(r => r.DailyLineCounts.Any())
                    .ToDictionary(
                        r => r.RepositoryId,
                        r => r.DailyLineCounts.OrderByDescending(d => d.Date).First().TotalLines);
                _repoTrends = all
                    .Where(r => r.DailyLineCounts.Any())
                    .ToDictionary(
                        r => r.RepositoryId,
                        r => (IReadOnlyList<DailyLineCountDto>)r.DailyLineCounts
                            .OrderBy(d => d.Date)
                            .TakeLast(45)
                            .ToList());

                Logger.LogInformation("Loaded latest line counts for {Count} repositories", _repoLatestLineCounts.Count);

                // Sum every repo's per-day total into one portfolio series for the sparkline.
                TotalLinesTrend = all
                    .SelectMany(r => r.DailyLineCounts)
                    .GroupBy(d => d.Date.Date)
                    .OrderBy(g => g.Key)
                    .Select(g => new DailyLineCountDto { Date = g.Key, TotalLines = g.Sum(d => d.TotalLines) })
                    .TakeLast(60)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load latest line counts — Total Lines column will show dashes");
        }
    }

