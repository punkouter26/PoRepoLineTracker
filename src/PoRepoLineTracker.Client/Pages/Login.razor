@page "/login"
@layout PoRepoLineTracker.Client.Layout.LoginLayout
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject GfxService Gfx
@inject IJSRuntime JSRuntime
@using Microsoft.JSInterop
@using PoRepoLineTracker.Client.Services
@using Radzen
@using Radzen.Blazor

<div class="login-canvas" data-gfx="@_gfxMode">
    @* WebGL mesh backdrop. Falls back through a 2D canvas to the three CSS blobs below, which
       stay in the markup and are hidden by CSS only once `data-gfx="webgl"` is set — so a failed
       shader compile, a blocked context, or prefers-reduced-motion all leave a working backdrop.

       No inline style anywhere on this element: gfx.js sets the width/height ATTRIBUTES (the
       drawing buffer) and never `canvas.style`, because ScopedCssUiTests asserts that nothing
       inside .login-canvas carries one. *@
    <canvas @ref="_backdrop" class="gfx-backdrop" aria-hidden="true"></canvas>

    <!-- Animated mesh gradient blobs — the no-WebGL fallback -->
    <div class="login-blob login-blob-1" aria-hidden="true"></div>
    <div class="login-blob login-blob-2" aria-hidden="true"></div>
    <div class="login-blob login-blob-3" aria-hidden="true"></div>

    <RadzenCard class="login-card">
        <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">
            <!-- Logomark -->
            <div class="login-logomark" aria-hidden="true">
                <span class="login-logomark-icon">
                    <RadzenIcon Icon="code" class="login-logomark-icon__glyph" />
                </span>
                <span class="login-logomark-badge">
                    <RadzenIcon Icon="trending_up" class="login-logomark-badge__glyph" />
                </span>
            </div>

            <RadzenStack Gap="0.35rem" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H4" class="login-wordmark">PoRepoLineTracker</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="login-tagline">
                    Track lines of code across all your GitHub repositories
                </RadzenText>
            </RadzenStack>

            <hr class="login-divider" />

            @* GitHub is the only provider. The Microsoft button that used to sit below this one
               is gone along with its server-side handler — a Microsoft principal carries no
               GitHub credential, so it could sign in but not read a single repository. See
               AuthServiceExtensions for the full rationale. *@
            <RadzenButton Text="Sign in with GitHub"
                          Icon="login"
                          aria-label="Sign in with GitHub"
                          ButtonStyle="ButtonStyle.Primary"
                          class="login-cta-btn"
                          Click="@(() => Navigation.NavigateTo("auth/login", forceLoad: true))" />

            <RadzenText TextStyle="TextStyle.Caption" class="login-footnote">
                Your data stays in your own Azure Table Storage
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
</div>

@code {
    private ElementReference _backdrop;

    /// <summary>
    /// Drives the `data-gfx` attribute the CSS keys off to hide the fallback blobs. Left as
    /// "css" unless a canvas renderer actually took over, so a failure never hides the fallback.
    /// </summary>
    private string _gfxMode = "css";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The shader palette has to match the painted theme, and the boot script in index.html is
        // the only thing that knows it (saved choice, else the OS preference). Reading the raw
        // localStorage key would give the wrong answer for a user who has never chosen.
        var theme = await JSRuntime.InvokeAsync<string>("getEffectiveTheme");

        if (await Gfx.StartBackdropAsync(_backdrop, theme))
        {
            _gfxMode = "webgl";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Stops the render loop and releases the GL context. Without this the loop keeps drawing into
    /// a detached canvas after sign-in navigates away, and the context stays live against the
    /// browser's per-page cap.
    /// </summary>
    public async ValueTask DisposeAsync() => await Gfx.StopAsync(_backdrop);
}
