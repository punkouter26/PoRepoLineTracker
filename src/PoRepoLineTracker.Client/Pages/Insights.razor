@page "/insights"
@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<Insights> Logger
@inject NavigationManager Navigation
@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

@* Portfolio dashboard. Everything here is one GET of /api/insights/portfolio — the aggregation
   runs where the commit data already lives rather than shipping it to the browser to be reduced
   (see PortfolioInsightsDto for the reasoning). *@

@* A plain <div>, not <RadzenStack Gap="1rem">. Two reasons, both concrete:

   1. Scope anchor. <RadzenStack> is a component, so nothing it renders carries this file's scope
      id — which meant `::deep` had no plain ancestor to hang off anywhere on the page, and the
      rules that needed it (`.ins-kpi`, `.ins-empty-icon`) silently matched nothing.
   2. Rhythm. The stack hardcoded a 1rem gap at every viewport, next to a `--space-*` scale that
      exists precisely so vertical rhythm tracks the width. `.app-stack` uses the token. *@
<div class="app-stack">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.125rem">
                <RadzenText TextStyle="TextStyle.H3" class="ins-title">Insights</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="ins-lede">
                    @if (_isLoading)
                    {
                        <span>Crunching your portfolio…</span>
                    }
                    else if (_insights is not null)
                    {
                        <span>@_insights.AnalyzedCount of @_insights.RepositoryCount repositories analyzed</span>
                    }
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined" Size="ButtonSize.Small"
                          Click="@LoadAsync" Disabled="@_isLoading" />
        </Actions>
    </PageHero>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true" Close="@(() => _error = string.Empty)">
            @_error
        </RadzenAlert>
    }

    @if (_isLoading)
    {
        <div class="app-dashboard app-dashboard--tiles">
            @for (var i = 0; i < 4; i++)
            {
                <RadzenCard><RadzenSkeleton Width="100%" Height="72px" /></RadzenCard>
            }
        </div>
        <RadzenCard><RadzenSkeleton Width="100%" Height="220px" /></RadzenCard>
    }
    else if (_insights is null || _insights.RepositoryCount == 0)
    {
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-p-8">
                <RadzenIcon Icon="insights" class="ins-empty-icon" />
                <RadzenText TextStyle="TextStyle.H6">Nothing to summarise yet</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="ins-muted">
                    Add and analyze a repository and this page fills in.
                </RadzenText>
                <RadzenButton Text="Go to Repositories" Icon="storage" Click="@(() => Navigation.NavigateTo("/"))" />
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        @* ─── KPI row ─────────────────────────────────────────────────────────────
           Four figures, each with the context that makes it mean something: a total beside its
           own change, a count beside how many days it was spread over. A bare number here would
           be no more useful than the one already on the Repositories page. *@
        <div class="app-dashboard app-dashboard--tiles">
            <RadzenCard class="ins-kpi">
                <RadzenText TextStyle="TextStyle.Caption" class="ins-kpi__label">Total lines</RadzenText>
                <div class="ins-kpi__value">@_insights.TotalLines.ToString("N0")</div>
                <div class="ins-kpi__delta @DeltaClass(_insights.NetLines30Days)">
                    @DeltaText(_insights.NetLines30Days) in 30d
                    <span class="ins-kpi__sub">· @DeltaText(_insights.NetLines7Days) in 7d</span>
                </div>
            </RadzenCard>

            <RadzenCard class="ins-kpi">
                <RadzenText TextStyle="TextStyle.Caption" class="ins-kpi__label">Commits (30d)</RadzenText>
                <div class="ins-kpi__value">@_insights.Commits30Days.ToString("N0")</div>
                <div class="ins-kpi__delta">
                    across @_insights.ActiveDays30 active @(_insights.ActiveDays30 == 1 ? "day" : "days")
                </div>
            </RadzenCard>

            <RadzenCard class="ins-kpi">
                <RadzenText TextStyle="TextStyle.Caption" class="ins-kpi__label">AI-assisted (30d)</RadzenText>
                <div class="ins-kpi__value">@_insights.AiPercentage30Days.ToString("F1")%</div>
                <div class="ins-kpi__delta">
                    of @_insights.LinesAdded30Days.ToString("N0") lines added
                </div>
            </RadzenCard>

            <RadzenCard class="ins-kpi">
                <RadzenText TextStyle="TextStyle.Caption" class="ins-kpi__label">@(StreakHeading)</RadzenText>
                @{ var streak = Streak; }
                <div class="ins-kpi__value">
                    @streak.Value@if (streak.Unit is not null)
                    {
                        <span class="ins-kpi__unit">@streak.Unit</span>
                    }
                </div>
                <div class="ins-kpi__delta">best @_insights.LongestStreakDays d this year</div>
            </RadzenCard>
        </div>

        @* ─── Activity heatmap ────────────────────────────────────────────────────
           A year of commit activity at a glance. Rendered as a plain CSS grid rather than a
           Radzen chart: 365 cells with no axes is a calendar, and every charting primitive that
           could draw it would first have to be told not to behave like a chart. *@
        @* Through <ChartCard> as well — the heading/caption pair and the surface were a third copy,
           and the intensity key is exactly what its <Toolbar> slot is for. *@
        <ChartCard Title="Activity"
                   Description="Commits per day across every tracked repository, last 12 months"
                   IsEmpty="@(_insights.Activity.Count == 0)"
                   EmptyIcon="calendar_month"
                   EmptyText="No commit activity recorded yet.">
            <Toolbar>
                <div class="ins-heat__legend">
                    <span class="ins-muted">Less</span>
                    <span class="ins-heat__cell ins-heat--0"></span>
                    <span class="ins-heat__cell ins-heat--1"></span>
                    <span class="ins-heat__cell ins-heat--2"></span>
                    <span class="ins-heat__cell ins-heat--3"></span>
                    <span class="ins-heat__cell ins-heat--4"></span>
                    <span class="ins-muted">More</span>
                </div>
            </Toolbar>
            <ChildContent>
                <div class="u-scroll-x ins-heat__scroll">
                    <div class="ins-heat" role="img" aria-label="@HeatmapSummary">
                        @* Leading blanks so the first real cell lands on its own weekday row and every
                           column below is a genuine Sunday-to-Saturday week. *@
                        @for (var i = 0; i < LeadingBlanks; i++)
                        {
                            <span class="ins-heat__cell ins-heat--blank"></span>
                        }
                        @foreach (var day in _insights.Activity)
                        {
                            <span class="ins-heat__cell @IntensityClass(day.Commits)"
                                  title="@($"{day.Date:MMM d, yyyy} — {day.Commits} commit{(day.Commits == 1 ? "" : "s")}, +{day.LinesAdded:N0} lines")"></span>
                        }
                    </div>
                </div>
            </ChildContent>
        </ChartCard>

        @* Both panels render through <ChartCard> now. They were a fourth and fifth hand-rolled
           copy of the chrome it owns — surface, H6 title, caption, and an inline "nothing here
           yet" line — each with its own `.ins-card*` rules and its own empty-state wording style.
           The wrapper <div>s are gone with them: an auto-height box between the grid and the card
           is what stopped ChartCard's `height: 100%` resolving, so the two cards never actually
           bottom-aligned. *@
        <div class="app-dashboard">
            @* ─── Movers ──────────────────────────────────────────────────────────
               Gainers and losers from the same ranked list, taken from each end. Shrinkage is
               worth surfacing rather than filtering out: a repo that lost 4,000 lines is usually
               the most interesting thing that happened all month. *@
            <ChartCard Title="Movers (30 days)"
                       Description="Largest net change in lines, either direction"
                       IsEmpty="@(Movers.Count == 0)"
                       EmptyIcon="trending_flat"
                       EmptyText="No commits in the last 30 days."
                       EmptyHint="Analyze a repository, or commit something.">
                <div class="ins-movers">
                    @foreach (var mover in Movers)
                    {
                        <button type="button" class="ins-mover"
                                @onclick="@(() => Navigation.NavigateTo($"/repositories/{mover.RepositoryId}"))">
                            <span class="ins-mover__name" title="@($"{mover.Owner}/{mover.Name}")">
                                @mover.Owner/@mover.Name
                            </span>
                            <span class="ins-mover__meta">
                                @mover.Commits30Days commits · @mover.TotalLines.ToString("N0") lines
                            </span>
                            <span class="ins-mover__delta @DeltaClass(mover.NetChange30Days)">
                                @DeltaText(mover.NetChange30Days)
                            </span>
                        </button>
                    }
                </div>
            </ChartCard>

            @* ─── Language mix ────────────────────────────────────────────────────
               Portfolio-wide, from each repository's most recent snapshot. The per-repo version of
               this already existed on the detail page; the aggregate did not. *@
            <ChartCard Title="Language mix"
                       Description="Share of current lines by file type"
                       IsEmpty="@(_insights.LanguageMix.Count == 0)"
                       EmptyIcon="donut_large"
                       EmptyText="No per-extension data yet."
                       EmptyHint="Re-analyze a repository to populate it.">
                <RadzenChart>
                    <RadzenDonutSeries Data="@_insights.LanguageMix"
                                       CategoryProperty="Extension"
                                       ValueProperty="Percentage"
                                       Title="Share of lines">
                        <RadzenSeriesDataLabels Visible="false" />
                    </RadzenDonutSeries>
                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>

                <div class="ins-langs">
                    @foreach (var language in _insights.LanguageMix)
                    {
                        <div class="ins-lang">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                         AlignItems="AlignItems.Center" Gap="0.5rem">
                                <code class="ins-lang__code">@language.Extension</code>
                                <RadzenText TextStyle="TextStyle.Caption" class="ins-muted">
                                    @language.Lines.ToString("N0") · @language.Percentage.ToString("F1")%
                                </RadzenText>
                            </RadzenStack>
                            <progress class="ins-lang__bar" max="100"
                                      value="@Math.Min(language.Percentage, 100)"
                                      aria-label="@($"{language.Extension}: {language.Percentage:F1}% of lines")"></progress>
                        </div>
                    }
                </div>
            </ChartCard>
        </div>
    }
</div>

@code {
    private PortfolioInsightsDto? _insights;
    private bool _isLoading = true;
    private string _error = string.Empty;

    /// <summary>Gainers off the front of the ranked list, losers off the back, no repo counted twice.</summary>
    private List<RepositoryMovementDto> Movers
    {
        get
        {
            var ranked = (_insights?.Movers ?? []).Where(m => m.Commits30Days > 0).ToList();
            if (ranked.Count <= 6) return ranked;

            return ranked.Take(4).Concat(ranked.TakeLast(2)).ToList();
        }
    }

    /// <summary>
    /// Blank cells before the first day so each grid column is one calendar week.
    /// <see cref="DayOfWeek.Sunday"/> is 0, which is exactly the offset needed.
    /// </summary>
    private int LeadingBlanks =>
        _insights?.Activity.Count > 0 ? (int)_insights.Activity[0].Date.DayOfWeek : 0;

    private string HeatmapSummary =>
        _insights is null
            ? "Commit activity heatmap"
            : $"Commit activity heatmap: {_insights.Activity.Count(d => d.Commits > 0)} active days in the last year, " +
              $"{_insights.Activity.Sum(d => d.Commits):N0} commits total";

    /// <summary>
    /// "Current streak: 0d" is technically accurate but reads like a feature is broken. When the
    /// streak is zero, the tile rephrases as "last active Nd ago" using the most recent
    /// non-zero-commit day from <see cref="PortfolioInsightsDto.Activity"/>. The "best … this
    /// year" line underneath keeps the same anchor in both states so the tile reads as one tile.
    /// </summary>
    private string StreakHeading =>
        _insights is null || _insights.CurrentStreakDays > 0
            ? "Current streak"
            : "Last active";

    /// <summary>
    /// Figure and its unit as separate strings, rendered as separate nodes by the template. An
    /// earlier version returned one string with the <c>&lt;span&gt;</c> baked in, which Razor
    /// HTML-encodes — the tile printed the markup as visible text.
    /// </summary>
    private (string Value, string? Unit) Streak
    {
        get
        {
            if (_insights is null) return ("—", null);
            if (_insights.CurrentStreakDays > 0) return ($"{_insights.CurrentStreakDays}", "d");

            var last = _insights.Activity.LastOrDefault(d => d.Commits > 0);
            if (last is null) return ("—", null);

            var days = Math.Max(0, (int)(DateTime.UtcNow.Date - last.Date.Date).TotalDays);
            return days switch
            {
                0 => ("today", null),
                1 => ("yesterday", null),
                _ => ($"{days}", "d ago")
            };
        }
    }

    /// <summary>
    /// Fixed thresholds rather than quantiles of the user's own data. A relative scale would paint
    /// a quiet year the same shade as a busy one, and the point of the grid is to compare days
    /// against a constant.
    /// </summary>
    private static string IntensityClass(int commits) => commits switch
    {
        0 => "ins-heat--0",
        <= 2 => "ins-heat--1",
        <= 5 => "ins-heat--2",
        <= 10 => "ins-heat--3",
        _ => "ins-heat--4"
    };

    private static string DeltaText(int value) => value switch
    {
        > 0 => $"+{value:N0}",
        < 0 => value.ToString("N0"),
        _ => "no change"
    };

    private static string DeltaClass(int value) => value switch
    {
        > 0 => "ins-delta--pos",
        < 0 => "ins-delta--neg",
        _ => "ins-delta--flat"
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            _insights = await Http.GetAppJsonAsync(
                "/api/insights/portfolio",
                AppJsonSerializerContext.Default.PortfolioInsightsDto);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Insights: failed to load portfolio insights");
            _error = "Could not load your insights. Please try again.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
