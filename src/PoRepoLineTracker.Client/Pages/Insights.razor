@page "/insights"
@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<Insights> Logger
@inject NavigationManager Navigation
@using PoRepoLineTracker.Client.Components.Shared
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

@* Portfolio dashboard. Everything here is one GET of /api/insights/portfolio — the aggregation
   runs where the commit data already lives rather than shipping it to the browser to be reduced
   (see PortfolioInsightsDto for the reasoning). *@

@* A plain <div>, not <RadzenStack Gap="1rem">. Two reasons, both concrete:

   1. Scope anchor. <RadzenStack> is a component, so nothing it renders carries this file's scope
      id — which meant `::deep` had no plain ancestor to hang off anywhere on the page, and the
      rules that needed it (`.ins-kpi`, `.ins-empty-icon`) silently matched nothing.
   2. Rhythm. The stack hardcoded a 1rem gap at every viewport, next to a `--space-*` scale that
      exists precisely so vertical rhythm tracks the width. `.app-stack` uses the token. *@
<PageTitle>Global Insights · PoRepoLineTracker</PageTitle>

<div class="app-stack">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.125rem">
                <h1 class="page-hero__title ins-title">Global Insights</h1>
                <RadzenText TextStyle="TextStyle.Body1" class="ins-lede">
                    @if (_state.IsLoading)
                    {
                        <span>Crunching your portfolio…</span>
                    }
                    else if (_state.HasData)
                    {
                        var data = _state.Data!;
                        <span>Your tracked repositories · @data.AnalyzedCount of @data.RepositoryCount analyzed</span>
                        @if (data.RepositoryCount > data.AnalyzedCount)
                        {
                            @* Analysis runs one repository at a time in the background, so the first
                               visit after adding a repository legitimately shows more tracked than analyzed. *@
                            <span> · @(data.RepositoryCount - data.AnalyzedCount) still being analyzed — Refresh in a minute</span>
                        }
                    }
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined" Size="ButtonSize.Small"
                          Click="@LoadAsync" Disabled="@_state.IsLoading" />
        </Actions>
    </PageHero>

    @* LoadingState<T> replaces the three-field ladder (_isLoading, _error, _insights). The four
       states (loading / failed / empty / loaded) cannot co-exist on the same render — fixing
       two bugs at once: an error banner that survived a successful reload, and a 0-repo page
       that still showed the KPI tiles. *@
    @switch (_state)
    {
        case LoadingState<PortfolioInsightsDto>.Loading:
            <div class="app-dashboard app-dashboard--tiles">
                @for (var i = 0; i < 3; i++)
                {
                    <RadzenCard><RadzenSkeleton Width="100%" Height="72px" /></RadzenCard>
                }
            </div>
            <RadzenCard><RadzenSkeleton Width="100%" Height="220px" /></RadzenCard>
            break;

        case LoadingState<PortfolioInsightsDto>.Failed f:
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true"
                         Close="@(() => _state = new LoadingState<PortfolioInsightsDto>.Loading())">
                @f.Message
            </RadzenAlert>
            break;

        case LoadingState<PortfolioInsightsDto>.Empty:
            <EmptyState Kind="EmptyStateKind.NoInsights"
                        Title="Nothing to summarise yet"
                        Description="Add and analyze a repository and this page fills in.">
                <Actions>
                    <RadzenButton Text="Go to Repositories" Icon="storage"
                                  Click="@(() => Navigation.NavigateTo("/"))" />
                </Actions>
            </EmptyState>
            break;

        case LoadingState<PortfolioInsightsDto>.Loaded loaded:
            @RenderLoaded(loaded.Value!)
            break;
    }
</div>

@* Body of the populated dashboard — extracted as a local function so the switch reads as a flat
   list of states rather than a deeply nested tree. *@
@code {
    private RenderFragment RenderLoaded(PortfolioInsightsDto data) =>
        @<text>
            @* ─── KPI row ─────────────────────────────────────────────────────────────
               Four figures, each with the context that makes it mean something: a total beside
               its own change, a count beside how many days it was spread over. A bare number here
               would be no more useful than the one already on the Repositories page. *@
            <div class="app-dashboard app-dashboard--tiles">
                <KpiTile Label="Total lines"
                         Delta="@($"{DeltaText(data.NetLines30Days)} in 30d")"
                         Sub="@($"{DeltaText(data.NetLines7Days)} in 7d")"
                         DeltaClass="@DeltaClass(data.NetLines30Days)">
                    @data.TotalLines.ToString("N0")
                </KpiTile>

                <KpiTile Label="Commits (30d)"
                         Delta="@($"across {data.ActiveDays30} active {(data.ActiveDays30 == 1 ? "day" : "days")}")">
                    @data.Commits30Days.ToString("N0")
                </KpiTile>

                @{ var streak = Streak; }
                <KpiTile Label="@StreakHeading"
                         Unit="@streak.Unit"
                         Delta="@($"best {data.LongestStreakDays} d this year")">
                    @streak.Value
                </KpiTile>
            </div>

        @* ─── Activity heatmap ────────────────────────────────────────────────────
           A year of commit activity at a glance. Rendered as a plain CSS grid rather than a
           Radzen chart: 365 cells with no axes is a calendar, and every charting primitive that
           could draw it would first have to be told not to behave like a chart. *@
        @* Through <ChartCard> as well — the heading/caption pair and the surface were a third copy,
           and the intensity key is exactly what its <Toolbar> slot is for. *@
        <ChartCard Title="Activity"
                   Description="@($"Commits per day across every tracked repository, last {(_heatmapDays >= 365 ? "12 months" : $"{_heatmapDays} days")}")"
                   IsEmpty="@(data.Activity.Count == 0)"
                   EmptyIcon="calendar_month"
                   EmptyText="No commit activity recorded yet.">
            <Toolbar>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <RadzenSelectBar @bind-Value="_heatmapDays" TValue="int" Size="ButtonSize.ExtraSmall" class="ins-zoom-bar">
                        <Items>
                            <RadzenSelectBarItem Value="30" Text="30d" />
                            <RadzenSelectBarItem Value="90" Text="90d" />
                            <RadzenSelectBarItem Value="365" Text="1y" />
                        </Items>
                    </RadzenSelectBar>

                    <div class="ins-heat__legend">
                        <span class="ins-muted">Less</span>
                        <span class="ins-heat__cell ins-heat--0"></span>
                        <span class="ins-heat__cell ins-heat--1"></span>
                        <span class="ins-heat__cell ins-heat--2"></span>
                        <span class="ins-heat__cell ins-heat--3"></span>
                        <span class="ins-heat__cell ins-heat--4"></span>
                        <span class="ins-muted">More</span>
                    </div>
                </RadzenStack>
            </Toolbar>
            <ChildContent>
                <div class="u-scroll-x ins-heat__scroll">
                    <div class="ins-heat" role="img" aria-label="@HeatmapSummary">
                        @* Leading blanks so the first real cell lands on its own weekday row and every
                           column below is a genuine Sunday-to-Saturday week. *@
                        @for (var i = 0; i < LeadingBlanks; i++)
                        {
                            <span class="ins-heat__cell ins-heat--blank"></span>
                        }
                        @foreach (var day in DisplayedActivity)
                        {
                            <span class="ins-heat__cell @IntensityClass(day.Commits)"
                                  title="@($"{day.Date:MMM d, yyyy} — {day.Commits} commit{(day.Commits == 1 ? "" : "s")}, +{day.LinesAdded:N0} lines")"></span>
                        }
                    </div>
                </div>
            </ChildContent>
        </ChartCard>

        @* ─── Portfolio growth & All repositories ────────────────────────────── *@
        <div class="app-dashboard app-dashboard--panels">
            <ChartCard Title="Portfolio growth"
                       Description="Total lines across every repository, sampled monthly over the last year"
                       IsEmpty="@(data.TrendLine.Count == 0)"
                       EmptyIcon="show_chart"
                       EmptyText="No history to chart yet.">
                <RadzenChart>
                    <RadzenAreaSeries Data="@data.TrendLine"
                                      CategoryProperty="Date"
                                      ValueProperty="TotalLines"
                                      Title="Total lines"
                                      Stroke="var(--rz-primary)"
                                      Fill="color-mix(in srgb, var(--primary-color) 14%, transparent)"
                                      StrokeWidth="3">
                        <RadzenMarkers MarkerType="MarkerType.Circle" />
                    </RadzenAreaSeries>

                    @* Whole-day Step: see ChartFormat.DateAxisStep. *@
                    <RadzenCategoryAxis FormatString="{0:MMM yyyy}"
                                        Step="@ChartFormat.DateAxisStep(data.TrendLine.Select(p => p.Date))"
                                        LabelAutoRotation="-45">
                        <RadzenGridLines Visible="true" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines">
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                    <RadzenLegend Visible="false" />
                </RadzenChart>
            </ChartCard>

            <ChartCard Title="All repositories"
                       Description="Every tracked repository — click a header to sort, a row to open it"
                       IsEmpty="@(data.Movers.Count == 0)"
                       EmptyIcon="storage"
                       EmptyText="No repositories analyzed yet.">
                <div class="u-scroll-x">
                    <RadzenDataGrid Data="@data.Movers"
                                    TItem="RepositoryMovementDto"
                                    AllowSorting="true"
                                    Responsive="true"
                                    RowRender="@OnRepoRowRender"
                                    RowClick="@OnRepoRowClick"
                                    Density="Density.Default"
                                    class="ins-repo-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="RepositoryMovementDto" Property="Name" Title="Repository" MinWidth="160px" Width="200px">
                                <Template Context="row">
                                    <span title="@($"{row.Owner}/{row.Name}")">@row.Owner/@row.Name</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="RepositoryMovementDto" Property="TotalLines" Title="Total Lines" Width="110px" TextAlign="TextAlign.Right" Sortable="true">
                                <Template Context="row">@row.TotalLines.ToString("N0")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="RepositoryMovementDto" Property="NetChange30Days" Title="Net (30d)" Width="100px" TextAlign="TextAlign.Right" Sortable="true">
                                <Template Context="row">
                                    <span class="@DeltaClass(row.NetChange30Days)">@DeltaText(row.NetChange30Days)</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="RepositoryMovementDto" Property="Commits30Days" Title="Commits (30d)" Width="110px" TextAlign="TextAlign.Right" Sortable="true" />
                            <RadzenDataGridColumn TItem="RepositoryMovementDto" Title="Cadence (12w)" Width="140px" Sortable="false" Filterable="false">
                                <Template Context="row">
                                    <div class="ins-spark" role="img" aria-label="@SparklineSummary(row)" title="@SparklineSummary(row)">
                                        @{ var max = Math.Max(1, row.WeeklyCommits.DefaultIfEmpty(0).Max()); }
                                        @foreach (var week in row.WeeklyCommits)
                                        {
                                            <span class="ins-spark__bar" style="@($"height:{Math.Max(6, week * 100 / max)}%")"></span>
                                        }
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </ChartCard>
        </div>

        @* ─── Language mix & Language drift ──────────────────────────────────── *@
        <div class="app-dashboard app-dashboard--panels">
            <ChartCard Title="Language mix"
                       Description="Share of current lines by file type"
                       IsEmpty="@(data.LanguageMix.Count == 0)"
                       EmptyIcon="donut_large"
                       EmptyText="No per-extension data yet."
                       EmptyHint="Re-analyze a repository to populate it.">
                <RadzenChart>
                    <RadzenDonutSeries Data="@data.LanguageMix"
                                       CategoryProperty="Extension"
                                       ValueProperty="Percentage"
                                       Title="Share of lines">
                        <RadzenSeriesDataLabels Visible="false" />
                    </RadzenDonutSeries>
                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>

                <div class="ins-langs">
                    @foreach (var language in data.LanguageMix)
                    {
                        <div class="ins-lang">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                         AlignItems="AlignItems.Center" Gap="0.5rem">
                                <code class="ins-lang__code">@language.Extension</code>
                                <RadzenText TextStyle="TextStyle.Caption" class="ins-muted">
                                    @language.Lines.ToString("N0") · @language.Percentage.ToString("F1")%
                                </RadzenText>
                            </RadzenStack>
                            <progress class="ins-lang__bar" max="100"
                                      value="@Math.Min(language.Percentage, 100)"
                                      aria-label="@($"{language.Extension}: {language.Percentage:F1}% of lines")"></progress>
                        </div>
                    }
                </div>
            </ChartCard>

            <ChartCard Title="Language drift"
                       Description="How the mix moved over the last year, in share"
                       IsEmpty="@(data.LanguageDrift.Count == 0)"
                       EmptyIcon="swap_vert"
                       EmptyText="No drift to report yet."
                       EmptyHint="Needs a year of history across at least two file types.">
                @if (data.RisingLanguage is not null || data.FadingLanguage is not null)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="ins-drift__lede">
                        @if (data.RisingLanguage is not null)
                        {
                            <text>You drifted toward <code class="ins-lang__code">@data.RisingLanguage</code></text>
                        }
                        @if (data.RisingLanguage is not null && data.FadingLanguage is not null)
                        {
                            <text> and away from </text>
                        }
                        @if (data.FadingLanguage is not null)
                        {
                            <text><code class="ins-lang__code">@data.FadingLanguage</code></text>
                        }
                        .
                    </RadzenText>
                }

                <div class="ins-drift">
                    @foreach (var drift in data.LanguageDrift)
                    {
                        <div class="ins-drift__row">
                            <code class="ins-lang__code">@drift.Extension</code>
                            <span class="ins-drift__span">
                                @drift.StartPercent.ToString("F1")% → @drift.EndPercent.ToString("F1")%
                            </span>
                            <span class="@(drift.PercentDelta > 0 ? "ins-drift__delta ins-drift__delta--up" : "ins-drift__delta ins-drift__delta--down")">
                                @(drift.PercentDelta > 0 ? "+" : "")@drift.PercentDelta.ToString("F1") pts
                            </span>
                        </div>
                    }
                </div>
            </ChartCard>
        </div>
        </text>;
}

@code {
    private LoadingState<PortfolioInsightsDto> _state = new LoadingState<PortfolioInsightsDto>.Loading();
    private int _heatmapDays = 90;

    private void OnRepoRowClick(DataGridRowMouseEventArgs<RepositoryMovementDto> args) =>
        Navigation.NavigateTo($"/repositories/{args.Data.RepositoryId}");

    /// <summary>Mirrors the Repositories grid: keyboard-reachable, Enter/Space-activatable rows.</summary>
    private static void OnRepoRowRender(RowRenderEventArgs<RepositoryMovementDto> args)
    {
        args.Attributes["style"] = "cursor: pointer;";
        args.Attributes["tabindex"] = "0";
        args.Attributes["role"] = "button";
        args.Attributes["aria-label"] = $"Open repository {args.Data.Owner}/{args.Data.Name}";
        args.Attributes["onkeydown"] = "if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}";
    }

    private static string SparklineSummary(RepositoryMovementDto row) =>
        $"Commits per week, last 12 weeks: {string.Join(", ", row.WeeklyCommits)}";

    private IReadOnlyList<ActivityDayDto> DisplayedActivity
    {
        get
        {
            var activity = _state.HasData ? _state.Data!.Activity : [];
            return _heatmapDays >= 365 ? activity : activity.TakeLast(_heatmapDays).ToList();
        }
    }

    /// <summary>
    /// Blank cells before the first day so each grid column is one calendar week.
    /// <see cref="DayOfWeek.Sunday"/> is 0, which is exactly the offset needed.
    /// </summary>
    private int LeadingBlanks =>
        DisplayedActivity.Count > 0 ? (int)DisplayedActivity[0].Date.DayOfWeek : 0;

    private string HeatmapSummary =>
        !_state.HasData
            ? "Commit activity heatmap"
            : $"Commit activity heatmap: {_state.Data!.Activity.Count(d => d.Commits > 0)} active days in the last year, " +
              $"{_state.Data!.Activity.Sum(d => d.Commits):N0} commits total";

    /// <summary>
    /// "Current streak: 0d" is technically accurate but reads like a feature is broken. When the
    /// streak is zero, the tile rephrases as "last active Nd ago" using the most recent
    /// non-zero-commit day from <see cref="PortfolioInsightsDto.Activity"/>. The "best … this
    /// year" line underneath keeps the same anchor in both states so the tile reads as one tile.
    /// </summary>
    private string StreakHeading =>
        !_state.HasData || _state.Data!.CurrentStreakDays > 0
            ? "Current streak"
            : "Last active";

    /// <summary>
    /// Figure and its unit as separate strings, rendered as separate nodes by the template. An
    /// earlier version returned one string with the <c>&lt;span&gt;</c> baked in, which Razor
    /// HTML-encodes — the tile printed the markup as visible text.
    /// </summary>
    private (string Value, string? Unit) Streak
    {
        get
        {
            if (!_state.HasData) return ("—", null);
            var data = _state.Data!;
            if (data.CurrentStreakDays > 0) return ($"{data.CurrentStreakDays}", "d");

            var last = data.Activity.LastOrDefault(d => d.Commits > 0);
            if (last is null) return ("—", null);

            var days = Math.Max(0, (int)(DateTime.UtcNow.Date - last.Date.Date).TotalDays);
            return days switch
            {
                0 => ("today", null),
                1 => ("yesterday", null),
                _ => ($"{days}", "d ago")
            };
        }
    }

    /// <summary>
    /// Fixed thresholds rather than quantiles of the user's own data. A relative scale would paint
    /// a quiet year the same shade as a busy one, and the point of the grid is to compare days
    /// against a constant.
    /// </summary>
    private static string IntensityClass(int commits) => commits switch
    {
        0 => "ins-heat--0",
        <= 2 => "ins-heat--1",
        <= 5 => "ins-heat--2",
        <= 10 => "ins-heat--3",
        _ => "ins-heat--4"
    };

    private static string DeltaText(int value) => value switch
    {
        > 0 => $"+{value:N0}",
        < 0 => value.ToString("N0"),
        _ => "no change"
    };

    private static string DeltaClass(int value) => value switch
    {
        > 0 => "ins-delta--pos",
        < 0 => "ins-delta--neg",
        _ => "ins-delta--flat"
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // Show the loading skeleton rather than the previous error banner; LoadingState
        // deliberately re-renders as Loading on retry so the user always sees a refresh happen.
        _state = new LoadingState<PortfolioInsightsDto>.Loading();
        StateHasChanged();

        try
        {
            var data = await Http.GetAppJsonAsync(
                "/api/insights/portfolio",
                AppJsonSerializerContext.Default.PortfolioInsightsDto);

            _state = data is null || data.RepositoryCount == 0
                ? new LoadingState<PortfolioInsightsDto>.Empty()
                : new LoadingState<PortfolioInsightsDto>.Loaded(data);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Insights: failed to load portfolio insights");
            _state = new LoadingState<PortfolioInsightsDto>.Failed("Could not load your insights. Please try again.");
        }
        finally
        {
            StateHasChanged();
        }
    }
}
