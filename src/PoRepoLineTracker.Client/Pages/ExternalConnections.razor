@page "/diag"
@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<ExternalConnections> Logger
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

<div class="app-stack">
    @* <PageHero> — this was the last page still hand-rolling its header, around a `.page-header`
       class that no stylesheet in the project defines. It therefore had none of the hero's padding,
       gradient or wrap behaviour, and sat flush against the top of the well while every other page
       had a strip. *@
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.15rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="cloud" class="xc-title-icon" />
                    <RadzenText TextStyle="TextStyle.H4" class="xc-title">External Connections</RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Body2" class="xc-subtitle">
                    APIs, databases, and external services that this application connects to
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined" Size="ButtonSize.Small"
                          Click="@LoadDiagnostics" Disabled="@_isLoading" />
        </Actions>
    </PageHero>

    @if (_isLoading)
    {
        <RadzenCard>
            <RadzenSkeleton Width="100%" Height="400px" />
        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
            @_error
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text"
                          Click="@LoadDiagnostics" class="xc-refresh" />
        </RadzenAlert>
    }
    else if (_diagnostics != null)
    {
        @* Summary Card *@
        <RadzenCard class="xc-env-card">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.H6" class="xc-section-title">@_diagnostics.Environment Environment</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="xc-caption">
                        Last updated: @_diagnostics.Timestamp.ToLocalTime().ToString("g")
                    </RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_diagnostics.Summary.ConfiguredCount}/{_diagnostics.Summary.TotalConnections} Configured")" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        @* Three <ConnectionGrid> calls replace three byte-identical card+grid blocks. *@
        <div class="app-dashboard">
            <ConnectionGrid Title="Azure Services"
                            Icon="cloud"
                            IconClass="xc-icon--azure"
                            Connections="@_diagnostics.ExternalConnections.Azure" />

            <ConnectionGrid Title="GitHub Integrations"
                            Icon="code"
                            IconClass="xc-icon--github"
                            Connections="@_diagnostics.ExternalConnections.GitHub"
                            StatusIsHealthy="@(s => s.Contains("Configured") || s.Contains("PAT"))" />

            <ConnectionGrid Title="Observability"
                            Icon="analytics"
                            IconClass="xc-icon--otel"
                            Connections="@_diagnostics.ExternalConnections.OpenTelemetry" />
        </div>

        @* Purpose *@
        <RadzenCard class="xc-summary-card">
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle2">Application Purpose</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@_diagnostics.Summary.ApplicationPurpose</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
</div>

@code {
    private DiagnosticsResponse? _diagnostics;
    private bool _isLoading = false;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDiagnostics();
    }

    private async Task LoadDiagnostics()
    {
        _isLoading = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            _diagnostics = await Http.GetAppJsonAsync("/api/diagnostics", AppJsonSerializerContext.Default.DiagnosticsResponse);
            if (_diagnostics == null)
            {
                _error = "Failed to load diagnostics data.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading diagnostics");
            _error = $"Error loading diagnostics: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // DiagnosticsResponse / ExternalConnectionsData / ExternalConnectionInfo / DiagnosticsSummary used to
    // be declared here, as a hand-maintained mirror of the anonymous types the API returned —
    // nothing but a passing integration test kept the two in step. They are now one contract in
    // Shared (Rule 2.2), which is also what lets the payload be source-generated (Rule 1.2).
}
