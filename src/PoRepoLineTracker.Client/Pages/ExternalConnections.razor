@page "/diag"
@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<ExternalConnections> Logger
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization

<RadzenStack Gap="1.5rem">
    <div class="page-header">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenIcon Icon="cloud" class="xc-title-icon" />
            <RadzenText TextStyle="TextStyle.H4" class="xc-title">External Connections</RadzenText>
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Body2" class="xc-subtitle">
            APIs, databases, and external services that this application connects to
        </RadzenText>
    </div>

    @if (_isLoading)
    {
        <RadzenCard>
            <RadzenSkeleton Width="100%" Height="400px" />
        </RadzenCard>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
            @_error
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text"
                          Click="@LoadDiagnostics" class="xc-refresh" />
        </RadzenAlert>
    }
    else if (_diagnostics != null)
    {
        @* Summary Card *@
        <RadzenCard class="xc-env-card">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.H6" class="xc-section-title">@_diagnostics.Environment Environment</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="xc-caption">
                        Last updated: @_diagnostics.Timestamp.ToLocalTime().ToString("g")
                    </RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_diagnostics.Summary.ConfiguredCount}/{_diagnostics.Summary.TotalConnections} Configured")" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        @* Azure Services *@
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="cloud" class="xc-icon xc-icon--azure" />
                    <RadzenText TextStyle="TextStyle.H6" class="xc-section-title">Azure Services</RadzenText>
                </RadzenStack>

                <RadzenDataGrid Data="@_diagnostics.ExternalConnections.Azure" TItem="ExternalConnectionInfo" class="xc-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Name" Title="Service" Width="25%" />
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Type" Title="Type" Width="15%" />
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Status" Title="Status" Width="15%">
                            <Template Context="data">
                                <RadzenBadge BadgeStyle="@(data.Status == "Configured" ? BadgeStyle.Success : BadgeStyle.Warning)" 
                                            Text="@data.Status" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Purpose" Title="Purpose" Width="45%" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>

        @* GitHub Integrations *@
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="code" class="xc-icon xc-icon--github" />
                    <RadzenText TextStyle="TextStyle.H6" class="xc-section-title">GitHub Integrations</RadzenText>
                </RadzenStack>

                <RadzenDataGrid Data="@_diagnostics.ExternalConnections.GitHub" TItem="ExternalConnectionInfo" class="xc-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Name" Title="Service" Width="25%" />
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Type" Title="Type" Width="15%" />
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Status" Title="Status" Width="15%">
                            <Template Context="data">
                                <RadzenBadge BadgeStyle="@(data.Status.Contains("Configured") || data.Status.Contains("PAT") ? BadgeStyle.Success : BadgeStyle.Warning)" 
                                            Text="@data.Status" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Purpose" Title="Purpose" Width="45%" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>

        @* OpenTelemetry *@
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="analytics" class="xc-icon xc-icon--otel" />
                    <RadzenText TextStyle="TextStyle.H6" class="xc-section-title">Observability</RadzenText>
                </RadzenStack>

                <RadzenDataGrid Data="@_diagnostics.ExternalConnections.OpenTelemetry" TItem="ExternalConnectionInfo" class="xc-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Name" Title="Service" Width="25%" />
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Type" Title="Type" Width="15%" />
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Status" Title="Status" Width="15%">
                            <Template Context="data">
                                <RadzenBadge BadgeStyle="@(data.Status == "Configured" ? BadgeStyle.Success : BadgeStyle.Warning)" 
                                            Text="@data.Status" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Purpose" Title="Purpose" Width="45%" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>

        @* Purpose *@
        <RadzenCard class="xc-summary-card">
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle2">Application Purpose</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@_diagnostics.Summary.ApplicationPurpose</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private DiagnosticsResponse? _diagnostics;
    private bool _isLoading = false;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDiagnostics();
    }

    private async Task LoadDiagnostics()
    {
        _isLoading = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            _diagnostics = await Http.GetAppJsonAsync("/api/diagnostics", AppJsonSerializerContext.Default.DiagnosticsResponse);
            if (_diagnostics == null)
            {
                _error = "Failed to load diagnostics data.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading diagnostics");
            _error = $"Error loading diagnostics: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // DiagnosticsResponse / ExternalConnectionsData / ExternalConnectionInfo / DiagnosticsSummary used to
    // be declared here, as a hand-maintained mirror of the anonymous types the API returned —
    // nothing but a passing integration test kept the two in step. They are now one contract in
    // Shared (Rule 2.2), which is also what lets the payload be source-generated (Rule 1.2).
}
