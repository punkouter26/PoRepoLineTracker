@using Microsoft.AspNetCore.Components.Routing
@using Radzen
@using Radzen.Blazor

@* Every routable page in the app appears here.

   /diag (ExternalConnections) used to be reachable only by typing the URL — a full page, behind
   [Authorize], carrying the external-dependency health tables, with no affordance anywhere in the
   UI that led to it. It is listed under Config rather than beside the two data pages because it
   answers "is the plumbing working", not "how is my code doing".

   /settings/extensions-counted is deliberately NOT listed: it is a second @page directive on
   ExtensionsCounted.razor, not a separate destination, so a nav entry for it would be the same
   screen under a second name. *@
<RadzenPanelMenu>
    <RadzenPanelMenuItem Text="Repositories" Icon="storage" Path="/" />
    <RadzenPanelMenuItem Text="Global Insights" Icon="insights" Path="/insights" />
    <div class="nav-section-label">Config</div>
    <RadzenPanelMenuItem Text="Settings" Icon="tune" Path="/settings" />
    <RadzenPanelMenuItem Text="Diagnostics" Icon="monitor_heart" Path="/diag" />
</RadzenPanelMenu>
