@using Microsoft.AspNetCore.Components.Routing
@using Radzen
@using Radzen.Blazor

@* The app's navigable destinations.

   /diag (ExternalConnections) is deliberately NOT listed. The page still exists and is still
   routable and [Authorize]d — it carries the external-dependency health tables — but it answers
   "is the plumbing working", which is an operator's question, not something a user navigates to
   while looking at their code. It is reached by typing the URL.

   /settings/extensions-counted is also not listed: it is a second @page directive on
   ExtensionsCounted.razor, not a separate destination, so a nav entry for it would be the same
   screen under a second name. *@
<RadzenPanelMenu>
    <RadzenPanelMenuItem Text="Repositories" Icon="storage" Path="/" />
    <RadzenPanelMenuItem Text="Global Insights" Icon="insights" Path="/insights" />
    <RadzenPanelMenuItem Text="Code Health" Icon="health_and_safety" Path="/code-health" />
    <RadzenPanelMenuItem Text="Year in Code" Icon="auto_awesome" Path="/recap" />
    <div class="nav-section-label">Config</div>
    <RadzenPanelMenuItem Text="Settings" Icon="tune" Path="/settings" />
</RadzenPanelMenu>
