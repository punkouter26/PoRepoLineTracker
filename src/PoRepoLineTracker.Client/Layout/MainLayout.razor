@inherits LayoutComponentBase
@using PoRepoLineTracker.Client.Layout
@using PoRepoLineTracker.Client.Components
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<RadzenLayout>
    <RadzenHeader>
        @* Rule 4.1 header contract — Left (Branding) | Center (Actions) | Right (Session).
           Three explicit regions rather than SpaceBetween, so the centre stays centred whatever
           it contains and the session controls stay isolated on the right. *@
        <div class="app-header">
            <div class="app-header__brand">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                             class="brand-link" @onclick="@(() => Navigation.NavigateTo("/"))">
                    <span class="brand-icon-wrap">
                        <RadzenIcon Icon="code" class="brand-icon-main" />
                        <RadzenIcon Icon="trending_up" class="brand-icon-trend" />
                    </span>
                    <RadzenText TextStyle="TextStyle.H5" class="brand-wordmark">PoRepoLineTracker</RadzenText>
                </RadzenStack>
            </div>

            <div class="app-header__actions">
                <RadzenButton Icon="@(sidebarExpanded ? "menu_open" : "menu")"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              class="header-icon-btn"
                              title="Toggle navigation"
                              Click="@ToggleSidebar" />
                <RadzenButton Icon="storage"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              Size="ButtonSize.Small"
                              Text="Repositories"
                              class="header-action-btn"
                              Click="@(() => Navigation.NavigateTo("/"))" />
                <RadzenButton Icon="tune"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              Size="ButtonSize.Small"
                              Text="Settings"
                              class="header-action-btn"
                              Click="@(() => Navigation.NavigateTo("/settings"))" />
                @* USING MOCK DATA warning sits with the actions so it is impossible to miss. *@
                @if (_usingMockData)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning"
                                 Text="⚠ USING MOCK DATA"
                                 class="mock-data-badge" />
                }
            </div>

            <div class="app-header__session">
                <RadzenButton Icon="@(_isDarkMode ? "light_mode" : "dark_mode")"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              class="header-icon-btn"
                              title="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                              Click="@ToggleDarkMode" />
                <LoginDisplay />
            </div>
        </div>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded" class="app-sidebar">
        <div class="app-sidebar__nav">
            <ErrorBoundary>
                <ChildContent>
                    <NavMenu />
                </ChildContent>
                <ErrorContent>
                    <!-- nav recovered silently -->
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </RadzenSidebar>
    
    <RadzenBody>
        <div class="rz-p-4">
            <MockDataBanner IsMockData="@_isMockData" />
            @if (!string.IsNullOrEmpty(_breadcrumbCurrent))
            {
                <nav class="app-breadcrumb" aria-label="breadcrumb">
                    <a href="/">Home</a>
                    @if (!string.IsNullOrEmpty(_breadcrumbParent))
                    {
                        <span class="bc-sep">›</span>
                        @if (!string.IsNullOrEmpty(_breadcrumbParentPath))
                        {
                            <a href="@_breadcrumbParentPath">@_breadcrumbParent</a>
                        }
                        else
                        {
                            <span>@_breadcrumbParent</span>
                        }
                    }
                    <span class="bc-sep">›</span>
                    <span class="bc-current" aria-current="page">@_breadcrumbCurrent</span>
                </nav>
            }
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private bool sidebarExpanded = true;
    private bool _isDarkMode = false;
    private bool _isMockData = false;
    private bool _usingMockData = false;
    private string? _breadcrumbCurrent;
    private string? _breadcrumbParent;
    private string? _breadcrumbParentPath;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateBreadcrumb(Navigation.Uri);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch feature flags from the API to determine whether mock data is active.
            // This drives both the MockDataBanner and the nav warning badge.
            var response = await Http.GetFromJsonAsync<FeatureFlagsDto>("api/feature-flags");
            _isMockData = response?.EnableMockDataForTesting == true;
            _usingMockData = _isMockData;
        }
        catch
        {
            // Non-critical — silently ignore if the endpoint is unreachable.
            _isMockData = false;
            _usingMockData = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "theme");
            _isDarkMode = saved == "dark";
            if (_isDarkMode) StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBreadcrumb(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateBreadcrumb(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        (_breadcrumbCurrent, _breadcrumbParent, _breadcrumbParentPath) = path switch
        {
            "" or "/" => (null, null, null),
            "/settings" => ("Settings", null, null),
            "/settings/extensions-counted" => ("Settings", null, null),
            _ when path.StartsWith("/repositories/") && path.Length > "/repositories/".Length
                => ("Repository Detail", "Repositories", "/"),
            _ => (null, null, null)
        };
    }

    private void ToggleSidebar()
    {
        sidebarExpanded = !sidebarExpanded;
        StateHasChanged();
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JSRuntime.InvokeVoidAsync("setTheme", _isDarkMode ? "dark" : "light");
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    // DTO for deserializing /api/feature-flags — co-located with consumer to avoid a shared model
    // for a non-domain concern.
    private sealed record FeatureFlagsDto(
        bool EnableMockDataForTesting,
        bool EnableGitHubApi,
        bool EnableBackgroundAnalysis,
        bool EnableOpenTelemetryExport);
}
