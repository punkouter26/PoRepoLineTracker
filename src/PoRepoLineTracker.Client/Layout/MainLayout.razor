@inherits LayoutComponentBase
@implements IDisposable
@using PoRepoLineTracker.Client.Layout
@using PoRepoLineTracker.Client.Components
@using PoRepoLineTracker.Client.Services
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http


@* Radzen's own matchMedia wrapper — see OnMobileChanged for why this replaced a one-shot
   JS interop call. Rendered outside RadzenLayout because it draws nothing. *@
<RadzenMediaQuery Query="@($"(max-width: {MobileBreakpointPx}px)")" Change="@OnMobileChanged" />

@* Visible only on focus. Every route puts the full sidebar between the page start and the
   content, so without this a keyboard user tabs through the whole nav again on each navigation.
   First element in the DOM so it is the first thing Tab reaches.

   Focus is moved in code rather than left to the browser's fragment handling. Blazor's router
   intercepts anchor clicks, so the default "navigate to #id and focus it" never runs — the link
   scrolled the page and left focus behind in the nav, which looks like it works and does nothing
   for the keyboard user it exists for. The href is kept so the control still reads as a link and
   still announces its target. *@
<a class="app-skip-link" href="#main-content" @onclick="SkipToMainAsync" @onclick:preventDefault>Skip to main content</a>

<RadzenLayout>
    <RadzenHeader>
        @* Header contract — Left (Branding) | Center (Toggle + Theme) | Right (Session).
           Three explicit regions rather than SpaceBetween, so the centre stays centred whatever
           it contains and the session controls stay isolated on the right.

           The previous header also carried Repositories / Insights / Settings buttons; those were
           byte-identical to the items in <NavMenu>, so the layout paid for two copies of the same
           nav and on phones the three buttons crowded the brand wordmark. The drawer is the only
           nav surface now — the header carries the controls that are not navigation. *@
        <div class="app-header">
            <div class="app-header__brand">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                             class="brand-link" @onclick="@(() => Navigation.NavigateTo("/"))">
                    <span class="brand-icon-wrap" aria-hidden="true">
                        <RadzenIcon Icon="code" class="brand-icon-main" />
                        <RadzenIcon Icon="trending_up" class="brand-icon-trend" />
                    </span>
                    @* A <span>, not <RadzenText TextStyle="H5">. The brand is not a heading: as an
                       <h5> it was the first heading on every page, so the document outline opened
                       H5 → H3 and the wordmark outranked the page title beneath it. Styling is
                       unchanged — brand-wordmark already carries it. *@
                    <span class="brand-wordmark">PoRepoLineTracker</span>
                </RadzenStack>
            </div>

            <div class="app-header__actions">
                <RadzenButton Icon="@(sidebarExpanded ? "menu_open" : "menu")"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              class="header-icon-btn"
                              title="@(sidebarExpanded ? "Hide navigation" : "Show navigation")"
                              aria-label="@(sidebarExpanded ? "Hide navigation" : "Show navigation")"
                              Click="@ToggleSidebar" />
            </div>

            <div class="app-header__session">
                @* Renders nothing unless the browser has actually offered an install prompt —
                   see InstallAppButton. It sits before the theme toggle so the controls that are
                   always present keep a stable position when it does appear. *@
                <InstallAppButton />
                <RadzenButton Icon="@(_isDarkMode ? "light_mode" : "dark_mode")"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              class="header-icon-btn"
                              title="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                              aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                              Click="@ToggleDarkMode" />
                <LoginDisplay />
            </div>
        </div>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded" class="@SidebarClass">
        <div class="app-sidebar__nav" @onclick="@CollapseSidebarOnMobile">
            <ErrorBoundary>
                <ChildContent>
                    <NavMenu />
                </ChildContent>
                <ErrorContent>
                    <!-- nav recovered silently -->
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </RadzenSidebar>

    @* Scrim: only rendered while the drawer overlays content on a phone. Tapping it
       closes the drawer, which is the behaviour users expect from an off-canvas nav
       and the only way to dismiss it without hunting for the toggle. *@
    @if (sidebarExpanded && _isMobile)
    {
        <button type="button" class="app-scrim" aria-label="Close navigation" @onclick="@ToggleSidebar"></button>
    }

    <RadzenBody>
        @* tabindex="-1" so the skip link can move focus here; without it the anchor scrolls the
           page but leaves focus stranded back in the nav, which is the failure mode that makes
           skip links look like they work while doing nothing for a keyboard. *@
        <main id="main-content" class="app-content" tabindex="-1" @ref="_mainContent">
            @if (!string.IsNullOrEmpty(_breadcrumbCurrent))
            {
                <nav class="app-breadcrumb" aria-label="breadcrumb">
                    @* The root IS the repositories page, so on "/" the trail is a single current
                       item. It previously rendered nothing at all there — the one route without a
                       breadcrumb — which moved the page header up by its height relative to every
                       other route. Linking "Home" to the page you are already on would be the
                       other way to keep the row, and a worse one. *@
                    @if (!_breadcrumbIsRoot)
                    {
                        <a href="/">Home</a>
                        @if (!string.IsNullOrEmpty(_breadcrumbParent))
                        {
                            <span class="bc-sep">›</span>
                            @if (!string.IsNullOrEmpty(_breadcrumbParentPath))
                            {
                                <a href="@_breadcrumbParentPath">@_breadcrumbParent</a>
                            }
                            else
                            {
                                <span>@_breadcrumbParent</span>
                            }
                        }
                        <span class="bc-sep">›</span>
                    }
                    <span class="bc-current" aria-current="page">@_breadcrumbCurrent</span>
                </nav>
            }
            @Body
        </main>
    </RadzenBody>
</RadzenLayout>

@if (_isMobile)
{
    <nav class="app-bottom-nav" aria-label="Mobile Navigation">
        <a href="/" class="app-bottom-nav__item @(IsActive("/") ? "app-bottom-nav__item--active" : "")">
            <RadzenIcon Icon="storage" />
            <span>Repos</span>
        </a>
        <a href="/insights" class="app-bottom-nav__item @(IsActive("/insights") ? "app-bottom-nav__item--active" : "")">
            <RadzenIcon Icon="insights" />
            <span>Insights</span>
        </a>
        <a href="/code-health" class="app-bottom-nav__item @(IsActive("/code-health") ? "app-bottom-nav__item--active" : "")">
            <RadzenIcon Icon="health_and_safety" />
            <span>Health</span>
        </a>
        <a href="/recap" class="app-bottom-nav__item @(IsActive("/recap") ? "app-bottom-nav__item--active" : "")">
            <RadzenIcon Icon="auto_awesome" />
            <span>Recap</span>
        </a>
        <a href="/settings" class="app-bottom-nav__item @(IsActive("/settings") ? "app-bottom-nav__item--active" : "")">
            <RadzenIcon Icon="tune" />
            <span>Settings</span>
        </a>
    </nav>
}

<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private const int MobileBreakpointPx = 768;

    private bool sidebarExpanded = true;
    private bool _isMobile = false;
    private bool _isDarkMode = false;
    private string? _breadcrumbCurrent;
    private string? _breadcrumbParent;
    private string? _breadcrumbParentPath;

    private bool IsActive(string path)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (path == "/") return string.IsNullOrEmpty(current) || current.StartsWith("repositories", StringComparison.OrdinalIgnoreCase);
        return current.StartsWith(path.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>True on "/" and "/repositories", where the trail is a single item with no Home link ahead of it.</summary>
    private bool _breadcrumbIsRoot;

    /// <summary>The skip link's target. Focusable only because &lt;main&gt; carries tabindex="-1".</summary>
    private ElementReference _mainContent;

    private async Task SkipToMainAsync() => await _mainContent.FocusAsync();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateBreadcrumb(Navigation.Uri);
    }

    /// <summary>
    /// `app-sidebar--open` drives the off-canvas transform below 768px;
    /// `app-sidebar--collapsed` shrinks the grid track on desktop. Radzen's own
    /// expanded/collapsed classes are an implementation detail we would rather not depend on,
    /// so the drawer state rides on classes this component owns.
    /// </summary>
    private string SidebarClass => sidebarExpanded
        ? "app-sidebar app-sidebar--open"
        : "app-sidebar app-sidebar--collapsed";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Seed from what the boot script actually painted rather than from localStorage:
        // with no saved choice the script follows the OS, and reading the raw key would
        // leave the toggle icon showing the opposite of the page.
        var theme = await JSRuntime.InvokeAsync<string>("getEffectiveTheme");
        _isDarkMode = theme == "dark";

        StateHasChanged();
    }

    /// <summary>
    /// Fired by <c>&lt;RadzenMediaQuery&gt;</c> whenever the match state changes.
    ///
    /// This replaces a one-shot <c>getViewportWidth</c> JS interop call in OnAfterRenderAsync,
    /// which was a live bug rather than merely verbose: <c>_isMobile</c> was sampled once on
    /// first render and never re-evaluated, so rotating a phone to landscape (or dragging a
    /// desktop window narrow) left the drawer behaving for the wrong breakpoint until reload.
    /// RadzenMediaQuery subscribes to the underlying matchMedia listener, so the state now
    /// tracks the viewport for the lifetime of the layout — and the custom JS function is gone.
    /// </summary>
    private void OnMobileChanged(bool matched)
    {
        _isMobile = matched;

        // The drawer defaults to expanded, which is right for the desktop grid but would cover
        // the page on a phone. Collapse on entering mobile; restore on leaving it, so a rotate
        // back to landscape does not leave the user staring at a hidden nav.
        sidebarExpanded = !matched;
        StateHasChanged();
    }

    /// <summary>Dismisses the drawer after a nav tap so the page is not left behind a scrim.</summary>
    private void CollapseSidebarOnMobile()
    {
        // Nav clicks only auto-collapse on mobile, where the sidebar overlays content.
        // On desktop a collapsed sidebar is the user's chosen state — respect it.
        if (_isMobile) sidebarExpanded = false;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBreadcrumb(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateBreadcrumb(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        _breadcrumbIsRoot = path is "" or "/" or "/repositories";
        (_breadcrumbCurrent, _breadcrumbParent, _breadcrumbParentPath) = path switch
        {
            "" or "/" or "/repositories" => ("Repositories", null, null),
            "/insights" => ("Global Insights", null, null),
            "/recap" => ("Year in Code", null, null),
            // /recap/2024 is the same page under an explicit year, so it reads as a child of the
            // year-less route rather than as a destination of its own.
            _ when path.StartsWith("/recap/") && path.Length > "/recap/".Length
                => (path["/recap/".Length..], "Year in Code", "/recap"),
            "/settings" => ("Settings", null, null),
            "/settings/extensions-counted" => ("Settings", null, null),
            "/diag" => ("Diagnostics", null, null),
            _ when path.StartsWith("/repositories/") && path.Length > "/repositories/".Length
                => ("Repository Detail", "Repositories", "/"),
            _ => (null, null, null)
        };
    }

    private void ToggleSidebar()
    {
        sidebarExpanded = !sidebarExpanded;
        StateHasChanged();
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JSRuntime.InvokeVoidAsync("setTheme", _isDarkMode ? "dark" : "light");
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    }
