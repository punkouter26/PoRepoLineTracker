<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AOT disabled: codebase uses reflection-based JSON serialization -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Rule 6.6 — trim hygiene. EnableTrimAnalyzer surfaces trim-unsafe code at build;
         IsTrimmable marks this project's output trimmable. (AOT stays off per above.) -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- IL2026/IL3050 are intrinsic to the reflection-based System.Text.Json usage this app
         deliberately relies on (same rationale as IsAotCompatible=false above). IL2110/IL2111
         come from Blazor's own Router/LayoutView component activation (framework, not app code).
         Suppressed so the analyzer still flags every *other* trim hazard without failing the build. -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2110;IL2111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoRepoLineTracker.Shared\PoRepoLineTracker.Shared.csproj" />
    <ProjectReference Include="..\PoRepoLineTracker.Domain\PoRepoLineTracker.Domain.csproj" />
  </ItemGroup>

</Project>
