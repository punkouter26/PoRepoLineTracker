@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor

<RadzenCard class="cc-card">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="cc-toolbar">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" class="cc-title">Top Contributors</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="cc-description">
                Source code contributions by author
            </RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Caption" class="cc-caption">Range:</RadzenText>
            <RadzenSelectBar @bind-Value="_chartDays" TValue="int" Change="@OnChartRangeChanged" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Text="30d" Value="30" />
                    <RadzenSelectBarItem Text="90d" Value="90" />
                    <RadzenSelectBarItem Text="180d" Value="180" />
                    <RadzenSelectBarItem Text="1yr" Value="365" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </RadzenStack>

    @if (_isLoading)
    {
        <RadzenSkeleton Width="100%" Height="320px" />
    }
    else if (!string.IsNullOrEmpty(_chartError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
            @_chartError
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text"
                          Click="@LoadContributorStats" class="cc-refresh" />
        </RadzenAlert>
    }
    else if (_contributors == null || !_contributors.Any())
    {
        <RadzenStack AlignItems="AlignItems.Center" class="rz-p-8">
            <RadzenIcon Icon="people" class="cc-empty-icon" />
            <RadzenText TextStyle="TextStyle.Body1" class="cc-empty-text">No contributor data yet.</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="cc-empty-hint">Re-analyze the repository to see contributor statistics.</RadzenText>
        </RadzenStack>
    }
    else
    {
        @* Legend *@
        <div class="cc-legend">
            @foreach (var contributor in _contributors.OrderByDescending(c => c.TotalLinesAdded).Take(5))
            {
                var swatchClass = GetAuthorColorClass(contributor.AuthorName);
                var displayName = string.IsNullOrWhiteSpace(contributor.AuthorName) ? "(Unknown)" : contributor.AuthorName;
                <div class="cc-legend__item">
                    <div class="cc-swatch @swatchClass"></div>
                    <span class="cc-legend__label">@displayName (@contributor.TotalLinesAdded.ToString("N0") lines)</span>
                </div>
            }
        </div>

        @* Chart *@
        <RadzenChart class="cc-chart">
            @foreach (var contributor in _contributors.OrderByDescending(c => c.TotalLinesAdded).Take(5))
            {
                // Stroke is a Radzen parameter, not CSS — it stays a colour value.
                var color = GetColorForAuthor(contributor.AuthorName);
                var displayName = string.IsNullOrWhiteSpace(contributor.AuthorName) ? "(Unknown)" : contributor.AuthorName;
                <RadzenLineSeries Data="@contributor.DailyHistory"
                                  CategoryProperty="Date"
                                  ValueProperty="LinesAdded"
                                  Title="@displayName"
                                  Stroke="@color"
                                  StrokeWidth="2">
                    <RadzenMarkers MarkerType="MarkerType.Circle" />
                </RadzenLineSeries>
            }
            <RadzenCategoryAxis FormatString="{0:MM/dd/yy}">
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Min="0">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>

        @* Summary Table *@
        <div class="cc-table-section">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="cc-table-title">All Contributors</RadzenText>
            <RadzenDataGrid Data="@_contributors.OrderByDescending(c => c.TotalLinesAdded)" TItem="ContributorStatsDto" class="cc-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="AuthorName" Title="Author" Width="30%">
                        <Template Context="data">
                            <div class="cc-cell-row">
                                <div class="cc-swatch cc-swatch--sm @GetAuthorColorClass(data.AuthorName)"></div>
                                @data.AuthorName
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalCommits" Title="Commits" Width="15%">
                        <Template Context="data">
                            @data.TotalCommits.ToString("N0")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalLinesAdded" Title="Lines Added" Width="20%">
                        <Template Context="data">
                            <span class="cc-added">+@data.TotalLinesAdded.ToString("N0")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalLinesRemoved" Title="Lines Removed" Width="20%">
                        <Template Context="data">
                            <span class="cc-removed">-@data.TotalLinesRemoved.ToString("N0")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="PercentageOfTotalLines" Title="% of Total" Width="15%">
                        <Template Context="data">
                            <div class="cc-cell-row">
                                <div class="cc-bar">
                                    <div class="cc-bar__fill @GetAuthorColorClass(data.AuthorName)" style="@($"--cc-bar-fill: {Math.Min(data.PercentageOfTotalLines, 100):F1}%")"></div>
                                </div>
                                <span class="cc-bar__value">@data.PercentageOfTotalLines.ToString("F1")%</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</RadzenCard>

@code {
    [Parameter] public RepositoryId RepositoryId { get; set; }
    [Inject] HttpClient Http { get; set; } = null!;
    [Inject] ILogger<ContributorChart> Logger { get; set; } = null!;

    private List<ContributorStatsDto>? _contributors;
    private bool _isLoading = false;
    private string _chartError = string.Empty;
    private int _chartDays = 90;

    private static readonly string[] _colors = { "#3b82f6", "#ef4444", "#22c55e", "#f59e0b", "#8b5cf6", "#ec4899", "#14b8a6", "#f97316" };

    protected override async Task OnInitializedAsync()
    {
        await LoadContributorStats();
    }

    private async Task LoadContributorStats()
    {
        _isLoading = true;
        _chartError = string.Empty;
        StateHasChanged();

        try
        {
            _contributors = await Http.GetFromJsonAsync<List<ContributorStatsDto>>($"/api/repositories/{RepositoryId}/contributors/{_chartDays}?topN=10");
            
            if (_contributors == null || !_contributors.Any())
            {
                _chartError = "No contributor data found. Re-analyze the repository to see contributor statistics.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading contributor stats for repository {RepositoryId}", RepositoryId);
            _chartError = $"Error loading contributor data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnChartRangeChanged(int days)
    {
        _chartDays = days;
        await LoadContributorStats();
    }

    private string GetColorForAuthor(string authorName)
    {
        var index = Math.Abs(authorName.GetHashCode()) % _colors.Length;
        return _colors[index];
    }

    /// <summary>
    /// Rule 4.3 — swatches and bars used to receive their colour through an interpolated inline
    /// style. The palette is a fixed list, so the hash maps to a modifier class and the colours
    /// live in ContributorChart.razor.css (kept in step with <see cref="_colors"/>).
    /// </summary>
    private static string GetAuthorColorClass(string authorName) =>
        $"cc-swatch--{Math.Abs(authorName.GetHashCode()) % _colors.Length}";
}
