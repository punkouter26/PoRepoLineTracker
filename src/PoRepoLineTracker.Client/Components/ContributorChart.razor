@using PoRepoLineTracker.Application.Models
@using Radzen
@using Radzen.Blazor

<RadzenCard Style="padding: 1.25rem 1.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" Style="margin-bottom: 1rem;">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 700;">Top Contributors</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">
                Source code contributions by author
            </RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Range:</RadzenText>
            <RadzenSelectBar @bind-Value="_chartDays" TValue="int" Change="@OnChartRangeChanged" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Text="30d" Value="30" />
                    <RadzenSelectBarItem Text="90d" Value="90" />
                    <RadzenSelectBarItem Text="180d" Value="180" />
                    <RadzenSelectBarItem Text="1yr" Value="365" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </RadzenStack>

    @if (_isLoading)
    {
        <RadzenSkeleton Width="100%" Height="320px" />
    }
    else if (!string.IsNullOrEmpty(_chartError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
            @_chartError
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text"
                          Click="@LoadContributorStats" Style="margin-left: 0.5rem;" />
        </RadzenAlert>
    }
    else if (_contributors == null || !_contributors.Any())
    {
        <RadzenStack AlignItems="AlignItems.Center" class="rz-p-8">
            <RadzenIcon Icon="people" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">No contributor data yet.</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-disabled-color);">Re-analyze the repository to see contributor statistics.</RadzenText>
        </RadzenStack>
    }
    else
    {
        @* Legend *@
        <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
            @foreach (var contributor in _contributors.OrderByDescending(c => c.TotalLinesAdded).Take(5))
            {
                var color = GetColorForAuthor(contributor.AuthorName);
                <div style="display: flex; align-items: center; gap: 0.35rem;">
                    <div style="width: 12px; height: 12px; border-radius: 2px; background: @color;"></div>
                    <span style="font-size: 0.85rem;">@contributor.AuthorName (@contributor.TotalLinesAdded.ToString("N0") lines)</span>
                </div>
            }
        </div>

        @* Chart *@
        <RadzenChart Style="height: 320px; width: 100%;">
            @foreach (var contributor in _contributors.OrderByDescending(c => c.TotalLinesAdded).Take(5))
            {
                var color = GetColorForAuthor(contributor.AuthorName);
                <RadzenLineSeries Data="@contributor.DailyHistory"
                                  CategoryProperty="Date"
                                  ValueProperty="LinesAdded"
                                  Title="@contributor.AuthorName"
                                  Stroke="@color"
                                  StrokeWidth="2"
                                  MarkerType="MarkerType.Circle" />
            }
            <RadzenCategoryAxis FormatString="{0:MM/dd/yy}">
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Min="0">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>

        @* Summary Table *@
        <div style="margin-top: 1.5rem;">
            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0 0 0.75rem 0; font-weight: 600;">All Contributors</RadzenText>
            <RadzenDataGrid Data="@_contributors.OrderByDescending(c => c.TotalLinesAdded)" TItem="ContributorStatsDto" Style="font-size: 0.85rem;">
                <Columns>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="AuthorName" Title="Author" Width="30%">
                        <Template Context="data">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <div style="width: 10px; height: 10px; border-radius: 2px; background: @GetColorForAuthor(data.AuthorName);"></div>
                                @data.AuthorName
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalCommits" Title="Commits" Width="15%">
                        <Template Context="data">
                            @data.TotalCommits.ToString("N0")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalLinesAdded" Title="Lines Added" Width="20%">
                        <Template Context="data">
                            <span style="color: #22c55e; font-weight: 600;">+@data.TotalLinesAdded.ToString("N0")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalLinesRemoved" Title="Lines Removed" Width="20%">
                        <Template Context="data">
                            <span style="color: #ef4444;">-@data.TotalLinesRemoved.ToString("N0")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ContributorStatsDto" Property="PercentageOfTotalLines" Title="% of Total" Width="15%">
                        <Template Context="data">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <div style="flex: 1; height: 6px; border-radius: 3px; background: var(--rz-base-200);">
                                    <div style="@($"height: 100%; border-radius: 3px; background: {GetColorForAuthor(data.AuthorName)}; width: {Math.Min(data.PercentageOfTotalLines, 100):F1}%;")"></div>
                                </div>
                                <span style="min-width: 40px; text-align: right;">@data.PercentageOfTotalLines.ToString("F1")%</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</RadzenCard>

@code {
    [Parameter] public Guid RepositoryId { get; set; }
    [Inject] HttpClient Http { get; set; } = null!;
    [Inject] ILogger<ContributorChart> Logger { get; set; } = null!;

    private List<ContributorStatsDto>? _contributors;
    private bool _isLoading = false;
    private string _chartError = string.Empty;
    private int _chartDays = 90;

    private static readonly string[] _colors = { "#3b82f6", "#ef4444", "#22c55e", "#f59e0b", "#8b5cf6", "#ec4899", "#14b8a6", "#f97316" };

    protected override async Task OnInitializedAsync()
    {
        await LoadContributorStats();
    }

    private async Task LoadContributorStats()
    {
        _isLoading = true;
        _chartError = string.Empty;
        StateHasChanged();

        try
        {
            _contributors = await Http.GetFromJsonAsync<List<ContributorStatsDto>>($"/api/repositories/{RepositoryId}/contributors/{_chartDays}?topN=10");
            
            if (_contributors == null || !_contributors.Any())
            {
                _chartError = "No contributor data found. Re-analyze the repository to see contributor statistics.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading contributor stats for repository {RepositoryId}", RepositoryId);
            _chartError = $"Error loading contributor data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnChartRangeChanged(int days)
    {
        _chartDays = days;
        await LoadContributorStats();
    }

    private string GetColorForAuthor(string authorName)
    {
        var index = Math.Abs(authorName.GetHashCode()) % _colors.Length;
        return _colors[index];
    }
}
