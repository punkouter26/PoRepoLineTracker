@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor

<ChartCard Title="Top Contributors"
           Description="Source code contributions by author"
           IsLoading="@_isLoading"
           ErrorMessage="@_chartError"
           OnRetry="@LoadContributorStats"
           IsEmpty="@(_contributors is null || !_contributors.Any())"
           EmptyIcon="people"
           EmptyText="No contributor data yet."
           EmptyHint="Re-analyze the repository to see contributor statistics.">
    <Toolbar>
        @* Stacked columns read far better than five overlapping daily line series: the total
           height is the day's output and each band is one author's share of it. *@
        <RadzenSelectBar Value="@_stacked" TValue="bool" Change="@OnStackedChanged" Size="ButtonSize.Small"
                         aria-label="Chart style">
            <Items>
                <RadzenSelectBarItem Text="Lines" Value="false" />
                <RadzenSelectBarItem Text="Stacked" Value="true" />
            </Items>
        </RadzenSelectBar>
    </Toolbar>
    <ChildContent>
        @{
            var top = TopContributors.ToList();
        }

        @* The hand-rolled .cc-legend that used to sit here is gone. It rendered ABOVE a chart
           that also emitted <RadzenLegend Position="Bottom">, so every author appeared twice and
           the panel paid for two legends' worth of vertical space. RadzenLegend already carries
           the series titles and colours set below, so it is the one that stays. *@

        @* Chart *@
        <RadzenChart>
            @foreach (var contributor in top)
            {
                // Stroke/Fill are Radzen parameters, not CSS — they stay colour values.
                var color = GetColorForAuthor(contributor.AuthorName);
                var displayName = DisplayName(contributor);

                if (_stacked)
                {
                    <RadzenStackedColumnSeries Data="@contributor.DailyHistory"
                                               CategoryProperty="Date"
                                               ValueProperty="LinesAdded"
                                               Title="@displayName"
                                               Fill="@color" />
                }
                else
                {
                    <RadzenLineSeries Data="@contributor.DailyHistory"
                                      CategoryProperty="Date"
                                      ValueProperty="LinesAdded"
                                      Title="@displayName"
                                      Stroke="@color"
                                      StrokeWidth="2">
                        <RadzenMarkers MarkerType="MarkerType.Circle" />
                        @* Only for the top author, and only in Lines mode. "Is this spike unusual
                           for them?" is the question a daily-output series actually raises, and it
                           is not answerable from the curve alone — the eye anchors on the peak, not
                           on the typical day. One mean line answers it; five would be five more
                           strokes competing with the data. *@
                        @if (ReferenceEquals(contributor, top[0]))
                        {
                            <RadzenSeriesMeanLine Stroke="@color" StrokeWidth="1" LineType="LineType.Dashed" />
                        }
                    </RadzenLineSeries>
                }
            }

            @* Whole-day Step: see ChartFormat.DateAxisStep. *@
            <RadzenCategoryAxis FormatString="{0:MMM d}"
                                Step="@ChartFormat.DateAxisStep(top.SelectMany(c => c.DailyHistory).Select(d => d.Date))"
                                LabelAutoRotation="-45">
                <RadzenAxisTitle Text="Date" />
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines">
                <RadzenAxisTitle Text="Lines Added" />
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>

        @* Summary Table *@
        <div class="cc-table-section">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="cc-table-title">All Contributors</RadzenText>
            <div class="u-scroll-x">
                <RadzenDataGrid Data="@_contributors!.OrderByDescending(c => c.TotalLinesAdded)"
                                TItem="ContributorStatsDto"
                                Responsive="true"
                                class="cc-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ContributorStatsDto" Property="AuthorName" Title="Author" Width="30%">
                            <Template Context="data">
                                <div class="cc-cell-row">
                                    <div class="cc-swatch cc-swatch--sm @GetAuthorColorClass(data.AuthorName)"></div>
                                    @data.AuthorName
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalCommits" Title="Commits" Width="15%">
                            <Template Context="data">
                                @data.TotalCommits.ToString("N0")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalLinesAdded" Title="Lines Added" Width="20%">
                            <Template Context="data">
                                <span class="cc-added">+@data.TotalLinesAdded.ToString("N0")</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ContributorStatsDto" Property="TotalLinesRemoved" Title="Lines Removed" Width="20%">
                            <Template Context="data">
                                <span class="cc-removed">-@data.TotalLinesRemoved.ToString("N0")</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ContributorStatsDto" Property="PercentageOfTotalLines" Title="% of Total" Width="15%">
                            <Template Context="data">
                                <div class="cc-cell-row">
                                    <progress class="cc-bar @GetAuthorColorClass(data.AuthorName)"
                                              max="100"
                                              value="@Math.Min(data.PercentageOfTotalLines, 100)"
                                              aria-label="@($"{data.AuthorName}: {data.PercentageOfTotalLines:F1}% of total lines")"></progress>
                                    <span class="cc-bar__value">@data.PercentageOfTotalLines.ToString("F1")%</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </ChildContent>
</ChartCard>

@implements IAsyncDisposable

@code {
    [Parameter] public RepositoryId RepositoryId { get; set; }
    [Inject] HttpClient Http { get; set; } = null!;
    [Inject] ILogger<ContributorChart> Logger { get; set; } = null!;

    private List<ContributorStatsDto>? _contributors;
    private bool _isLoading = false;
    private bool _stacked = false;
    private string _chartError = string.Empty;

    /// <summary>Window in days, owned by the page so every chart on it agrees.</summary>
    [Parameter] public int Days { get; set; } = 90;

    /// <summary>Last value actually fetched — see OnParametersSetAsync.</summary>
    private int _loadedDays = -1;

    /// <summary>
    /// True after <see cref="DisposeAsync"/> has run. The Radzen <c>Change</c> callback captured
    /// by the toolbar select-bar holds a <c>DotNetObjectReference</c> the JS module can still
    /// call into for a frame or two after disposal, which surfaced in the console as
    /// *"There is no tracked object with id '6'"*. Every async continuation early-exits on this
    /// flag instead of touching torn-down state.
    /// </summary>
    private bool _disposed;

    /// <summary>
    /// Series colours for the chart. These are Radzen Stroke/Fill parameter values — attribute
    /// content, not CSS — so they cannot be `var(--series-N)` and stay as literals.
    ///
    /// Realigned onto the same eight hues as the shared --series-* tokens (app.css) so the chart
    /// line, the legend swatch in the grid and the progress bar for a given author are the same
    /// colour. Previously this list and the stylesheet held two unrelated palettes that merely
    /// happened to be indexed the same way.
    /// </summary>
    private static readonly string[] _colors =
        { "#5b3df5", "#d46ae8", "#ff7a59", "#ffb84d", "#f95d9b", "#34c3b3", "#5aa9ff", "#9b7bff" };

    /// <summary>The five plotted authors. Ordering and Take were repeated three times inline.</summary>
    private IEnumerable<ContributorStatsDto> TopContributors =>
        (_contributors ?? []).OrderByDescending(c => c.TotalLinesAdded).Take(5);


    private static string DisplayName(ContributorStatsDto contributor) =>
        string.IsNullOrWhiteSpace(contributor.AuthorName) ? "(Unknown)" : contributor.AuthorName;

    /// <summary>
    /// Loads on first set and on every subsequent change of <see cref="Days"/>. Replaces an
    /// OnInitializedAsync + local range selector; the range belongs to the page now.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedDays == Days) return;
        _loadedDays = Days;
        await LoadContributorStats();
    }

    private async Task LoadContributorStats()
    {
        if (_disposed) return;

        _isLoading = true;
        _chartError = string.Empty;
        StateHasChanged();

        try
        {
            _contributors = await Http.GetAppJsonAsync($"/api/repositories/{RepositoryId}/contributors/{Days}?topN=10", AppJsonSerializerContext.Default.ListContributorStatsDto);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading contributor stats for repository {RepositoryId}", RepositoryId);
            _chartError = $"Error loading contributor data: {ex.Message}";
        }
        finally
        {
            // Guarded rather than an early `return`: control cannot leave a finally block
            // (CS0157). Same intent — do not touch component state after disposal.
            if (!_disposed)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void OnStackedChanged(bool stacked)
    {
        if (_disposed) return;
        _stacked = stacked;
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return ValueTask.CompletedTask;
    }

    private string GetColorForAuthor(string authorName)
    {
        var index = Math.Abs(authorName.GetHashCode()) % _colors.Length;
        return _colors[index];
    }

    /// <summary>
    /// Rule 4.3 — swatches and bars used to receive their colour through an interpolated inline
    /// style. The palette is a fixed list, so the hash maps to a modifier class and the colours
    /// live in ContributorChart.razor.css (kept in step with <see cref="_colors"/>).
    /// </summary>
    private static string GetAuthorColorClass(string authorName) =>
        $"cc-swatch--{Math.Abs(authorName.GetHashCode()) % _colors.Length}";
}
