@* MockDataBanner — rendered when FeatureFlags:EnableMockDataForTesting is true.
   Per requirement §10: "If using mock data then alert user by stating MOCK DATA at the top of the page"
   Strategy Pattern (GoF): the flag acts as a runtime strategy switch between real and mock data sources.
   Rule 4.3 — all styling lives in MockDataBanner.razor.css. *@

@if (IsMockData)
{
    <div class="mock-data-banner" role="alert" aria-live="polite">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" JustifyContent="JustifyContent.Center">
            <RadzenIcon Icon="science" />
            <strong>MOCK DATA</strong>
            <span>— This page is displaying simulated data. Real services are not being called.</span>
        </RadzenStack>
    </div>
}

@code {
    /// <summary>
    /// When true the banner is displayed. Bind this to the FeatureFlags:EnableMockDataForTesting
    /// configuration value resolved by the parent page.
    /// </summary>
    [Parameter] public bool IsMockData { get; set; }
}
