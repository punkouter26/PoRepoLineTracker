@using PoRepoLineTracker.Domain.Models
@using Radzen
@using Radzen.Blazor

@* PocketView: Mobile-optimized repository summary card *@

<div class="mobile-repo-card" @onclick="NavigateToDetail">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        @* Repo icon *@
        <div class="mobile-repo-icon">
            <RadzenIcon Icon="code" class="mrc-icon" />
        </div>

        @* Repo info *@
        <RadzenStack Gap="0.1rem" class="mrc-info">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="mrc-name">
                @Repo.Owner/@Repo.Name
            </RadzenText>
            @if (Repo.LastAnalyzedCommitDate.HasValue)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="mrc-analyzed">
                    Analyzed @ToRelativeTime(Repo.LastAnalyzedCommitDate)
                </RadzenText>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Caption" class="mrc-unanalyzed">
                    Not yet analyzed
                </RadzenText>
            }
        </RadzenStack>

        @* Key metrics *@
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            @if (LineCount > 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.1rem" class="mrc-metric">
                    <RadzenText class="mrc-metric-value mrc-metric-value--lines">@FormatCompact(LineCount)</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="mrc-metric-label">lines</RadzenText>
                </RadzenStack>
            }
            @if (AiPercentage > 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.1rem" class="mrc-metric">
                    <RadzenText class="@($"mrc-metric-value {GetAiSeverityClass(AiPercentage)}")">@AiPercentage.ToString("F0")%</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="mrc-metric-label">AI</RadzenText>
                </RadzenStack>
            }
            <RadzenIcon Icon="chevron_right" class="mrc-chevron" />
        </RadzenStack>
    </RadzenStack>
</div>

@code {
    [Parameter, EditorRequired] public GitHubRepository Repo { get; set; } = default!;
    [Parameter] public int LineCount { get; set; }
    [Parameter] public double AiPercentage { get; set; }
    [Parameter] public EventCallback<GitHubRepository> OnClick { get; set; }

    private async Task NavigateToDetail()
    {
        await OnClick.InvokeAsync(Repo);
    }

    private static string ToRelativeTime(DateTime? dt)
    {
        if (!dt.HasValue) return string.Empty;
        var diff = DateTime.UtcNow - dt.Value.ToUniversalTime();
        if (diff.TotalHours < 1) return "just now";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 30) return $"{(int)(diff.TotalDays / 7)}w ago";
        return $"{(int)(diff.TotalDays / 30)}mo ago";
    }

    private static string FormatCompact(int count) => count switch
    {
        >= 1_000_000 => $"{count / 1_000_000.0:F1}M",
        >= 1_000 => $"{count / 1_000.0:F1}k",
        _ => count.ToString()
    };

    /// <summary>
    /// Rule 4.3 — the AI figure used to be coloured through an interpolated inline style. The
    /// thresholds are discrete, so they map to modifier classes and the colours live in CSS.
    /// </summary>
    private static string GetAiSeverityClass(double aiPercentage) => aiPercentage switch
    {
        >= 50 => "mrc-metric-value--ai-high",
        >= 25 => "mrc-metric-value--ai-elevated",
        >= 10 => "mrc-metric-value--ai-moderate",
        _ => "mrc-metric-value--ai-low"
    };
}
