@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="ghsel-row-mb1">
        <RadzenText TextStyle="TextStyle.H6" class="ghsel-heading">Select Repositories from Your GitHub Account</RadzenText>
        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                          Click="@(() => OnCancel.InvokeAsync())"
                          aria-label="Cancel and close repository picker" />
    </RadzenStack>

    @if (IsLoading)
    {
        <RadzenStack AlignItems="AlignItems.Center" class="rz-p-4">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2"><em>Loading your GitHub repositories...</em></RadzenText>
        </RadzenStack>
    }
    else if (Repositories.Any())
    {
        <RadzenStack class="ghsel-stack-mb1">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="ghsel-row-mb05">
                <RadzenText TextStyle="TextStyle.Caption">Found @Repositories.Count() repositories</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Select All" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => OnSelectAll.InvokeAsync())" />
                    <RadzenButton Text="Clear All" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => OnClearAll.InvokeAsync())" />
                </RadzenStack>
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ghsel-row-mb05">
                <RadzenIcon Icon="search" class="ghsel-search-icon" />
                <RadzenTextBox @bind-Value="_filterText" Placeholder="Filter or type owner/repo..." class="ghsel-filter" />
                @if (CanAddCustomRepo)
                {
                    <RadzenButton Text="Add" Icon="add" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                  Click="@AddCustomRepository" title="Add custom repository to list"
                                  aria-label="Add custom repository" />
                }
                @if (!string.IsNullOrEmpty(_filterText))
                {
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="@(() => _filterText = string.Empty)" title="Clear filter"
                                  aria-label="Clear filter text" />
                }
            </RadzenStack>

            <RadzenListBox Value="SelectedRepositories"
                           ValueChanged="OnSelectionChanged"
                           Multiple="true"
                           Data="FilteredRepositories"
                           TValue="IEnumerable<GitHubUserRepositoryDto>"
                           TextProperty="FullName"
                           class="ghsel-list" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="ghsel-row-mt1">
            <RadzenText TextStyle="TextStyle.Caption" class="ghsel-caption">
                @(SelectedRepositories.Count()) selected
            </RadzenText>
            <RadzenButton Text="Add Selected Repositories"
                          Icon="add_circle"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@OnAddSelectedClicked"
                          IsBusy="@IsSubmitting"
                          BusyText="Adding..."
                          Disabled="@(!SelectedRepositories.Any() || IsSubmitting)" />
        </RadzenStack>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
            <RadzenText TextStyle="TextStyle.Subtitle2">No Repositories Found</RadzenText>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <RadzenText>@ErrorMessage</RadzenText>
            }
            else
            {
                <RadzenText>No repositories were found in your GitHub account.</RadzenText>
            }
            <RadzenText TextStyle="TextStyle.Body2">
                <strong>Please ensure:</strong><br />
                * You have at least one repository created or forked in your GitHub account<br />
                * Your GitHub account has authorized repository access<br />
                * If using a server Personal Access Token (PAT), it has the required permissions (repo scope)
            </RadzenText>
            @if (OnRetry.HasDelegate)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3">
                    <RadzenButton Text="Retry"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Variant="Variant.Outlined"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnRetry.InvokeAsync())" />
                </RadzenStack>
            }
        </RadzenAlert>

        <RadzenCard class="rz-mt-3">
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle2">Track a Public Repository</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">Enter any public GitHub repository (e.g. <code>punkouter26/PoRepoLineTracker</code> or <code>dotnet/aspnetcore</code>):</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenTextBox @bind-Value="_manualRepoText" Placeholder="owner/repo" class="ghsel-filter" />
                    <RadzenButton Text="Add Repository" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@AddManualRepository" Disabled="@(!CanAddManualRepo)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenCard>

@code {
    [Parameter] public IEnumerable<GitHubUserRepositoryDto> Repositories { get; set; } = [];
    [Parameter] public IEnumerable<GitHubUserRepositoryDto> SelectedRepositories { get; set; } = [];
    [Parameter] public EventCallback<IEnumerable<GitHubUserRepositoryDto>> SelectedRepositoriesChanged { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnAddSelected { get; set; }
    [Parameter] public EventCallback OnSelectAll { get; set; }
    [Parameter] public EventCallback OnClearAll { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    private string _filterText = string.Empty;

    private IEnumerable<GitHubUserRepositoryDto> FilteredRepositories =>
        string.IsNullOrWhiteSpace(_filterText)
            ? Repositories
            : Repositories.Where(repository => repository.FullName.Contains(_filterText, StringComparison.OrdinalIgnoreCase));

    private Task OnSelectionChanged(IEnumerable<GitHubUserRepositoryDto> repositories)
    {
        return SelectedRepositoriesChanged.InvokeAsync(repositories);
    }

    private Task OnAddSelectedClicked()
    {
        return OnAddSelected.InvokeAsync();
    }

    private string _manualRepoText = string.Empty;

    private bool CanAddManualRepo
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_manualRepoText)) return false;
            var parts = _manualRepoText.Trim().Split('/', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 2;
        }
    }

    private async Task AddManualRepository()
    {
        if (!CanAddManualRepo) return;
        var trimmed = _manualRepoText.Trim();
        var parts = trimmed.Split('/', 2);
        var custom = new GitHubUserRepositoryDto
        {
            Owner = parts[0],
            Name = parts[1],
            FullName = $"{parts[0]}/{parts[1]}",
            CloneUrl = $"https://github.com/{parts[0]}/{parts[1]}.git",
            Description = "Custom public repository",
            IsPrivate = false,
            Language = "Various"
        };

        var currentList = Repositories.ToList();
        if (!currentList.Any(r => r.FullName.Equals(custom.FullName, StringComparison.OrdinalIgnoreCase)))
        {
            currentList.Insert(0, custom);
            Repositories = currentList;
        }

        var currentSelected = SelectedRepositories.ToList();
        if (!currentSelected.Any(r => r.FullName.Equals(custom.FullName, StringComparison.OrdinalIgnoreCase)))
        {
            currentSelected.Add(custom);
            await SelectedRepositoriesChanged.InvokeAsync(currentSelected);
        }

        _manualRepoText = string.Empty;
    }

    private bool CanAddCustomRepo
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filterText)) return false;
            var parts = _filterText.Trim().Split('/', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 2 && !Repositories.Any(r => r.FullName.Equals(_filterText.Trim(), StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task AddCustomRepository()
    {
        if (!CanAddCustomRepo) return;
        var trimmed = _filterText.Trim();
        var parts = trimmed.Split('/', 2);
        var custom = new GitHubUserRepositoryDto
        {
            Owner = parts[0],
            Name = parts[1],
            FullName = $"{parts[0]}/{parts[1]}",
            CloneUrl = $"https://github.com/{parts[0]}/{parts[1]}.git",
            Description = "Custom public repository",
            IsPrivate = false,
            Language = "Various"
        };

        var currentList = Repositories.ToList();
        currentList.Insert(0, custom);
        Repositories = currentList;

        var currentSelected = SelectedRepositories.ToList();
        if (!currentSelected.Any(r => r.FullName.Equals(custom.FullName, StringComparison.OrdinalIgnoreCase)))
        {
            currentSelected.Add(custom);
            await SelectedRepositoriesChanged.InvokeAsync(currentSelected);
        }

        _filterText = string.Empty;
    }
}