@using PoRepoLineTracker.Application.Models
@using Radzen
@using Radzen.Blazor

<RadzenCard Style="padding: 1.25rem 1.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" Style="margin-bottom: 1rem;">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 700;">AI-Generated Code Detection</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">
                Estimated percentage of AI-generated code per user over time
            </RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Range:</RadzenText>
            <RadzenSelectBar @bind-Value="_chartDays" TValue="int" Change="@OnChartRangeChanged" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Text="30d" Value="30" />
                    <RadzenSelectBarItem Text="90d" Value="90" />
                    <RadzenSelectBarItem Text="180d" Value="180" />
                    <RadzenSelectBarItem Text="1yr" Value="365" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </RadzenStack>

    @if (_isLoading)
    {
        <RadzenSkeleton Width="100%" Height="320px" />
    }
    else if (!string.IsNullOrEmpty(_chartError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true">
            @_chartError
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text"
                          Click="@LoadAiStats" Style="margin-left: 0.5rem;" />
        </RadzenAlert>
    }
    else if (_aiStats == null || !_aiStats.Any())
    {
        <RadzenStack AlignItems="AlignItems.Center" class="rz-p-8">
            <RadzenIcon Icon="smart_toy" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">No AI detection data yet.</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-disabled-color);">Re-analyze the repository to scan for AI patterns.</RadzenText>
        </RadzenStack>
    }
    else
    {
        @* Legend *@
        <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
            @foreach (var author in _aiStats.OrderByDescending(a => a.TotalCommits).Take(5))
            {
                var color = GetColorForAuthor(author.AuthorName);
                var displayName = string.IsNullOrWhiteSpace(author.AuthorName) ? "(Unknown)" : author.AuthorName;
                <div style="display: flex; align-items: center; gap: 0.35rem;">
                    <div style="width: 12px; height: 12px; border-radius: 2px; background: @color;"></div>
                    <span style="font-size: 0.85rem;">@displayName (@author.AverageAiPercentage.ToString("F1")%)</span>
                </div>
            }
        </div>

        @* Chart *@
        <RadzenChart Style="height: 320px; width: 100%;">
            @foreach (var author in _aiStats.OrderByDescending(a => a.TotalCommits).Take(5))
            {
                var color = GetColorForAuthor(author.AuthorName);
                var displayName = string.IsNullOrWhiteSpace(author.AuthorName) ? "(Unknown)" : author.AuthorName;
                <RadzenLineSeries Data="@author.CommitHistory"
                                  CategoryProperty="Date"
                                  ValueProperty="AiPercentage"
                                  Title="@displayName"
                                  Stroke="@color"
                                  StrokeWidth="2">
                    <RadzenMarkers MarkerType="MarkerType.Circle" />
                </RadzenLineSeries>
            }
            <RadzenCategoryAxis FormatString="{0:MM/dd/yy}">
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Min="0" Max="100" Step="25">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>

        @* Summary Table *@
        <div style="margin-top: 1.5rem;">
            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0 0 0.75rem 0; font-weight: 600;">Summary by Author</RadzenText>
            <RadzenDataGrid Data="@_aiStats.OrderByDescending(a => a.TotalCommits)" TItem="AiStatsByUserDto" Style="font-size: 0.85rem;">
                <Columns>
                    <RadzenDataGridColumn TItem="AiStatsByUserDto" Title="Author" Width="40%">
                        <Template Context="data">
                            @(string.IsNullOrWhiteSpace(data.AuthorName) ? "(Unknown)" : data.AuthorName)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AiStatsByUserDto" Property="TotalCommits" Title="Commits" Width="20%" />
                    <RadzenDataGridColumn TItem="AiStatsByUserDto" Property="AverageAiPercentage" Title="Avg AI %" Width="20%">
                        <Template Context="data">
                            <span style="color: @(GetAiColor(data.AverageAiPercentage)); font-weight: 600;">
                                @data.AverageAiPercentage.ToString("F1")%
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AiStatsByUserDto" Title="AI Level" Width="20%">
                        <Template Context="data">
                            @GetAiLevel(data.AverageAiPercentage)
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</RadzenCard>

@code {
    [Parameter] public Guid RepositoryId { get; set; }
    [Inject] HttpClient Http { get; set; } = null!;
    [Inject] ILogger<AiDetectionChart> Logger { get; set; } = null!;

    private List<AiStatsByUserDto>? _aiStats;
    private bool _isLoading = false;
    private string _chartError = string.Empty;
    private int _chartDays = 90;

    private static readonly string[] _colors = { "#3b82f6", "#ef4444", "#22c55e", "#f59e0b", "#8b5cf6", "#ec4899", "#14b8a6", "#f97316" };

    protected override async Task OnInitializedAsync()
    {
        await LoadAiStats();
    }

    private async Task LoadAiStats()
    {
        _isLoading = true;
        _chartError = string.Empty;
        StateHasChanged();

        try
        {
            _aiStats = await Http.GetFromJsonAsync<List<AiStatsByUserDto>>($"/api/repositories/{RepositoryId}/ai-stats/{_chartDays}");
            
            if (_aiStats == null || !_aiStats.Any())
            {
                _chartError = "No AI detection data found. Re-analyze the repository to scan for AI patterns.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading AI stats for repository {RepositoryId}", RepositoryId);
            _chartError = $"Error loading AI data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnChartRangeChanged(int days)
    {
        _chartDays = days;
        await LoadAiStats();
    }

    private string GetColorForAuthor(string authorName)
    {
        var index = Math.Abs(authorName.GetHashCode()) % _colors.Length;
        return _colors[index];
    }

    private static string GetAiColor(double percentage)
    {
        if (percentage < 20) return "#22c55e"; // Green - likely human
        if (percentage < 50) return "#f59e0b"; // Yellow - mixed
        if (percentage < 75) return "#f97316"; // Orange - likely AI
        return "#ef4444"; // Red - highly likely AI
    }

    private static string GetAiLevel(double percentage)
    {
        if (percentage < 20) return "🟢 Low (Human)";
        if (percentage < 50) return "🟡 Medium";
        if (percentage < 75) return "🟠 High";
        return "🔴 Very High";
    }
}
