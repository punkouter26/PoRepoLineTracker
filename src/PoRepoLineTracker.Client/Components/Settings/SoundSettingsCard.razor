@inject AudioService Audio
@using PoRepoLineTracker.Client.Services
@using Radzen
@using Radzen.Blazor

@* Audio preferences.

   Everything here is stored in localStorage by audio.js, NOT in the user preferences API, and
   deliberately so: whether sound is wanted is a property of the machine in front of you (the one
   with speakers, versus the one in a shared office), not of the account. Round-tripping a mute
   toggle through the server would also put a network call on the path of the control a user
   reaches for precisely when they want the noise to stop NOW.

   Sound is OFF until switched on. A dashboard that starts making noise on first load is a bug
   report — the browser's own autoplay policy exists because of that pattern. *@

<RadzenCard class="sound-card u-glass">
    <RadzenStack Gap="1rem">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" class="sound-card__title">Sound &amp; motion</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="sound-card__subtitle">
                Audio feedback for clicks, alerts and analysis progress. Stored on this device.
            </RadzenText>
        </RadzenStack>

        @if (!Audio.Supported)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                This browser has no Web Audio support, so sound is unavailable.
            </RadzenAlert>
        }
        else
        {
            <div class="sound-row">
                <label class="sound-row__label" for="sound-enabled">
                    <span class="sound-row__name">Interface sounds</span>
                    <span class="sound-row__hint">Clicks, toggles, and navigation</span>
                </label>
                <RadzenSwitch @bind-Value="@_enabled" Change="@OnEnabledChanged"
                              InputAttributes="@(new Dictionary<string, object> { { "id", "sound-enabled" }, { "aria-label", "Interface sounds" } })" />
            </div>

            @* The volume and ambient controls are gated on the master switch rather than merely
               dimmed: adjusting a volume that is muted does nothing audible, and a control that
               responds without any observable effect reads as broken. *@
            @if (_enabled)
            {
                @* A <span>, not a <label for>. RadzenSlider exposes no InputAttributes, so there
                   is no way to put a matching id on the element it actually renders — and a
                   `for` pointing at an id that does not exist is worse than no label at all: a
                   screen reader announces the control as unlabelled either way, but the broken
                   association also silently kills the click-to-focus behaviour. The accessible
                   name comes from aria-label on the component instead, which splats through
                   RadzenComponent's unmatched-attribute capture. *@
                <div class="sound-row sound-row--stack u-enter">
                    <span class="sound-row__label">
                        <span class="sound-row__name">Volume</span>
                        <span class="sound-row__hint">@(((int)(_volume * 100)))%</span>
                    </span>
                    <RadzenSlider @bind-Value="@_volume" TValue="double" Min="0" Max="1" Step="0.05"
                                  Change="@OnVolumeChanged" class="sound-row__slider"
                                  aria-label="Volume" />
                </div>

                <div class="sound-row u-enter">
                    <label class="sound-row__label" for="sound-ambient">
                        <span class="sound-row__name">Ambient background</span>
                        <span class="sound-row__hint">A quiet generative pad while the app is open</span>
                    </label>
                    <RadzenSwitch @bind-Value="@_ambient" Change="@OnAmbientChanged"
                                  InputAttributes="@(new Dictionary<string, object> { { "id", "sound-ambient" }, { "aria-label", "Ambient background" } })" />
                </div>

                @if (_ambient)
                {
                    <div class="sound-row sound-row--stack u-enter">
                        <span class="sound-row__label">
                            <span class="sound-row__name">Ambient level</span>
                            <span class="sound-row__hint">@(((int)(_ambientVolume * 100)))%</span>
                        </span>
                        @* Max 0.5, not 1. This is a background bed under everything else; at full
                           master gain it would sit on top of the cues it is meant to sit beneath.
                           `0.5m` explicitly: Min/Max are decimal, and a bare `0.5` in a Razor
                           attribute is a double literal with no implicit conversion. *@
                        <RadzenSlider @bind-Value="@_ambientVolume" TValue="double" Min="0" Max="@(0.5m)" Step="0.02"
                                      Change="@OnAmbientVolumeChanged" class="sound-row__slider"
                                      aria-label="Ambient level" />
                    </div>
                }

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap"
                             class="sound-card__preview">
                    <RadzenText TextStyle="TextStyle.Caption" class="sound-card__preview-label">Preview</RadzenText>
                    <RadzenButton Text="Success" Icon="check_circle" Size="ButtonSize.Small"
                                  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Success"
                                  Click="@(() => Audio.PlayAsync(Cue.Success))" />
                    <RadzenButton Text="Alert" Icon="error" Size="ButtonSize.Small"
                                  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger"
                                  Click="@(() => Audio.PlayAsync(Cue.Error))" />
                    <RadzenButton Text="Progress" Icon="graphic_eq" Size="ButtonSize.Small"
                                  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Info"
                                  Click="@(() => Audio.PlayAsync(Cue.Start))" />
                </RadzenStack>
            }

            <RadzenText TextStyle="TextStyle.Caption" class="sound-card__note">
                Motion follows your system “reduce motion” setting — animated backdrops and
                transitions switch off automatically when it is on.
            </RadzenText>
        }
    </RadzenStack>
</RadzenCard>

@code {
    // Local mirrors of the service state. @bind-Value needs a settable field, and binding straight
    // to the service's properties would make them public setters on what is otherwise a
    // JS-authoritative store.
    private bool _enabled;
    private double _volume = 0.5;
    private bool _ambient;
    private double _ambientVolume = 0.18;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // MainLayout normally initialises the service before this card is reachable, but a deep
        // link straight to /settings can render it first. InitializeAsync is idempotent and only
        // re-reads localStorage, so calling it again costs one interop round trip.
        await Audio.InitializeAsync();

        _enabled = Audio.Enabled;
        _volume = Audio.Volume;
        _ambient = Audio.Ambient;
        _ambientVolume = Audio.AmbientVolume;

        StateHasChanged();
    }

    /// <summary>
    /// This handler is the one place in the app that can legitimately start audio: it runs inside
    /// a real click, which is what the autoplay policy requires to resume a suspended context.
    /// <see cref="AudioService.SetEnabledAsync"/> unlocks and plays a confirmation from here.
    /// </summary>
    private async Task OnEnabledChanged(bool value)
    {
        _enabled = value;
        await Audio.SetEnabledAsync(value);

        // Re-applied on enable: switching the master off suspends the context, which does not
        // stop the ambient bed so much as freeze it. Turning sound back on with an ambient
        // preference of true has to restart the voices, not just unmute them.
        if (value && _ambient) await Audio.SetAmbientAsync(true);
    }

    private async Task OnVolumeChanged(double value)
    {
        _volume = value;
        await Audio.SetVolumeAsync(value);

        // Audible reference for what was just set. Without it the slider is silent until the
        // user next clicks something, which makes calibrating it guesswork.
        await Audio.PlayAsync(Cue.Tick);
    }

    private async Task OnAmbientChanged(bool value)
    {
        _ambient = value;
        await Audio.SetAmbientAsync(value);
    }

    private async Task OnAmbientVolumeChanged(double value)
    {
        _ambientVolume = value;
        await Audio.SetAmbientVolumeAsync(value);
    }
}
