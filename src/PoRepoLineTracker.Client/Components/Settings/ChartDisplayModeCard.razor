@inject UserPreferencesClient PreferencesClient
@inject NotificationService NotificationService
@inject ILogger<ChartDisplayModeCard> Logger
@using PoRepoLineTracker.Client.Services
@using PoRepoLineTracker.Shared.Domain
@using Radzen
@using Radzen.Blazor

@* Renders through <ChartCard> (Rule 4.3 consolidation). The surface, the title/description pair
   and the right-aligned toolbar row were a third re-implementation of chrome ChartCard already
   owns; the chart-display-card__* rules that styled them are gone with it. *@
<ChartCard Title="@Title" Description="@Description">
    <Toolbar>
        <RadzenSelectBar TValue="ChartDisplayMode" Value="@_value" Change="OnChange" Size="ButtonSize.Small" Disabled="@_isSaving"
                         aria-label="Chart display mode">
            <Items>
                <RadzenSelectBarItem Text="True Data" Value="ChartDisplayMode.TrueData" />
                <RadzenSelectBarItem Text="Moving Average" Value="ChartDisplayMode.MovingAverage" />
            </Items>
        </RadzenSelectBar>
        @if (_isSaving)
        {
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Size="ProgressBarCircularSize.ExtraSmall" />
        }
    </Toolbar>
</ChartCard>

@code {
    // No ValueChanged callback. This card writes the preference and nothing else; pages that
    // render charts read the value from UserPreferencesClient and subscribe to its Changed
    // event, so there is exactly one place the mode is stored and one place it is edited.
    [Parameter] public string Title { get; set; } = "Chart Display";
    [Parameter] public string? Description { get; set; }

    private UserPreferences _preferences = new();
    private ChartDisplayMode _value = ChartDisplayMode.TrueData;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _preferences = await PreferencesClient.GetAsync();
            _value = _preferences.ChartDisplayMode;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load chart display mode preference. Using true data.");
            _value = ChartDisplayMode.TrueData;
        }
    }

    private async Task OnChange(ChartDisplayMode chartDisplayMode)
    {
        var previousValue = _value;
        _value = chartDisplayMode;
        _isSaving = true;
        StateHasChanged();

        try
        {
            _preferences = await PreferencesClient.SaveAsync(_preferences with
            {
                ChartDisplayMode = chartDisplayMode,
                LastUpdated = DateTime.UtcNow
            });
        }
        catch (Exception ex)
        {
            _value = previousValue;
            Logger.LogError(ex, "Failed to save chart display mode preference {ChartDisplayMode}", chartDisplayMode);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Preference Not Saved",
                Detail = "Could not save chart display mode. Reverting to the previous option.",
                Duration = 5000
            });
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}