@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Domain
@using Radzen
@using Radzen.Blazor

<ChartCard Title="All Repositories — Growth Overview"
           Description="@ChartDescription"
           IsLoading="@IsLoading"
           ErrorMessage="@ErrorMessage"
           OnRetry="@OnRetry"
           IsEmpty="@(!GetDisplayedHistoryData().Any(r => r.DailyLineCounts.Any()))"
           EmptyIcon="show_chart"
           EmptyText="No history data yet"
           EmptyHint="Analysis is needed for at least one repository.">
    <Toolbar>
        <ChartRangeSelector Days="@Days" DaysChanged="@DaysChanged" />
    </Toolbar>
    <ChildContent>
        @{
            var available = GetDisplayedHistoryData().Where(r => r.DailyLineCounts.Any()).ToList();
            var plottedRepos = available.Where(r => IsSelected(r.RepositoryId)).ToList();
        }

        <RadzenChart>
            @for (var index = 0; index < plottedRepos.Count; index++)
            {
                var repo = plottedRepos[index];
                // Colour is keyed to the repo's position in the FULL list, not the plotted one,
                // so unticking a repo does not recolour every series after it.
                var seriesColor = GetSeriesColor(PaletteIndex(available, repo.RepositoryId));
                var seriesTitle = $"{repo.Owner}/{repo.RepositoryName}";

                <RadzenLineSeries Data="@repo.DailyLineCounts.ToList()"
                                  CategoryProperty="Date"
                                  ValueProperty="TotalLines"
                                  Title="@seriesTitle"
                                  Stroke="@seriesColor"
                                  StrokeWidth="2">
                    <TooltipTemplate Context="point">
                        @if (point is DailyLineCountDto day)
                        {
                            <div class="arc-tip">
                                <div class="arc-tip__title">@seriesTitle</div>
                                <div class="arc-tip__meta">@day.Date.ToString("MMM dd, yyyy")</div>
                                <div class="arc-tip__value">
                                    <span class="arc-tip__label">@($"{TooltipValueLabel}:")</span> @day.TotalLines.ToString("N0")
                                </div>
                            </div>
                        }
                    </TooltipTemplate>
                    <ChildContent>
                        <RadzenMarkers MarkerType="MarkerType.None" />
                    </ChildContent>
                </RadzenLineSeries>
            }

            @* A whole-day Step keeps every label distinct and bounded in number — see
               ChartFormat.DateAxisStep for why neither the default nor TickDistance suffices.
               LabelAutoRotation angles what is left so labels do not collide at narrow widths. *@
            <RadzenCategoryAxis FormatString="{0:MMM d}"
                                Step="@ChartFormat.DateAxisStep(plottedRepos.SelectMany(r => r.DailyLineCounts).Select(d => d.Date))"
                                LabelAutoRotation="-45">
                <RadzenAxisTitle Text="Date" />
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines">
                <RadzenAxisTitle Text="Lines of Code" />
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Visible="false" />
            @* No class= here: RadzenChartTooltipOptions is a config component, not a rendered
               element — it declares no [Parameter] named "class" and does not capture unmatched
               attributes, so passing one threw InvalidOperationException and killed the render
               tree. Tooltip styling lives on .arc-tip inside the tooltip template instead. *@
            <RadzenChartTooltipOptions Shared="false" />
        </RadzenChart>

        @* ─── Legend as selector ───────────────────────────────────────────────────
           The legend used to be a static list of every repo, which is exactly the control the
           chart needed and did not have: past about six series the lines are unreadable and there
           was no way to narrow them. Each entry is a real <button> with aria-pressed, so it is
           tab-reachable and its state is announced rather than only shown by opacity. *@
        <div class="arc-legend">
            @for (var index = 0; index < available.Count; index++)
            {
                var repo = available[index];
                var swatchClass = GetSeriesColorClass(index);
                var selected = IsSelected(repo.RepositoryId);
                var label = $"{repo.Owner}/{repo.RepositoryName}";

                <button type="button"
                        class="@($"arc-legend__item {(selected ? "arc-legend__item--on" : "arc-legend__item--off")}")"
                        aria-pressed="@selected"
                        title="@(selected ? $"Hide {label}" : $"Show {label}")"
                        @onclick="@(() => ToggleRepository(repo.RepositoryId))">
                    <span class="arc-legend__swatch @swatchClass"></span>
                    <span class="arc-legend__label">@label</span>
                </button>
            }

            @if (available.Count > 1)
            {
                <RadzenButton Text="@(_hidden.Count == 0 ? "Clear all" : "Select all")"
                              ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                              Click="@ToggleAll" class="arc-legend__bulk" />
            }
        </div>

        @if (plottedRepos.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="arc-none">
                No repositories selected — pick one above to plot it.
            </RadzenText>
        }
    </ChildContent>
</ChartCard>

@code {
    /// <summary>
    /// The page's full history, one entry per repository. The chart no longer fetches: it used
    /// to request <c>allcharts/90</c> itself while the page had already loaded the history
    /// for the totals, so every visit paid for the same aggregation twice. The range selector
    /// now just narrows this in <see cref="GetDisplayedHistoryData"/>.
    /// </summary>
    [Parameter] public IReadOnlyList<RepositoryLineCountHistoryDto>? History { get; set; }

    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    /// <summary>The plotted range. Owned by the page, which keeps it in the query string.</summary>
    [Parameter] public int Days { get; set; } = ChartFormat.DefaultRangeDays;
    [Parameter] public EventCallback<int> DaysChanged { get; set; }

    /// <summary>
    /// Deselected repositories, rather than selected ones. Tracking the exclusions means a
    /// repository added after the page loaded shows up plotted instead of silently missing from a
    /// selection set that predates it.
    /// </summary>
    private readonly HashSet<RepositoryId> _hidden = [];

    private bool IsSelected(RepositoryId id) => !_hidden.Contains(id);

    private void ToggleRepository(RepositoryId id)
    {
        if (!_hidden.Remove(id)) _hidden.Add(id);
    }

    private void ToggleAll()
    {
        if (_hidden.Count == 0)
        {
            foreach (var repo in History ?? []) _hidden.Add(repo.RepositoryId);
        }
        else
        {
            _hidden.Clear();
        }
    }

    private const string ChartDescription = "Lines of code over time across every tracked repo";
    private const string TooltipValueLabel = "Lines";

    /// <summary>
    /// <see cref="History"/> narrowed to the selected range. Whole days from midnight UTC, which
    /// is the bucket the server puts a commit in — so the boundary day is kept rather than cut
    /// at the current time of day.
    /// </summary>
    private List<RepositoryLineCountHistoryDto> GetDisplayedHistoryData()
    {
        var cutoff = DateTime.UtcNow.Date.AddDays(-Days);
        return (History ?? []).Select(r => new RepositoryLineCountHistoryDto
        {
            RepositoryId = r.RepositoryId,
            RepositoryName = r.RepositoryName,
            Owner = r.Owner,
            TotalLines = r.TotalLines,
            DailyLineCounts = r.DailyLineCounts.Where(d => d.Date >= cutoff).ToList()
        }).ToList();
    }

    /// <summary>Position in the full repo list, so a series keeps its colour when others are hidden.</summary>
    private static int PaletteIndex(List<RepositoryLineCountHistoryDto> all, RepositoryId id) =>
        Math.Max(0, all.FindIndex(r => r.RepositoryId == id));

    /// <summary>A <c>var(--series-N)</c> reference — see <see cref="SeriesPalette"/>.</summary>
    private static string GetSeriesColor(int index) => SeriesPalette.Color(index);

    /// <summary>
    /// The legend swatch used to receive its colour through an interpolated inline
    /// style. The slot maps to a modifier class instead, backed by the same --series-N tokens the
    /// chart line reads.
    /// </summary>
    private static string GetSeriesColorClass(int index) =>
        SeriesPalette.ModifierClass("arc-legend__swatch", index);
}
