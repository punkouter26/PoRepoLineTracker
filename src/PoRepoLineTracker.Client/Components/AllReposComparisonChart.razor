@inject HttpClient Http
@inject ILogger<AllReposComparisonChart> Logger
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Domain.Models
@using Radzen
@using Radzen.Blazor

<RadzenCard class="arc-card">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="arc-toolbar">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" class="arc-title">All Repositories — Growth Overview</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="arc-description">@ChartDescription</RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Caption" class="arc-caption">Range:</RadzenText>
            <RadzenSelectBar @bind-Value="_days" TValue="int" Change="@OnRangeChanged" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Text="30d" Value="30" />
                    <RadzenSelectBarItem Text="90d" Value="90" />
                    <RadzenSelectBarItem Text="180d" Value="180" />
                    <RadzenSelectBarItem Text="1yr" Value="365" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>
    </RadzenStack>

    @if (_isLoading)
    {
        <RadzenStack Gap="0.5rem">
            <RadzenSkeleton Width="100%" Height="280px" />
        </RadzenStack>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            @_errorMessage
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text"
                          Click="@(() => LoadData(_days))" class="arc-refresh" />
        </RadzenAlert>
    }
    else if (_historyData == null || !_historyData.Any(r => r.DailyLineCounts.Any()))
    {
        <RadzenStack AlignItems="AlignItems.Center" class="arc-empty">
            <RadzenIcon Icon="show_chart" class="arc-empty-icon" />
            <RadzenText TextStyle="TextStyle.Body1" class="arc-empty-text">No history data yet — analysis is needed for at least one repository.</RadzenText>
        </RadzenStack>
    }
    else
    {
        var plottedRepos = GetDisplayedHistoryData().Where(r => r.DailyLineCounts.Any()).ToList();

        <RadzenChart class="arc-chart">
            @for (var index = 0; index < plottedRepos.Count; index++)
            {
                var repo = plottedRepos[index];
                // Stroke is a Radzen parameter, not CSS — it stays a colour value.
                var seriesColor = GetSeriesColor(index);

                <RadzenLineSeries Data="@repo.DailyLineCounts.ToList()"
                                  CategoryProperty="Date"
                                  ValueProperty="TotalLines"
                                  Title="@($"{repo.Owner}/{repo.RepositoryName}")"
                                  Stroke="@seriesColor"
                                  StrokeWidth="2">
                    <TooltipTemplate Context="point">
                        @if (point is DailyLineCountDto day)
                        {
                            <div class="arc-tip">
                                <div class="arc-tip__title">
                                    @($"{repo.Owner}/{repo.RepositoryName}")
                                </div>
                                <div class="arc-tip__meta">
                                    @day.Date.ToString("MMM dd, yyyy")
                                </div>
                                <div class="arc-tip__value">
                                    <span class="arc-tip__label">@($"{TooltipValueLabel}:")</span> @day.TotalLines.ToString("N0")
                                </div>
                            </div>
                        }
                    </TooltipTemplate>
                    <ChildContent>
                        <RadzenMarkers MarkerType="MarkerType.None" />
                    </ChildContent>
                </RadzenLineSeries>
            }
            <RadzenCategoryAxis FormatString="{0:MM/dd}">
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Min="0" Formatter="@FormatLines">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenLegend Visible="false" />
            @* No class= here: RadzenChartTooltipOptions is a config component, not a rendered
               element — it declares no [Parameter] named "class" and does not capture unmatched
               attributes, so passing one threw InvalidOperationException and killed the render
               tree. Tooltip styling lives on .arc-tip inside the tooltip template instead. *@
            <RadzenChartTooltipOptions Shared="false" />
        </RadzenChart>

        <div class="arc-legend">
            @for (var index = 0; index < plottedRepos.Count; index++)
            {
                var repo = plottedRepos[index];
                var swatchClass = GetSeriesColorClass(index);

                <div class="arc-legend__item">
                    <span class="arc-legend__swatch @swatchClass"></span>
                    <span class="arc-legend__label">@($"{repo.Owner}/{repo.RepositoryName}")</span>
                </div>
            }
        </div>
    }
</RadzenCard>

@code {
    [Parameter] public ChartDisplayMode ChartDisplayMode { get; set; } = ChartDisplayMode.TrueData;

    private int _days = 90;
    private bool _isLoading = false;
    private string? _errorMessage;
    private List<RepositoryLineCountHistoryDto>? _historyData;
    private static readonly string[] _seriesPalette =
    [
        "#5b3df5",
        "#d46ae8",
        "#ff7a59",
        "#ffb84d",
        "#f95d9b",
        "#34c3b3",
        "#5aa9ff",
        "#9b7bff",
        "#8bc34a",
        "#ffd54f",
        "#ec407a",
        "#26a69a"
    ];

    protected override async Task OnInitializedAsync()
    {
        // Lazy-load on first range click rather than every page load.
        // With 1 repo the chart fetches ~140 commits; with 50+ repos this
        // would dominate the page-render network budget. The default 90d
        // range renders only when the user actively opts into it.
    }

    private async Task OnRangeChanged(int days)
    {
        _days = days;
        await LoadData(days);
    }

    /// <summary>Triggers the default 90d load on first paint. Called once by the
    /// parent after the page has rendered so the user sees a chart without a
    /// blocking request during initial component initialization.</summary>
    public Task PrimeAsync() => LoadData(_days);

    /// <summary>
    /// Reloads the chart for the current range. Called by the parent page when a
    /// repository finishes analyzing so the growth overview refreshes automatically.
    /// </summary>
    public Task ReloadAsync() => LoadData(_days);

    private async Task LoadData(int days)
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<List<RepositoryLineCountHistoryDto>>($"/api/repositories/allcharts/{days}");
            _historyData = result ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AllReposComparisonChart: failed to load data for {Days} days", days);
            _errorMessage = "Could not load chart data. Please try again.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string ChartDescription => ChartDisplayMode == ChartDisplayMode.MovingAverage
        ? "Rolling 90-day moving average of lines of code across every tracked repo"
        : "Lines of code over time across every tracked repo";

    private string TooltipValueLabel => ChartDisplayMode == ChartDisplayMode.MovingAverage ? "90d avg" : "Lines";

    private List<RepositoryLineCountHistoryDto> GetDisplayedHistoryData()
    {
        return (_historyData ?? [])
            .Select(repo => new RepositoryLineCountHistoryDto
            {
                RepositoryId = repo.RepositoryId,
                RepositoryName = repo.RepositoryName,
                Owner = repo.Owner,
                DailyLineCounts = DailyLineCountChartTransformations.TransformForDisplay(repo.DailyLineCounts, ChartDisplayMode)
            })
            .ToList();
    }

    private string FormatLines(object value)
    {
        if (value is double d)
        {
            if (d >= 1_000_000) return $"{d / 1_000_000:F1}M";
            if (d >= 1_000) return $"{d / 1_000:F0}k";
            return d.ToString("N0");
        }
        return value?.ToString() ?? string.Empty;
    }

    private static string GetSeriesColor(int index) => _seriesPalette[index % _seriesPalette.Length];

    /// <summary>
    /// Rule 4.3 — the legend swatch used to receive its colour through an interpolated inline
    /// style. The palette is a fixed list, so the index maps to a modifier class and the colours
    /// live in AllReposComparisonChart.razor.css (kept in step with <see cref="_seriesPalette"/>).
    /// </summary>
    private static string GetSeriesColorClass(int index) =>
        $"arc-legend__swatch--{index % _seriesPalette.Length}";
}
