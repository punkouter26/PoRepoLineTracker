@inject IJSRuntime JS
@implements IAsyncDisposable

@* Invisible provider: renders no markup of its own. A parent page holds a @ref and calls
   CelebrateAsync when a tracked total crosses a round-number milestone (see
   Repositories.razor.cs), instead of every page that wants a celebration re-importing the JS
   module and re-writing the "did we already celebrate this one" bookkeeping. *@

@code {
    private IJSObjectReference? _module;

    public async Task CelebrateAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/milestone-confetti.js");
        await _module.InvokeVoidAsync("burst");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Navigating away mid-burst tears down the JS side first; nothing left to dispose.
        }
    }
}
