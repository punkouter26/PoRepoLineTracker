@* First-run onboarding block: a 3-step visual ("connect → analyse → track") plus a
   single CTA. Lives in Shared/ so any dashboard can show it to a brand-new user instead of
   the bare "Nothing to summarise yet" empty state — landing on /insights with zero
   repositories should still tell the user where to start.

   Rooted at a plain <div> so this file's scope id has a host: every rule in the stylesheet
   targets Radzen-rendered descendants and compiles to `[scope] .x`. *@
@using PoRepoLineTracker.Client.Components.Shared
@using Radzen
@using Radzen.Blazor

<div class="onboarding">
    <RadzenCard class="onboarding__card">
        <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem">
            <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenIcon Icon="code" class="onboarding__icon" />
                <RadzenText TextStyle="TextStyle.H5" class="onboarding__title">@Title</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="onboarding__lede">@Lede</RadzenText>
            </RadzenStack>

            <div class="onboarding__steps">
                @for (var i = 0; i < Steps.Count; i++)
                {
                    var s = Steps[i];
                    <div class="onboarding-step">
                        <div class="onboarding-step-icon">
                            <RadzenIcon Icon="@s.Icon" />
                        </div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="onboarding-step__title">@s.Title</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="onboarding-step__caption">@s.Caption</RadzenText>
                    </div>

                    @* Connector after each step except the last. *@
                    @if (i < Steps.Count - 1)
                    {
                        <div class="onboarding-connector" aria-hidden="true"></div>
                    }
                }
            </div>

            <RadzenButton Text="@CtaText"
                          Icon="@CtaIcon"
                          ButtonStyle="ButtonStyle.Primary"
                          class="onboarding-cta-pulse onboarding__cta"
                          Click="@(() => OnClick.InvokeAsync())" />
        </RadzenStack>
    </RadzenCard>
</div>

@code {
    /// <summary>Headline; "No repositories yet" on the repositories page.</summary>
    [Parameter] public string Title { get; set; } = "No repositories yet";

    /// <summary>Body sentence under the title.</summary>
    [Parameter] public string Lede { get; set; } = "Add your first GitHub repository and start tracking lines of code over time.";

    /// <summary>Three short steps shown under the title. Defaults to the original repositories flow.</summary>
    [Parameter] public IReadOnlyList<OnboardingStep> Steps { get; set; } = OnboardingStep.RepositoriesDefault;

    /// <summary>Primary button label.</summary>
    [Parameter] public string CtaText { get; set; } = "Get All My Repositories";

    /// <summary>Primary button icon.</summary>
    [Parameter] public string CtaIcon { get; set; } = "cloud_download";

    /// <summary>Opens the appropriate dialog; owned by the page, which also reloads on completion.</summary>
    [Parameter] public EventCallback OnClick { get; set; }
}