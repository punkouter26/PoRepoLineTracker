@inject HttpClient Http
@inject ILogger<TopFilesDialog> Logger
@using PoRepoLineTracker.Shared.Models.Dtos

@* Rule 4.3 — the wrapper <div> is this component's CSS-isolation anchor for ::deep rules. *@
<div class="top-files-dialog">
@if (_isLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="top-files-dialog__loading">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <RadzenText>Loading top files...</RadzenText>
    </RadzenStack>
}
else if (_files != null && _files.Any())
{
    <RadzenDataGrid Data="@_files" TItem="TopFileDto"
                    AllowPaging="true" PageSize="20"
                    PagerPosition="PagerPosition.Bottom"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    class="top-files-dialog__grid">
        <Columns>
            <RadzenDataGridColumn TItem="TopFileDto" Title="#" Width="55px" Sortable="false">
                <Template Context="file">
                    <RadzenText class="top-files-dialog__rank">@(_files!.IndexOf(file) + 1)</RadzenText>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TopFileDto" Property="FileName" Title="File Name">
                <Template Context="file">
                    <span title="@file.FileName" class="top-files-dialog__filename">@file.FileName</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TopFileDto" Property="LineCount" Title="Lines" Width="110px" TextAlign="TextAlign.Right">
                <Template Context="file">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@file.LineCount.ToString("N0")" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-p-8">
        <RadzenIcon Icon="folder_off" class="top-files-dialog__empty-icon" />
        <RadzenText class="top-files-dialog__empty-text">No file data available. Try re-analyzing the repository first.</RadzenText>
    </RadzenStack>
}
</div>

@code {
    [Parameter, EditorRequired] public RepositoryId RepositoryId { get; set; }

    private List<TopFileDto>? _files;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _files = await Http.GetFromJsonAsync<List<TopFileDto>>($"/api/repositories/{RepositoryId}/top-files?count=100");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading top 100 files for repository {RepositoryId}", RepositoryId);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
