@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor

@* InstantReplay: Timeline scrubber that lets users "scrub through time" to see repo state at any date *@

<RadzenCard Style="padding: 1rem 1.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" Style="margin-bottom: 0.75rem;">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 700;">⏪ Timeline Scrubber</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">
                Drag to see repository state at any point in time
            </RadzenText>
        </RadzenStack>
        @if (_selectedDate.HasValue)
        {
            <RadzenButton Text="Reset" Icon="replay" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small" Click="@ResetScrubber" />
        }
    </RadzenStack>

    @if (DailyData == null || !DailyData.Any())
    {
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-disabled-color);">No history data available for timeline scrubbing.</RadzenText>
    }
    else
    {
        @* Timeline Slider *@
        <div style="margin-bottom: 1rem;">
            <RadzenSlider TValue="int" 
                          Min="@_minIndex" 
                          Max="@_maxIndex" 
                          Step="1"
                          @bind-Value="_scrubberIndex"
                          Change="@OnScrubberChanged"
                          Style="width: 100%;" />
        </div>

        @* Date markers *@
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1rem;">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                @(_dates.Any() ? _dates.First().ToString("MMM dd, yyyy") : "")
            </RadzenText>
            @if (_selectedDate.HasValue)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                             Text="@(_selectedDate.Value.ToString("MMM dd, yyyy"))" 
                             Style="font-size: 0.85rem;" />
            }
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                @(_dates.Any() ? _dates.Last().ToString("MMM dd, yyyy") : "")
            </RadzenText>
        </RadzenStack>

        @* Snapshot metrics at selected date *@
        @if (_snapshot != null)
        {
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2" Style="background: var(--rz-base-100); border-radius: 8px; text-align: center;">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">Total Lines</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; font-weight: 700; color: var(--rz-primary);">@_snapshot.TotalLines.ToString("N0")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2" Style="background: var(--rz-base-100); border-radius: 8px; text-align: center;">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">Commits</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; font-weight: 700;">@_snapshot.CommitCount</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2" Style="background: var(--rz-base-100); border-radius: 8px; text-align: center;">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">Lines Added</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; font-weight: 700; color: #22c55e;">+_snapshot.TotalLinesAdded.ToString("N0")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2" Style="background: var(--rz-base-100); border-radius: 8px; text-align: center;">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">AI %</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" Style="@($"margin: 0; font-weight: 700; color: {GetAiColor(_snapshot.AverageAiPercentage)};")">@_snapshot.AverageAiPercentage.ToString("F1")%</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            @* CommitTagger badges for this day *@
            @if (_snapshot.Tags.Any())
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Style="margin-top: 0.75rem;" Wrap="FlexWrap.Wrap">
                    @foreach (var tag in _snapshot.Tags.Distinct())
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@tag" Style="font-size: 0.75rem;" />
                    }
                </RadzenStack>
            }
        }
    }
</RadzenCard>

@code {
    /// <summary>
    /// The daily line count data to scrub through.
    /// </summary>
    [Parameter, EditorRequired] public List<DailyLineCountDto>? DailyData { get; set; }

    /// <summary>
    /// Event fired when the user scrubs to a new date.
    /// </summary>
    [Parameter] public EventCallback<DateTime?> OnDateSelected { get; set; }

    private int _scrubberIndex;
    private int _minIndex;
    private int _maxIndex;
    private List<DateTime> _dates = new();
    private DateTime? _selectedDate;
    private DailyLineCountDto? _snapshot;

    protected override void OnParametersSet()
    {
        if (DailyData != null && DailyData.Any())
        {
            _dates = DailyData.Select(d => d.Date).OrderBy(d => d).ToList();
            _minIndex = 0;
            _maxIndex = _dates.Count - 1;
            _scrubberIndex = _maxIndex; // Default to latest
            UpdateSnapshot();
        }
    }

    private async Task OnScrubberChanged(int index)
    {
        _scrubberIndex = index;
        UpdateSnapshot();
        if (_selectedDate.HasValue)
        {
            await OnDateSelected.InvokeAsync(_selectedDate);
        }
    }

    private void UpdateSnapshot()
    {
        if (DailyData == null || !_dates.Any() || _scrubberIndex < 0 || _scrubberIndex >= _dates.Count)
        {
            _snapshot = null;
            _selectedDate = null;
            return;
        }

        _selectedDate = _dates[_scrubberIndex];
        _snapshot = DailyData.FirstOrDefault(d => d.Date == _selectedDate.Value);
    }

    private void ResetScrubber()
    {
        _scrubberIndex = _maxIndex;
        UpdateSnapshot();
    }

    private static string GetAiColor(double aiPercentage) => aiPercentage switch
    {
        >= 50 => "#ef4444",
        >= 25 => "#f97316",
        >= 10 => "#eab308",
        _ => "#22c55e"
    };
}
