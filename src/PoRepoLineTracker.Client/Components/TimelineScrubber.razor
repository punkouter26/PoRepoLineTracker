@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor

@* InstantReplay: Timeline scrubber that lets users "scrub through time" to see repo state at any date *@

<RadzenCard class="ts-card">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="ts-toolbar">
        <RadzenStack Gap="0.15rem">
            <RadzenText TextStyle="TextStyle.H6" class="ts-title">⏪ Timeline Scrubber</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="ts-description">
                Drag to see repository state at any point in time
            </RadzenText>
        </RadzenStack>
        @if (_selectedDate.HasValue)
        {
            <RadzenButton Text="Reset" Icon="replay" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small" Click="@ResetScrubber" />
        }
    </RadzenStack>

    @if (DailyData == null || !DailyData.Any())
    {
        <RadzenText TextStyle="TextStyle.Body2" class="ts-empty">No history data available for timeline scrubbing.</RadzenText>
    }
    else
    {
        @* Timeline Slider *@
        <div class="ts-slider-row">
            <RadzenSlider TValue="int" 
                          Min="@_minIndex" 
                          Max="@_maxIndex" 
                          Step="1"
                          @bind-Value="_scrubberIndex"
                          Change="@OnScrubberChanged"
                          class="ts-slider" />
        </div>

        @* Date markers *@
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="ts-bounds">
            <RadzenText TextStyle="TextStyle.Caption" class="ts-bound-label">
                @(_dates.Any() ? _dates.First().ToString("MMM dd, yyyy") : "")
            </RadzenText>
            @if (_selectedDate.HasValue)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                             Text="@(_selectedDate.Value.ToString("MMM dd, yyyy"))" 
                             class="ts-date-badge" />
            }
            <RadzenText TextStyle="TextStyle.Caption" class="ts-bound-label">
                @(_dates.Any() ? _dates.Last().ToString("MMM dd, yyyy") : "")
            </RadzenText>
        </RadzenStack>

        @* Snapshot metrics at selected date *@
        @if (_snapshot != null)
        {
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2 ts-metric">
                        <RadzenText TextStyle="TextStyle.Caption" class="ts-metric__label">Total Lines</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="ts-metric__value ts-metric__value--primary">@_snapshot.TotalLines.ToString("N0")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2 ts-metric">
                        <RadzenText TextStyle="TextStyle.Caption" class="ts-metric__label">Commits</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="ts-metric__value">@_snapshot.CommitCount</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2 ts-metric">
                        <RadzenText TextStyle="TextStyle.Caption" class="ts-metric__label">Lines Added</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="ts-metric__value ts-metric__value--added">+@_snapshot.TotalLinesAdded.ToString("N0")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-p-2 ts-metric">
                        <RadzenText TextStyle="TextStyle.Caption" class="ts-metric__label">AI %</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="@($"ts-metric__value {GetAiSeverityClass(_snapshot.AverageAiPercentage)}")">@_snapshot.AverageAiPercentage.ToString("F1")%</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            @* CommitTagger badges for this day *@
            @if (_snapshot.Tags.Any())
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" class="ts-tags" Wrap="FlexWrap.Wrap">
                    @foreach (var tag in _snapshot.Tags.Distinct())
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@tag" class="ts-tag" />
                    }
                </RadzenStack>
            }
        }
    }
</RadzenCard>

@code {
    /// <summary>
    /// The daily line count data to scrub through.
    /// </summary>
    [Parameter, EditorRequired] public List<DailyLineCountDto>? DailyData { get; set; }

    /// <summary>
    /// Event fired when the user scrubs to a new date.
    /// </summary>
    [Parameter] public EventCallback<DateTime?> OnDateSelected { get; set; }

    private int _scrubberIndex;
    private int _minIndex;
    private int _maxIndex;
    private List<DateTime> _dates = new();
    private DateTime? _selectedDate;
    private DailyLineCountDto? _snapshot;

    protected override void OnParametersSet()
    {
        if (DailyData != null && DailyData.Any())
        {
            _dates = DailyData.Select(d => d.Date).OrderBy(d => d).ToList();
            _minIndex = 0;
            _maxIndex = _dates.Count - 1;
            _scrubberIndex = _maxIndex; // Default to latest
            UpdateSnapshot();
        }
    }

    private async Task OnScrubberChanged(int index)
    {
        _scrubberIndex = index;
        UpdateSnapshot();
        if (_selectedDate.HasValue)
        {
            await OnDateSelected.InvokeAsync(_selectedDate);
        }
    }

    private void UpdateSnapshot()
    {
        if (DailyData == null || !_dates.Any() || _scrubberIndex < 0 || _scrubberIndex >= _dates.Count)
        {
            _snapshot = null;
            _selectedDate = null;
            return;
        }

        _selectedDate = _dates[_scrubberIndex];
        _snapshot = DailyData.FirstOrDefault(d => d.Date == _selectedDate.Value);
    }

    private void ResetScrubber()
    {
        _scrubberIndex = _maxIndex;
        UpdateSnapshot();
    }

    /// <summary>
    /// Rule 4.3 — the AI figure used to be coloured through an interpolated inline style. The
    /// thresholds are discrete, so they map to modifier classes defined in the scoped stylesheet.
    /// </summary>
    private static string GetAiSeverityClass(double aiPercentage) => aiPercentage switch
    {
        >= 50 => "ts-metric__value--ai-high",
        >= 25 => "ts-metric__value--ai-elevated",
        >= 10 => "ts-metric__value--ai-moderate",
        _ => "ts-metric__value--ai-low"
    };
}
